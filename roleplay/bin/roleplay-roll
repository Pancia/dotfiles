#!/usr/bin/env bash
#
# roleplay-roll — pick a character for the Claude Code roleplay bookends.
#
# Runs as a UserPromptSubmit hook on EVERY prompt in EVERY project, and prints a
# hook JSON envelope naming one character from ../roster.tsv.
#
# Two-stage: a UNIVERSE is chosen by weight, then a character within it, also by
# weight. Everything weighs 1 unless an @universe or @character line in the roster
# says otherwise, and weight 0 means it never rolls. See the header comment in the
# roster for why, and `--check` for the odds that result.
#
# THIS SCRIPT FAILS OPEN, DELIBERATELY. Missing roster, unreadable file, broken
# awk, empty result — every failure path prints nothing and exits 0. A hook that
# errors or emits garbage degrades every prompt the user ever sends, so the only
# acceptable failure is a silently missing bookend. Never add `set -e` here, and
# never let a diagnostic reach stdout: stdout is parsed as JSON by Claude Code.
#
# Usage:
#   roleplay-roll            # hook JSON envelope (the default; what the hook calls)
#   roleplay-roll --plain    # just the character line, for eyeballing and tests
#   roleplay-roll --list     # the whole roster grouped by universe
#   roleplay-roll --check    # validate the roster: counts, odds, duplicate emoji/names
#
# Signature lines: a character may declare its one famous quote in an optional
# 5th field. Each roll then decides whether that line is unlocked or spent, at
# ROLEPLAY_CATCHPHRASE odds (default 1/3). The point is that the quote stays
# available but stops being the default -- an unconditional ban was the previous
# design and it was too blunt.
#
# Env:
#   ROLEPLAY_ROSTER       override the roster path (used by the tests)
#   ROLEPLAY_SEED         force the RNG seed, making a roll reproducible (tests)
#   ROLEPLAY_CATCHPHRASE  "N/M" odds that a signature line is unlocked.
#                         Default 1/3. "0/1" never, "1/1" always. Unparseable
#                         values fall back to the default rather than erroring.

set -uo pipefail

case ${1:-} in
    '')                 mode=hook  ;;
    --plain | plain)    mode=plain ;;
    --list  | list)     mode=list  ;;
    --check | check)    mode=check ;;
    *)                  mode=hook  ;;
esac

# Resolve the roster relative to this script, not to $HOME, so a clone or
# worktree elsewhere uses its own copy — same reasoning as run_tests.py deriving
# DOTFILES from __file__.
#
# The symlink walk is load-bearing, not defensive tidiness: the copy of this
# script that actually runs is reached through one. `bin/roleplay-roll` in the
# dotfiles root is a symlink into this directory (that is what keeps PATH and the
# hook registration unchanged while the subsystem lives in roleplay/), and anyone
# installing this elsewhere will link it onto their PATH the same way. Without
# the walk, `dirname $BASH_SOURCE` yields the *symlink's* directory — bash does
# not resolve it — so the roster lookup lands next to the link and misses. That
# failure is silent by design, which is exactly why it must not be possible.
#
# `pwd -P` alone is not a substitute: it resolves symlinked *directories*, and
# the link here is on the file.
self_src=${BASH_SOURCE[0]}
while [ -L "$self_src" ]; do
    link_dir=$(cd -- "$(dirname -- "$self_src")" >/dev/null 2>&1 && pwd -P) || exit 0
    self_src=$(readlink -- "$self_src") || exit 0
    case $self_src in
        /*) ;;                          # absolute target, use as-is
        *)  self_src=$link_dir/$self_src ;;   # relative target, resolve against the link
    esac
done
self_dir=$(cd -- "$(dirname -- "$self_src")" >/dev/null 2>&1 && pwd -P) || exit 0
roster=${ROLEPLAY_ROSTER:-$self_dir/../roster.tsv}

# Redundant with the `|| exit 0` on the awk capture below, which already catches
# a missing or unreadable file. Kept as the explicit statement of intent; a
# mutation test confirms the fallback holds on its own if this line goes.
[ -r "$roster" ] || exit 0

# bash seeds $RANDOM per process, so consecutive invocations differ. Do not let
# awk call srand() with no argument instead: that seeds from time-of-day at
# one-second resolution, so two prompts sent in the same second would get the
# same character.
seed=${ROLEPLAY_SEED:-$(( (RANDOM << 15) ^ RANDOM ))}

# Signature-line odds as N/M. Every rejection path keeps the 1/3 default rather
# than erroring, because this script fails open.
sig_num=1
sig_den=3
raw=${ROLEPLAY_CATCHPHRASE:-}
if [ -n "$raw" ]; then
    slashes=${raw//[!\/]/}
    n=${raw%%/*}
    d=${raw##*/}
    case "$slashes:$n:$d" in
        /:*[!0-9]*:* | /:*:*[!0-9]* | /::* | /:*:) ;;   # non-numeric or empty
        /:*:*) [ "$d" -gt 0 ] 2>/dev/null && { sig_num=$n; sig_den=$d; } ;;
    esac
fi

awk_prog='
function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
# Index into w[1..n], chosen in proportion to the weights. Takes exactly one
# rand(), and with all weights equal it lands where int(rand() * n) + 1 would, so
# an unweighted roster rolls what it always did for a given seed. A zero weight
# adds nothing to the running total, so r < c can never select it. The last
# positive index is the fallback for floating-point rounding at the top end.
function wpick(w, n,    i, sum, r, c, last) {
    sum = 0
    for (i = 1; i <= n; i++) sum += w[i]
    r = rand() * sum
    c = 0
    for (i = 1; i <= n; i++) {
        if (w[i] <= 0) continue
        last = i
        c += w[i]
        if (r < c) return i
    }
    return last
}
BEGIN { FS = "|"; srand(seed); nu = 0 }
/^[ \t]*#/ { next }
# Weight lines. These can sit anywhere in the file, because they are applied in
# END. A malformed one leaves the weight at 1 and is reported by --check.
/^[ \t]*@/ {
    dk = trim($1); dn = trim($2); dv = trim($3)
    if (NF != 3 || dn == "" || dv !~ /^[0-9]*\.?[0-9]+$/ ||
        (dk != "@universe" && dk != "@character"))
        badw[++nbadw] = trim($0)
    else if (dk == "@universe")
        uw[dn] = dv + 0
    else
        cw[dn] = dv + 0
    next
}
NF < 4 { next }
{
    u = trim($1); n = trim($2); e = trim($3); t = trim($4)
    s = (NF >= 5) ? trim($5) : ""
    if (u == "" || n == "") next
    if (!(u in seen)) { seen[u] = 1; uname[++nu] = u }
    k = ++count[u]
    name[u, k] = n; emo[u, k] = e; trait[u, k] = t; sig[u, k] = s
    if (s != "") nsig++
    if (n in namedup) { dupname[n] = 1 }
    namedup[n] = 1
    if (e != "" && (e in emodup)) { dupemo[e] = 1 }
    emodup[e] = 1
    total++
}
END {
    if (nu == 0) exit 1

    # Resolve weights. A universe whose members all weigh 0 has nobody to offer,
    # so it must weigh 0 at stage 1 too, or a roll could land on it and find no one.
    wsum = 0
    for (i = 1; i <= nu; i++) {
        u = uname[i]
        usum[u] = 0
        for (k = 1; k <= count[u]; k++) {
            cwt[u, k] = (name[u, k] in cw) ? cw[name[u, k]] : 1
            usum[u] += cwt[u, k]
        }
        ueff[i] = (usum[u] > 0) ? ((u in uw) ? uw[u] : 1) : 0
        wsum += ueff[i]
    }

    if (mode == "list" || mode == "check") {
        off = 0
        for (i = 1; i <= nu; i++) {
            u = uname[i]
            uodds = (wsum > 0) ? ueff[i] / wsum : 0
            if (mode == "check")
                printf "%s  (%d members, %.2f%% of rolls, weight %g)\n", u, count[u], 100 * uodds, ueff[i]
            else
                printf "%s  (%d)%s\n", u, count[u], (ueff[i] > 0 ? "" : "   [off]")
            for (k = 1; k <= count[u]; k++) {
                codds = (usum[u] > 0) ? uodds * cwt[u, k] / usum[u] : 0
                if (codds == 0) off++
                wnote = (cwt[u, k] == 0) ? "   [off]" : \
                        ((cwt[u, k] != 1) ? sprintf("   [weight %g]", cwt[u, k]) : "")
                snote = (sig[u, k] != "") ? "   [sig: " sig[u, k] "]" : ""
                if (mode == "check")
                    printf "    %5.2f%%  %s %s%s%s\n", 100 * codds, emo[u, k], name[u, k], wnote, snote
                else
                    printf "    %s %s%s%s\n", emo[u, k], name[u, k], wnote, snote
            }
        }
        printf "\n%d characters across %d universes\n", total, nu
        if (off > 0) printf "%d of them are off (weight 0) and never roll\n", off
        if (mode == "check") {
            if (sig_den > 0)
                printf "signature lines: %d characters have one, unlocked %d/%d of rolls (%.0f%%)\n",
                       nsig, sig_num, sig_den, 100.0 * sig_num / sig_den
            else
                printf "signature lines: %d characters have one, odds misconfigured\n", nsig
            bad = 0
            for (d in dupname) { printf "DUPLICATE NAME:  %s\n", d; bad = 1 }
            for (d in dupemo)  { printf "DUPLICATE EMOJI: %s\n", d; bad = 1 }
            if (!bad) printf "no duplicate names or emoji\n"
            # A misspelled name in a weight line would otherwise do nothing, silently.
            for (x in uw) if (!(x in seen))    printf "UNKNOWN UNIVERSE IN WEIGHT: %s\n", x
            for (x in cw) if (!(x in namedup)) printf "UNKNOWN CHARACTER IN WEIGHT: %s\n", x
            for (i = 1; i <= nbadw; i++)       printf "BAD WEIGHT LINE: %s\n", badw[i]
            if (wsum <= 0) printf "NOTHING CAN ROLL: every weight is 0\n"
        }
        exit 0
    }

    # Every weight 0 means there is nothing to pick. Fail open, like any other
    # empty result.
    if (wsum <= 0) exit 1

    # Stage 1: universe by weight. Stage 2: character within it, by weight.
    u = uname[wpick(ueff, nu)]
    for (k = 1; k <= count[u]; k++) mw[k] = cwt[u, k]
    k = wpick(mw, count[u])
    # The guillemets and em-dash are literal UTF-8 in the program text. awk moves
    # them through as opaque bytes, which is portable; \xNN escapes are not (BSD
    # awk on macOS does not read them the way gawk does).
    printf "«%s» %s %s — %s", name[u, k], emo[u, k], u, trait[u, k]

    # Stage 3: is the signature line unlocked this roll? Placed after the two
    # picks above so adding it did not shift their rand() stream and invalidate
    # every seeded test. NOTE: awk_prog is single-quoted in bash, so no
    # apostrophes may appear anywhere in this program -- one here cost a debug
    # cycle already.
    s = sig[u, k]
    if (s != "") {
        if (sig_den > 0 && rand() * sig_den < sig_num)
            printf " || SIGNATURE LINE UNLOCKED (%d/%d roll) — you may use: %s",
                   sig_num, sig_den, s
        else
            printf " || signature line spent this roll — do not use %s; reach for a less-worn part of the character instead", s
    }
}
'

line=$(awk -v seed="$seed" -v mode="$mode" \
           -v sig_num="$sig_num" -v sig_den="$sig_den" \
           "$awk_prog" "$roster" 2>/dev/null) || exit 0
[ -n "$line" ] || exit 0

case $mode in
    list | check | plain)
        printf '%s\n' "$line"
        ;;
    *)
        # Escape for JSON. The roster is allowed to contain quotes (Kusanagi's
        # entry has some), so this is not optional.
        esc=$(printf '%s' "$line" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g') || exit 0
        printf '{"hookSpecificOutput":{"hookEventName":"UserPromptSubmit","additionalContext":"[🎭 Character Roll: %s]"}}' "$esc"
        ;;
esac
