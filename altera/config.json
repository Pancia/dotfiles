{
  "repo_path": "",
  "default_branch": "master",
  "test_command": "",
  "constraints": {
    "max_workers": 1,
    "max_queue_depth": 10
  },
  "heartbeat_timeouts": {
    "warn_timeout": "5m",
    "critical_timeout": "10m",
    "dead_timeout": "20m"
  },
  "default_workflow": "dotfiles-dev",
  "prompts": {},
  "sandbox": {
    "worker": {
      "preset": "",
      "allowed_domains": [
        "api.anthropic.com",
        "*.anthropic.com",
        "proxy.golang.org",
        "sum.golang.org",
        "storage.googleapis.com"
      ]
    },
    "resolver": {
      "preset": "",
      "allowed_domains": [
        "api.anthropic.com",
        "*.anthropic.com",
        "proxy.golang.org",
        "sum.golang.org",
        "storage.googleapis.com"
      ]
    },
    "liaison": {
      "preset": "",
      "allowed_domains": [
        "api.anthropic.com",
        "*.anthropic.com",
        "proxy.golang.org",
        "sum.golang.org",
        "storage.googleapis.com",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com"
      ]
    },
    "standalone": {
      "preset": "",
      "allowed_domains": [
        "api.anthropic.com",
        "*.anthropic.com",
        "proxy.golang.org",
        "sum.golang.org",
        "storage.googleapis.com",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com"
      ]
    }
  },
  "source_guard": {
    "protected_prefixes": [
      "internal/",
      "cmd/"
    ]
  },
  "tui_hotkeys": {},
  "checkout_landing": "auto",
  "landing": {
    "mode": "review",
    "accept": "local"
  }
}
