#!/usr/bin/env fish

# YouTube download utility
# Interactive downloads bypass .ytdl files and download directly

# ============================================================================
# CONFIGURATION
# ============================================================================

set -g YTDL_VALID_TYPES music audio video text notes
set -g YTDL_VALID_QUALITIES regular best
set -g YTDL_OUTPUT_DIR ~/Cloud/ytdl
set -g YTDL_AUDIO_CODE "bestaudio"
set -g YTDL_VIDEO_CODE "bestvideo[ext=mp4][height<=480][vcodec^=avc]+bestaudio"
set -g YTDL_VIDEO_CODE_BEST "bestvideo[ext=mp4][vcodec^=avc]+bestaudio[ext=m4a]/bestvideo+bestaudio/best"
set -g YTDL_PLAYLIST_FMT "%(playlist_title)s"

# Filename field separators. Every character here is deliberately inert: safe
# unquoted in sh and inside double quotes, not markdown or Telegram emphasis,
# not a glob metacharacter, legal on macOS, and not yt-dlp template syntax.
#
# They replaced __$__ / __#__ / __&__ on 2026-08-02. Each of those was a hazard:
# the `$` expanded away inside a double-quoted path (silently truncating it),
# `&` backgrounded the command unquoted, `#` autolinked as a Telegram hashtag,
# and every `__pair__` read as markdown emphasis — so a path pasted into a chat
# arrived with characters deleted. Guillemets appear nowhere in 52,747 real
# filenames, so they also cannot collide with a video title.
#
# The labels matter as much as the brackets: MediaBoard files can carry tags
# with no channel, which is structurally identical to a channel with no tags.
# Unlabelled, those two are indistinguishable.
# TAGS is never written by ytdl — MediaBoard tags are applied by hand, and no
# tool in dotfiles or ~/projects writes them. It is defined here anyway so the
# field set has one canonical home for anything that parses these names.
set -g YTDL_SEP_TAGS "‹‹TAGS››"
set -g YTDL_SEP_BY "‹‹BY››"
set -g YTDL_SEP_TITLE "‹‹TITLE››"
set -g YTDL_SEP_ID "‹‹ID››"

# Resolved through any symlink so a `~/.local/bin/ytdl` shim still finds its
# sibling helper in the real dotfiles/bin.
set -g YTDL_COPY_PATH_BIN (dirname (path resolve (status filename)))/ytdl-copy-path

# Set by the text/notes download path to the single file worth pointing at.
# Empty for media downloads, which can produce several files.
set -g YTDL_RESULT_FILE ""

# ============================================================================
# HELPER FUNCTIONS
# ============================================================================

# Single-quote a string for /bin/sh, which is what terminal-notifier runs an
# -execute command through. ytdl filenames routinely carry apostrophes
# ("You're", "Can't"), $ and & — unquoted, those break the command or, in the
# case of $(…), run something.
function _ytdl_shq
    printf "'%s'" (string replace --all -- "'" "'\\''" $argv[1])
end

function _ytdl_select_type
    set -l selected (printf '%s\n' $YTDL_VALID_TYPES | fzf --prompt="ytdl type> " --height=10)
    if test -z "$selected"
        return 1
    end
    echo $selected
end

function _ytdl_usage
    echo 'usage: ytdl [options] [TYPE] [QUALITY] [ID | URL | clipboard]

Download a YouTube video, playlist or transcript into ~/Cloud/ytdl/<TYPE>/.
The words can come in any order: anything that is not a type, a quality or
`clipboard` is taken to be the video. Whatever is missing gets asked for —
TYPE through fzf, the video through a prompt.

TYPE
  music      best audio, converted to .m4a
  audio      best audio, converted to .m4a
  video      mp4 (see QUALITY)
  text       audio, then transcribed to .txt
  notes      like text, filed under notes/

QUALITY  (video only; ignored for the other types)
  regular    H.264 capped at 480p, merged to mp4      (default)
  best       highest-res H.264 + m4a; if there is none, the best of any codec

SOURCE
  ID         dQw4w9WgXcQ
  URL        watch?v=…, youtu.be/…, /shorts/…, /live/…, playlist?list=…
  clipboard  read the URL from the clipboard (alias: clip)

OPTIONS
  --best           same as the word `best`
  --quality Q      regular | best   (also --quality=Q)
  --quiet          log progress only every 20% — for detached/background runs
  --notify         Notification Center banners when it starts and finishes
  -h, --help       show this help
  --               treat everything after as the video (an ID starting with -)

EXAMPLES
  ytdl video best dQw4w9WgXcQ
  ytdl best video https://youtu.be/dQw4w9WgXcQ
  ytdl audio clipboard
  ytdl text                    # prompts for the URL
  ytdl                         # prompts for both'
end

function _ytdl_die
    echo "ytdl: $argv" >&2
    echo "Run 'ytdl --help' for usage." >&2
    exit 1
end

# A watch URL's v=, or the path segment after youtu.be/, /shorts/, /live/ or
# /embed/. Anything else — a bare ID, a playlist URL, another site — passes
# through untouched for yt-dlp to resolve.
function _ytdl_extract_video_id
    set -l input $argv[1]
    set -l m (string match -r '[?&]v=([A-Za-z0-9_-]+)' -- $input)
    or set m (string match -r '(?:youtu\.be/|/shorts/|/live/|/embed/)([A-Za-z0-9_-]+)' -- $input)
    if test (count $m) -ge 2
        echo $m[2]
    else
        echo $input
    end
end

function _ytdl_run
    set -l ytid $argv[1]
    set -l extra_args $argv[2..-1]

    echo "yt-dlp $extra_args -- \"$ytid\""

    if test $YTDL_QUIET -eq 1
        set -l last_milestone 0
        set -l all_output
        yt-dlp --newline $extra_args -- $ytid 2>&1 | while read -l line
            set -a all_output $line
            if string match -qr '^\[download\]\s+\d' -- $line
                set -l pct_str (string match -r '(\d+)\.\d+%' -- $line)[2]
                if test -n "$pct_str"
                    set -l next_milestone (math "$last_milestone + 20")
                    if test $pct_str -ge $next_milestone
                        echo $line
                        set last_milestone $next_milestone
                    end
                end
            else
                echo $line
            end
        end
        set -l exit_code $pipestatus[1]

        # Retry with cookies if age-restricted
        if test $exit_code -ne 0
            if string match -qri 'Sign in to confirm your age|age-restricted|login required' -- "$all_output"
                echo "[Age-restricted detected, retrying with cookies...]"
                set last_milestone 0
                yt-dlp --newline $extra_args --cookies-from-browser brave -- $ytid 2>&1 | while read -l line
                    if string match -qr '^\[download\]\s+\d' -- $line
                        set -l pct_str (string match -r '(\d+)\.\d+%' -- $line)[2]
                        if test -n "$pct_str"
                            set -l next_milestone (math "$last_milestone + 20")
                            if test $pct_str -ge $next_milestone
                                echo $line
                                set last_milestone $next_milestone
                            end
                        end
                    else
                        echo $line
                    end
                end
                set exit_code $pipestatus[1]
            end
        end
        return $exit_code
    end

    # Stream live and keep a copy for the age-restriction check. Capturing into
    # a variable instead held everything back until the end, then printed it
    # as one line — the \r-separated progress updates joined by spaces.
    set -l log (mktemp -t ytdl)
    yt-dlp $extra_args -- $ytid 2>&1 | tee $log
    set -l exit_code $pipestatus[1]

    # Retry with cookies if age-restricted
    if test $exit_code -ne 0; and grep -qiE 'Sign in to confirm your age|age-restricted|login required' $log
        echo ""
        echo "[Age-restricted detected, retrying with cookies...]"
        yt-dlp $extra_args --cookies-from-browser brave -- $ytid
        set exit_code $status
    end
    command rm -f $log

    return $exit_code
end

function _ytdl_convert_to_m4a
    set -l out_dir $argv[1]
    set -l ytid $argv[2]
    for src_file in $out_dir/*$YTDL_SEP_ID$ytid.{mp4,webm}
        if test -f "$src_file"
            set -l m4a_file (string replace -r '\.[^.]+$' '.m4a' -- $src_file)
            if not test -f "$m4a_file"
                echo "[Converting] $src_file -> $m4a_file"
                if test $YTDL_QUIET -eq 1
                    set -l duration_secs (ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 $src_file 2>/dev/null)
                    if test -n "$duration_secs"
                        set -l last_milestone 0
                        ffmpeg -loglevel warning -stats -i $src_file $m4a_file 2>&1 | stdbuf -oL tr '\r' '\n' | while read -l line
                            set -l time_str (string match -r 'time=(\d+):(\d+):(\d+)' -- $line)
                            if test (count $time_str) -ge 4
                                set -l cur_secs (math "$time_str[2] * 3600 + $time_str[3] * 60 + $time_str[4]")
                                set -l pct (math "round($cur_secs / $duration_secs * 100)")
                                set -l next_milestone (math "$last_milestone + 20")
                                if test $pct -ge $next_milestone
                                    echo "[ffmpeg] $pct% (time=$time_str[2]:$time_str[3]:$time_str[4])"
                                    set last_milestone $next_milestone
                                end
                            end
                        end
                    else
                        ffmpeg -loglevel warning -i $src_file $m4a_file
                    end
                else
                    ffmpeg -i $src_file $m4a_file
                end
                and trash $src_file
            end
        end
    end
end

# ============================================================================
# DOWNLOAD FUNCTIONS
# ============================================================================

function _ytdl_download_media
    set -l ytid $argv[1]
    set -l download_type $argv[2]
    set -l video_type $argv[3] # "single" or "playlist"

    set -l playlist_segment ""
    if test "$video_type" = "playlist"
        set playlist_segment "/$YTDL_PLAYLIST_FMT"
    end

    set -l output_path "$YTDL_OUTPUT_DIR/$download_type$playlist_segment/$YTDL_SEP_BY%(channel,uploader)s$YTDL_SEP_TITLE%(title)s$YTDL_SEP_ID%(id)s.%(ext)s"

    set -l format_code $YTDL_AUDIO_CODE
    set -l merge_args
    if test "$download_type" = "video"
        if test "$YTDL_QUALITY" = "best"
            set format_code $YTDL_VIDEO_CODE_BEST
        else
            set format_code $YTDL_VIDEO_CODE
        end
        set merge_args --merge-output-format mp4
    end

    if _ytdl_run $ytid -o $output_path -f $format_code $merge_args
        # Only convert mp4 to m4a for audio formats, not video
        if test "$download_type" != "video"
            _ytdl_convert_to_m4a "$YTDL_OUTPUT_DIR/$download_type" $ytid
        end
        return 0
    else
        return 1
    end
end

function _ytdl_download_text
    set -l ytid $argv[1]
    set -l download_type $argv[2] # "text" or "notes"

    set -l out_dir "$YTDL_OUTPUT_DIR/$download_type"
    set -l out_file "$out_dir/$YTDL_SEP_BY%(channel,uploader)s$YTDL_SEP_TITLE%(title)s$YTDL_SEP_ID%(id)s.%(ext)s"

    # Download audio (prefer m4a to avoid opus conversion issues during transcription)
    _ytdl_run $ytid -o $out_file -f 'bestaudio[ext=m4a]/bestaudio'
    or return 1

    # Find the audio file we just downloaded (matches this specific ytid)
    set -l audio_file $out_dir/*$YTDL_SEP_ID$ytid.*
    if test (count $audio_file) -gt 0 -a -f "$audio_file[1]"
        if not string match -qr '\.(txt|srt)$' -- $audio_file[1]
            set -l txt_file (string replace -r '\.[^.]+$' '.txt' -- $audio_file[1])
            echo "[Transcribing] $audio_file[1]"
            transcribe $audio_file[1] | tee $txt_file
            # Capture before the `if`: fish resets $pipestatus on the next job
            # and `test` is one. (Measured on 4.1.2, `set` alone happens not to
            # clobber it, but that is not worth relying on.)
            set -l rc $pipestatus[1]
            # Defensive rather than observable: _ytdl_notify only reads
            # YTDL_RESULT_FILE on the success branch, so a failed run would
            # ignore it anyway. Keeps the variable's meaning honest — "the file
            # we actually produced" — for any future reader.
            if test $rc -eq 0
                set -g YTDL_RESULT_FILE $txt_file
            end
            return $rc
        else
            # Already a transcript (a notes .en.srt, or a re-run): that file is
            # the result, nothing to transcribe.
            set -g YTDL_RESULT_FILE $audio_file[1]
        end
    end
    return 0
end

# Post a Notification Center alert via terminal-notifier (reliable from
# background/detached processes, unlike `osascript display notification`).
# Clicking a success notification opens the output folder.
# Start and finish alerts share a -group keyed on the video ID so the
# completion banner replaces the "started" one in place instead of stacking.
#
# _ytdl_notify_start is posted twice: once with no title, the instant the ID is
# known, and again after the (network-bound) title probe resolves. The shared
# -group means the second post rewrites the first banner in place.
function _ytdl_notify_start
    set -l dl_type $argv[1]
    set -l ytid $argv[2]
    set -l title $argv[3]

    if not type -q terminal-notifier
        return 0
    end

    set -l msg $title
    set -l body "downloading…"
    if test -z "$msg"
        set msg $ytid
        set body "starting…"
    end

    terminal-notifier -title "ytdl ⏳ $dl_type started" -subtitle "$msg" \
        -message "$body" -group "ytdl-$ytid" >/dev/null 2>&1
end

function _ytdl_notify
    set -l dl_status $argv[1]
    set -l dl_type $argv[2]
    set -l ytid $argv[3]
    set -l title $argv[4]

    if not type -q terminal-notifier
        return 0
    end

    set -l msg $title
    test -z "$msg"; and set msg $ytid
    set -l out_dir "$YTDL_OUTPUT_DIR/$dl_type"

    if test $dl_status -eq 0
        # text/notes end in exactly one file worth pointing at, so clicking
        # copies its absolute path (two pasteboard flavors — see
        # bin/ytdl-copy-path). Media downloads can produce several files, so a
        # single path would be ambiguous and they keep opening the folder.
        set -l body "saved to $out_dir"
        set -l action "open "(_ytdl_shq $out_dir)
        if test -n "$YTDL_RESULT_FILE"; and test -f "$YTDL_RESULT_FILE"
            set body "click to copy path"
            set action (_ytdl_shq $YTDL_COPY_PATH_BIN)" "(_ytdl_shq $YTDL_RESULT_FILE)
        end

        terminal-notifier -title "ytdl ✅ $dl_type" -subtitle "$msg" \
            -message "$body" -sound default -group "ytdl-$ytid" \
            -execute "$action" >/dev/null 2>&1
    else
        terminal-notifier -title "ytdl ❌ $dl_type FAILED" -subtitle "$msg" \
            -message "$ytid" -sound Basso -group "ytdl-$ytid" >/dev/null 2>&1
    end
end

# ============================================================================
# MAIN
# ============================================================================

set -l ytdl_type ""
set -l input
set -l from_clipboard 0
set -g YTDL_QUIET 0
set -g YTDL_QUALITY ""
set -g YTDL_NOTIFY 0

# Positional words are classified by what they are, not where they sit, so
# `video best ID`, `best video ID` and `--quality best video ID` (the form
# sekhmet's native host sends) all mean the same thing.
set -l i 0
while test $i -lt (count $argv)
    set i (math $i + 1)
    set -l arg $argv[$i]
    switch $arg
        case -h --help
            _ytdl_usage
            exit 0
        case --quiet
            set YTDL_QUIET 1
        case --notify
            set YTDL_NOTIFY 1
        case --best
            set YTDL_QUALITY best
        case --quality
            set i (math $i + 1)
            test $i -le (count $argv)
            or _ytdl_die "--quality requires a value ($YTDL_VALID_QUALITIES)"
            set YTDL_QUALITY $argv[$i]
        case '--quality=*'
            set YTDL_QUALITY (string replace -- --quality= '' $arg)
        case --
            set -a input $argv[(math $i + 1)..-1]
            break
        case clipboard clip
            set from_clipboard 1
        case '*'
            if contains -- $arg $YTDL_VALID_TYPES
                test -z "$ytdl_type"; or test "$ytdl_type" = $arg
                or _ytdl_die "two types given: '$ytdl_type' and '$arg'"
                set ytdl_type $arg
            else if contains -- $arg $YTDL_VALID_QUALITIES
                set YTDL_QUALITY $arg
            else if string match -qr '^-' -- $arg; and not string match -qr '^-[A-Za-z0-9_-]{10}$' -- $arg
                # An 11-char YouTube ID can legitimately start with '-'.
                _ytdl_die "unknown option '$arg'"
            else if string match -qr '^[a-z]+$' -- $arg
                # IDs are random base64, so an all-lowercase word is almost
                # certainly a misspelt keyword. `--` forces it through.
                _ytdl_die "Invalid type or quality '$arg'" \
                    "(types: $YTDL_VALID_TYPES; qualities: $YTDL_VALID_QUALITIES)"
            else
                set -a input $arg
            end
    end
end

test -z "$YTDL_QUALITY"; and set YTDL_QUALITY regular
contains -- $YTDL_QUALITY $YTDL_VALID_QUALITIES
or _ytdl_die "Invalid quality '$YTDL_QUALITY' (valid: $YTDL_VALID_QUALITIES)"

test (count $input) -le 1
or _ytdl_die "more than one video given: $input"
if test $from_clipboard -eq 1
    test (count $input) -eq 0
    or _ytdl_die "got both 'clipboard' and a video ($input)"
    set input (pbpaste)
end

if test -z "$ytdl_type"
    set ytdl_type (_ytdl_select_type)
    or exit 1
end

if test "$YTDL_QUALITY" = best; and test "$ytdl_type" != video
    echo "ytdl: note: quality only applies to video; downloading $ytdl_type as usual" >&2
end

if test (count $input) -eq 0
    read -P "YouTube ID or URL: " input
    or exit 1
end
test -n "$input"
or _ytdl_die "no video given"

set -l video_id (_ytdl_extract_video_id $input)

# A playlist only when the URL names a list and no single video in it.
set -l video_type "single"
if string match -qr '[?&]list=' -- $input; and test "$video_id" = "$input"
    set video_type "playlist"
end

# Fire the start banner before the title probe — the probe is a network round
# trip (~2-3s), and waiting on it used to be the whole notification delay.
if test $YTDL_NOTIFY -eq 1
    _ytdl_notify_start $ytdl_type $video_id ""
end

set -l video_title (yt-dlp --get-title -- $video_id 2>/dev/null)

echo "=== ytdl ==="
echo "Type: $ytdl_type"
echo "ID: $video_id"
echo "Mode: $video_type"
if test -n "$video_title"
    echo "Title: $video_title"
end
echo "============"
echo

# Rewrite the banner in place now that the title is known.
if test $YTDL_NOTIFY -eq 1; and test -n "$video_title[1]"
    _ytdl_notify_start $ytdl_type $video_id "$video_title[1]"
end

# Download based on type
switch $ytdl_type
    case music audio video
        _ytdl_download_media $video_id $ytdl_type $video_type
    case text notes
        _ytdl_download_text $video_id $ytdl_type
end
set -l dl_status $status

if test $YTDL_NOTIFY -eq 1
    _ytdl_notify $dl_status $ytdl_type $video_id "$video_title[1]"
end

exit $dl_status
