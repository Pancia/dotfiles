#!/usr/bin/env bash
# Shell entry point for lib/python/cc_worktree.py — the opt-in marker for
# Claude Code's native per-session worktrees, so two sessions in one repo do not
# tread on each other.
#
#   cc-worktree on|off|status        opt this checkout in or out
#   cc-worktree should-isolate       exit 0 when opted in (the wrapper's gate)
#
# Creating, resuming and removing worktrees is Claude Code's job, not this
# tool's; all it decides is whether `cc` appends --worktree here.
#
# Exit: 0 ok · 1 refused or failed · 2 not opted in.
# (An exit code 5 was documented here for a while and never existed — it was
# copied from bin/ccjj, which does have one.)
#
# Docs: docs/cc-worktree.md. For ~/dotfiles, which cannot be isolated, the
# answer is ccjj / commit-mine instead — docs/cc-jj-sessions.md.
#
# Own file rather than `python3 ~/dotfiles/lib/python/cc_worktree.py` at each
# callsite, so the fish callers get a name and the path lives in one place.
exec python3 "$(dirname "$(dirname "$(readlink -f "$0")")")/lib/python/cc_worktree.py" "$@"
