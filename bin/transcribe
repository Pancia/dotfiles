#!/opt/homebrew/bin/fish
#
# Absolute interpreter path, not `/usr/bin/env fish`. A shebang's interpreter is
# resolved through PATH at exec time, so `env fish` fails with rc=127 under
# launchd's default PATH (/usr/bin:/bin:/usr/sbin:/sbin), which does not include
# /opt/homebrew/bin. Callers that pass an absolute path to *this script* gain
# nothing from doing so if the interpreter itself can't be found.
#
# This currently works only by accident — the wget_server chain happens to reach
# a fish that repairs PATH via config.fish — and would break for every journal
# upload the moment that config grew a `status is-interactive` guard.
# services/wget_server/script.sh already hardcodes this same path.

set model_path "$HOME/.local/share/whisper-cpp/models/ggml-large-v3-turbo.bin"
set vad_model_path "$HOME/.local/share/whisper-cpp/models/silero-v6.2.0.ggml"

# Parse arguments
set -l no_file false
set -l audio_file

for arg in $argv
    switch $arg
        case --no-file
            set no_file true
        case '--help' '-h'
            echo "Usage: transcribe [--no-file] <audio_file>"
            echo ""
            echo "Transcribe audio/video using whisper-cpp (large-v3-turbo)"
            echo ""
            echo "Options:"
            echo "  --no-file  Don't create transcript file, only print to stdout"
            exit 0
        case '*'
            set audio_file $arg
    end
end

if test -z "$audio_file"
    echo "Usage: transcribe [--no-file] <audio_file>" >&2
    exit 1
end

if not test -f "$audio_file"
    echo "Error: file not found: $audio_file" >&2
    exit 1
end

if not test -f "$model_path"
    echo "Error: model not found: $model_path" >&2
    echo "Download it with:" >&2
    echo "  curl -L -o $model_path https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo.bin" >&2
    exit 1
end

# Always convert to 16 kHz mono WAV.
#
# whisper-cli is built without ffmpeg (WHISPER_FFMPEG=OFF), so it decodes only
# what its bundled decoders handle: wav, mp3, flac, and ogg/**vorbis**. It
# cannot decode ogg/**opus** — and `.ogg` is a container, not a codec, so an
# extension test can't tell the two apart. Opus is what Telegram, WhatsApp and
# Android recorders all produce, so the old `contains $ext wav mp3 ogg flac`
# whitelist passed the single most common case straight through to whisper-cli,
# which failed with "failed to read audio data as wav".
#
# Converting unconditionally costs ~1.9s for 20 minutes of audio — noise beside
# transcription — and removes the whole class of bug rather than one instance of
# it. It also normalises sample rate and channel count, which the whitelist path
# passed through untouched (a 48 kHz stereo wav previously reached whisper-cli
# as-is).
#
# The scratch dir is global and torn down by a signal handler as well as on the
# normal paths. Every invocation now creates one (the conversion is
# unconditional, where the old whitelist skipped it for most inputs), and the
# converted WAV is 16 kHz mono s16le ≈ 32 KB/s — so a Ctrl-C during a 2-hour
# transcription used to strand ~230 MB with only macOS's /var/folders reaper
# behind it. SIGKILL remains uncatchable by definition.
set -g __transcribe_tmpdir (mktemp -d -t transcribe)
or begin
    echo "Error: could not create temp directory" >&2
    exit 1
end

function __transcribe_cleanup --on-signal INT --on-signal TERM --on-signal HUP
    test -n "$__transcribe_tmpdir"; and rm -rf "$__transcribe_tmpdir"
    exit 130
end

set -l input_file "$__transcribe_tmpdir/audio.wav"

echo "Converting to WAV..." >&2
ffmpeg -nostdin -err_detect ignore_err -i "$audio_file" -ar 16000 -ac 1 -c:a pcm_s16le "$input_file" -y -loglevel error
or begin
    echo "Error: ffmpeg conversion failed" >&2
    rm -rf "$__transcribe_tmpdir"
    exit 1
end

# Transcribe
set -l vad_args
if test -f "$vad_model_path"
    set vad_args --vad --vad-model "$vad_model_path"
end

set -l output (whisper-cli -m "$model_path" -f "$input_file" --no-prints -nt -mc 64 -et 2.0 -lpt -0.3 --suppress-nst $vad_args 2>&1)
set -l status_code $status

# Clean up the scratch directory (always ours — the conversion is unconditional)
rm -rf "$__transcribe_tmpdir"

if test $status_code -ne 0
    echo "Error: whisper-cli failed" >&2
    echo $output >&2
    exit 1
end

# Print to stdout
printf '%s\n' $output

# Write to file unless --no-file
if test "$no_file" = false
    set -l transcript_path (path resolve "$audio_file").transcript.txt
    printf '%s\n' $output > "$transcript_path"
    echo "Transcript saved to: $transcript_path" >&2
end
