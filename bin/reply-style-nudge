#!/usr/bin/env python3
# reply-style-nudge: UserPromptSubmit hook for interactive sessions.
# Every session gets a one-line reminder of the reply format. It does not check
# the last reply, because a reply that only answers a question may have no marks.
# The Altera liaison also gets the reply rules and a report of the last reply's size.
# Makes no model call. Fails open: on any error it prints nothing and exits 0.
import json, os, re, sys

FLAG_WORDS = 150  # the limit is 130 or 200 by kind, and the hook cannot tell the kind
FLAG_IDS = 3

NOTE = ("[Reply style] First line: the answer, in everyday words. Last: what you need "
        "from me. Use an ID or internal name only if I must type it, open it or find "
        "it. Limits: 60 words for a yes or no, 130 to catch up. Each question gets a "
        "lasting ID and label, such as Q3 (short name); repeat open ones at the end.")

FORMAT_NOTE = ("[Reply format] In recaps and catch-ups, group the facts under label lines, "
               "with each label once and one bullet per fact. The labels, in order, are "
               "🔴 `BROKEN`, 🔴 `FAILED`, 🟢 `NOW`, 🟢 `CHECKED`, 🟡 `WATCH`, 🔵 `UNCHECKED` "
               "and 🔵 `NOT DONE`. Use only these labels, never a topic word. Give a question "
               "a yes and no list only when what each answer does is not obvious.")

def score(text):
    text = "\n".join(l for l in text.split("\n") if not l.startswith("> 🎭"))
    text = re.sub(r"```.*?```", " ", text, flags=re.S)
    ids = re.findall(r"\b[mwr]-\d+\b|\b[A-PR-Z]\d{1,2}[a-d]?\b", text)
    plain = re.sub(r"^\s*(#+|[-*])\s+", "", text, flags=re.M).replace("**", "")
    return len(plain.split()), len(ids)

def read_transcript(path):
    """Return (entrypoint, last assistant text) from the end of the transcript."""
    with open(path, "rb") as f:
        f.seek(0, 2)
        f.seek(max(0, f.tell() - 2_000_000))
        lines = f.read().decode("utf-8", "ignore").split("\n")
    entry, reply = "", ""
    for line in reversed(lines):
        try:
            d = json.loads(line)
        except ValueError:
            continue
        entry = entry or d.get("entrypoint", "")
        if not reply and d.get("type") == "assistant" and not d.get("isSidechain"):
            content = d.get("message", {}).get("content")
            if isinstance(content, list):
                parts = [b["text"] for b in content if b.get("type") == "text"]
                if parts:
                    reply = parts[-1]
        if entry and reply:
            break
    return entry, reply

try:
    data = json.load(sys.stdin)
    try:
        entry, reply = read_transcript(data.get("transcript_path", ""))
    except OSError:  # the first prompt of a session can come before its transcript
        entry, reply = "", ""
    # The transcript's entrypoint comes first, because a nested session inherits
    # CLAUDE_CODE_ENTRYPOINT from its parent.
    if (entry or os.environ.get("CLAUDE_CODE_ENTRYPOINT")) != "cli":
        sys.exit(0)
    note = FORMAT_NOTE
    # ALT_AGENT_ID is inherited by child processes, so recons started by the
    # liaison have it too. The entrypoint check above tells them apart.
    if os.environ.get("ALT_AGENT_ID") == "liaison-01":
        note = f"{NOTE} {FORMAT_NOTE}"
        if reply:
            words, ids = score(reply)
            if words > FLAG_WORDS or ids > FLAG_IDS:
                note += f" Last reply: {words} words, {ids} IDs. Shorter unless I asked for detail."
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "UserPromptSubmit", "additionalContext": note}}))
except Exception:
    pass
sys.exit(0)
