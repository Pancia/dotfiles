#!/usr/bin/env bash
set -euo pipefail

SNAP_DIR="$HOME/.local/share/disk-snapshots"
THRESHOLD_KB=$((100 * 1024))  # 100MB default

usage() {
    echo "Usage: disk-snapshot-diff [-t THRESHOLD_MB] [start [end]]"
    echo "  -t  Minimum change in MB to display (default: 100)"
    echo "  Args can be full paths or date stems (e.g. 2026-03-11)."
    echo "  No args: compares the two most recent snapshots."
    echo "  One arg: compares that snapshot to the latest."
    echo "  Two args: compares start to end."
    exit 1
}

resolve_snap() {
    local arg="$1"
    if [[ -f "$arg" ]]; then
        echo "$arg"
    elif [[ -f "$SNAP_DIR/$arg.txt" ]]; then
        echo "$SNAP_DIR/$arg.txt"
    else
        echo "Snapshot not found: $arg" >&2
        exit 1
    fi
}

while getopts "t:h" opt; do
    case "$opt" in
        t) THRESHOLD_KB=$(( OPTARG * 1024 )) ;;
        h) usage ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))

mapfile -t snaps < <(ls -1 "$SNAP_DIR"/*.txt 2>/dev/null | sort)

if [[ $# -eq 2 ]]; then
    OLD="$(resolve_snap "$1")"
    NEW="$(resolve_snap "$2")"
elif [[ $# -eq 1 ]]; then
    OLD="$(resolve_snap "$1")"
    if [[ ${#snaps[@]} -lt 1 ]]; then
        echo "No snapshots in $SNAP_DIR" >&2
        exit 1
    fi
    NEW="${snaps[-1]}"
elif [[ $# -eq 0 ]]; then
    if [[ ${#snaps[@]} -lt 2 ]]; then
        echo "Need at least 2 snapshots in $SNAP_DIR"
        exit 1
    fi
    OLD="${snaps[-2]}"
    NEW="${snaps[-1]}"
else
    usage
fi

human_size() {
    local kb="$1"
    local abs_kb="${kb#-}"
    local sign=""
    [[ "$kb" -lt 0 ]] && sign="-"

    if [[ "$abs_kb" -ge $((1024 * 1024)) ]]; then
        printf "%s%.1fG" "$sign" "$(echo "scale=1; $abs_kb / 1048576" | bc)"
    elif [[ "$abs_kb" -ge 1024 ]]; then
        printf "%s%.0fM" "$sign" "$(echo "scale=0; $abs_kb / 1024" | bc)"
    else
        printf "%s%dK" "$sign" "$abs_kb"
    fi
}

old_date="$(basename "$OLD" .txt)"
new_date="$(basename "$NEW" .txt)"
echo "Comparing $old_date -> $new_date"
echo ""

# Parse a snapshot file into section -> (path -> size_kb) mappings
# Output format: section<TAB>path<TAB>size_kb
# One awk pass. The old bash loop forked two awks per line and took about 20 s
# on two real snapshots. Lines are "size<TAB>path"; a path may hold spaces.
parse_snapshot() {
    awk '
        /^=== .* ===$/ { section = substr($0, 5, length($0) - 8); next }
        section == "" || $0 == "" { next }
        section == "could not read" { printf "%s\t%s\t-\n", section, $0; next }
        {
            tab = index($0, "\t")
            if (tab < 2) next
            size = substr($0, 1, tab - 1)
            path = substr($0, tab + 1)
            if (size ~ /^[0-9]+$/ && path != "") printf "%s\t%s\t%s\n", section, path, size
        }' "$1"
}

# Build associative arrays from parsed data
declare -A old_sizes new_sizes
declare -A sections_seen old_sections new_sections
# Folders du could not open in either scan. Their sizes are too small or
# missing, so a change in them is not real growth or shrinkage.
declare -A unreadable

while IFS=$'\t' read -r section path size; do
    if [[ "$section" == "could not read" ]]; then unreadable["$path"]=1; continue; fi
    old_sizes["$section|$path"]="$size"
    sections_seen["$section"]=1
    old_sections["$section"]=1
done < <(parse_snapshot "$OLD")

while IFS=$'\t' read -r section path size; do
    if [[ "$section" == "could not read" ]]; then unreadable["$path"]=1; continue; fi
    new_sizes["$section|$path"]="$size"
    sections_seen["$section"]=1
    new_sections["$section"]=1
done < <(parse_snapshot "$NEW")

# Collect all unique section|path keys
declare -A all_keys
for key in "${!old_sizes[@]}" "${!new_sizes[@]}"; do
    all_keys["$key"]=1
done

# Group by section and compute deltas
had_output=false
no_baseline=()
while IFS= read -r section; do
    section_lines=()

    # A section added to the scan after OLD was taken has no baseline, so every
    # entry in it would read as NEW. Skip it, but say so below: with a baseline
    # about 30 days back, silence would read as "no growth" for a month.
    if [[ -z "${old_sections[$section]:-}" ]]; then
        [[ -n "${new_sections[$section]:-}" ]] && no_baseline+=("$section")
        continue
    fi
    [[ -n "${new_sections[$section]:-}" ]] || continue

    while IFS= read -r key; do
        [[ "$key" != "$section|"* ]] && continue
        path="${key#"$section|"}"

        # du walks /System/Volumes/Data, so these two rows count the data
        # volume twice and their deltas mean nothing.
        [[ "$section" == "/" && ( "$path" == "/" || "$path" == "/System" ) ]] && continue

        old_kb="${old_sizes[$key]:-0}"
        new_kb="${new_sizes[$key]:-0}"
        delta=$(( new_kb - old_kb ))
        abs_delta="${delta#-}"
        note=""
        [[ -n "${unreadable[$path]:-}" ]] && note="  [not fully read]"

        if [[ "$old_kb" -eq 0 && "$new_kb" -gt 0 ]]; then
            # New path
            if [[ "$new_kb" -ge "$THRESHOLD_KB" ]]; then
                section_lines+=("$(printf '  NEW    %s (%s)%s' "$path" "$(human_size "$new_kb")" "$note")")
            fi
        elif [[ "$new_kb" -eq 0 && "$old_kb" -gt 0 ]]; then
            # Removed path
            if [[ "$old_kb" -ge "$THRESHOLD_KB" ]]; then
                section_lines+=("$(printf '  DEL    %s (was %s)%s' "$path" "$(human_size "$old_kb")" "$note")")
            fi
        elif [[ "$abs_delta" -ge "$THRESHOLD_KB" ]]; then
            sign="+"
            [[ "$delta" -lt 0 ]] && sign=""
            section_lines+=("$(printf '  %s%s  %s (%s)%s' "$sign" "$(human_size "$delta")" "$path" "$(human_size "$new_kb")" "$note")")
        fi
    done < <(printf '%s\n' "${!all_keys[@]}" | sort)

    if [[ ${#section_lines[@]} -gt 0 ]]; then
        echo "=== $section ==="
        printf '%s\n' "${section_lines[@]}"
        echo ""
        had_output=true
    fi
done < <(printf '%s\n' "${!sections_seen[@]}" | sort)

if ! $had_output; then
    echo "No significant changes (threshold: $(human_size "$THRESHOLD_KB"))."
fi

if [[ ${#no_baseline[@]} -gt 0 ]]; then
    [[ "$had_output" == true ]] || echo ""
    echo "Not compared (no such section in $old_date, so no baseline yet):"
    printf '  %s\n' "${no_baseline[@]}"
fi
