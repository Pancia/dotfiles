#!/usr/bin/env python3
"""Generate a git commit message from a diff on stdin. Outputs JSON: {"message": "..."}"""

import asyncio
import json
import os
import re
import sys

from claude_agent_sdk import (
    ClaudeSDKClient,
    ClaudeAgentOptions,
    ResultMessage,
    ClaudeSDKError,
)

_COMMIT_RE = re.compile(r"<commit>\s*(.*?)\s*</commit>", re.DOTALL)
_INCLUDE_RE = re.compile(r"^@(\S+)\s*$", re.MULTILINE)

# One toolless call on a diff; minutes only for a very large one.
_TIMEOUT = float(os.environ.get("AI_COMMIT_MSG_TIMEOUT", 300))


def load_template(path: str, _seen: set[str] | None = None) -> str:
    """Read a prompt template, expanding `@<path>` lines as includes.

    An `@<path>` line (alone on its line) is replaced by the contents of the
    referenced file, which is itself expanded recursively. Paths may start
    with `~` and are resolved relative to the including file's directory.
    Cycles raise RuntimeError.
    """
    abs_path = os.path.abspath(os.path.expanduser(path))
    seen = _seen if _seen is not None else set()
    if abs_path in seen:
        raise RuntimeError(f"include cycle detected at {abs_path}")
    seen = seen | {abs_path}
    base = os.path.dirname(abs_path)
    with open(abs_path) as f:
        text = f.read()

    def _replace(match: re.Match) -> str:
        ref = os.path.expanduser(match.group(1))
        if not os.path.isabs(ref):
            ref = os.path.join(base, ref)
        return load_template(ref, seen)

    return _INCLUDE_RE.sub(_replace, text)


def extract_commit(text: str) -> str:
    """Extract commit message from <commit> tags."""
    m = _COMMIT_RE.search(text)
    return m.group(1) if m else text.strip()


async def _receive_commit(client: ClaudeSDKClient) -> str:
    async for msg in client.receive_response():
        if isinstance(msg, ResultMessage):
            if msg.is_error or msg.result is None:
                detail = msg.result or (msg.errors and "; ".join(msg.errors))
                raise RuntimeError(detail or f"generation failed ({msg.subtype})")
            return extract_commit(msg.result)
    raise RuntimeError("no result returned from model")


async def generate(system_prompt: str, diff: str) -> str:
    options = ClaudeAgentOptions(
        model="claude-sonnet-5",
        system_prompt=system_prompt,
        allowed_tools=[],
        permission_mode="default",
    )
    client = ClaudeSDKClient(options=options)
    async with client:
        await client.query(diff)
        # A headless claude can wedge and never exit (seen 2026-07-28: ~98% CPU,
        # RSS past 2.7GB, no output), and the SDK would wait on it for ever. The
        # deadline sits *inside* `async with` so the timeout surfaces here rather
        # than as a cancellation: the SDK's close() then runs on a live task and
        # escalates stdin-EOF → SIGTERM → SIGKILL, so the child dies with us.
        try:
            return await asyncio.wait_for(_receive_commit(client), _TIMEOUT)
        except asyncio.TimeoutError:
            raise RuntimeError(
                f"timed out after {_TIMEOUT:g}s; raise AI_COMMIT_MSG_TIMEOUT to allow longer"
            ) from None


def main():
    diff = sys.stdin.read()
    if not diff.strip():
        print('{"message": ""}')
        return

    system_path = sys.argv[1] if len(sys.argv) > 1 else None
    if system_path:
        system_prompt = load_template(system_path)
    else:
        system_prompt = "You are a git commit message writer. Output ONLY the commit message, nothing else."

    try:
        message = asyncio.run(generate(system_prompt, diff))
    except (ClaudeSDKError, OSError, RuntimeError) as e:
        # Emit empty-message JSON (so callers checking .message also abort) plus a
        # non-zero exit. Narrow catch: genuine bugs still surface as a traceback.
        reason = f"{type(e).__name__}: {e}"
        json.dump({"message": "", "error": reason}, sys.stdout)
        print()
        print(f"ai-commit-msg: {reason}", file=sys.stderr)
        sys.exit(1)

    if not message.strip():
        json.dump({"message": "", "error": "model returned empty message"}, sys.stdout)
        print()
        print("ai-commit-msg: model returned empty message", file=sys.stderr)
        sys.exit(1)

    json.dump({"message": message}, sys.stdout)
    print()


if __name__ == "__main__":
    main()
