#!/opt/homebrew/bin/fish
# live-transcribe-launch — toggle LiveTranscribe.app. Bound to Alt+Space.
#
#   idle    -> open LiveTranscribe.app (the app spawns the live-transcribe
#              engine itself)
#   running -> stop the app (SIGTERM: it SIGINTs/flushes the engine, copies the
#              transcript to the clipboard, then closes)
#
# Why the app — not this script — spawns the engine: macOS attributes a
# microphone request to the *responsible process* at the top of the launch
# chain. Launched by Karabiner's shell_command, that process is a Karabiner
# helper with no grantable mic entry, so capture silently fails. A .app opened
# via LaunchServices (`open`) is its own responsible process and (with
# NSMicrophoneUsageDescription) gets a real, persistent "Live Transcribe" grant
# in System Settings ▸ Privacy & Security ▸ Microphone.

set -l mic 'BOYA'
set -l app /Users/anthony/dotfiles/bin/LiveTranscribe.app
set -l appbin $app/Contents/MacOS/live-transcribe-app

# terminal-notifier via absolute path (Karabiner/Hermes give a minimal PATH);
# degrade silently when it's absent so recovery still copies.
function __lt_notify -a title msg
    set -l tn /opt/homebrew/bin/terminal-notifier
    if test -x $tn
        $tn -title "$title" -message "$msg" >/dev/null 2>&1
    end
end

# Mode: default toggles the app. --ref makes a stop copy a `read <path>` reference
# instead of the full transcript. --copy / --copy-ref recover the newest saved
# transcript to the clipboard WITHOUT starting a session (the "I forgot / used the
# wrong shortcut after it already closed" fix).
set -l mode toggle
switch "$argv[1]"
    case --ref
        set mode ref
    case --copy
        set mode copy-full
    case --copy-ref
        set mode copy-ref
end

# --- RECOVERY: copy the newest saved transcript; never touch the app -------
# Runs before the launch lock so it can't be wedged by / can't wedge a toggle,
# and never opens the app (a fresh launch would create an empty transcript that
# shadows the one you wanted).
if test "$mode" = copy-full -o "$mode" = copy-ref
    set -l tdir ~/Cloud/transcripts
    # Newest by filename: transcript_<ts> sorts lexically with record-start, so
    # this is immune to ProtonDrive rewriting mtimes when it syncs remote files.
    set -l txts $tdir/transcript_*.txt
    if test (count $txts) -eq 0
        __lt_notify 'Live Transcribe' 'No transcripts found'
        exit 0
    end
    set -l newest $txts[-1]
    if not test -s $newest
        __lt_notify 'Live Transcribe' 'Newest transcript is empty — nothing copied'
        exit 0
    end
    if test "$mode" = copy-ref
        set -l abbrev (string replace $HOME '~' $newest)
        printf '%s' "read $abbrev" | pbcopy
        __lt_notify 'Live Transcribe' "Copied reference: read $abbrev"
    else
        pbcopy <$newest
        __lt_notify 'Live Transcribe' 'Copied transcript: '(basename $newest)
    end
    exit 0
end

set -l statedir ~/.local/state/live-transcribe
mkdir -p $statedir

# --- serialize concurrent invocations (debounce a fast double-press) -------
# mkdir is atomic. Steal a stale lock (>20s old) left by a crashed invocation
# so a leaked lock can't wedge the toggle. Released at every real exit below.
set -l lockdir $statedir/launch.lock
if not mkdir $lockdir 2>/dev/null
    set -l mt (stat -f %m $lockdir 2>/dev/null)
    if test -n "$mt"; and test (math (date +%s) - $mt) -gt 20
        rmdir $lockdir 2>/dev/null
        mkdir $lockdir 2>/dev/null; or exit 0
    else
        exit 0
    end
end

# --- TOGGLE OFF: app already running -> stop it cleanly --------------------
# plain → SIGTERM: the app SIGINTs the engine (flush + save), copies the full
#         transcript to the clipboard, then exits.
# --ref → SIGUSR1: same stop, but copies a `read <path>` reference instead.
# (Escape / the window's close button cancel *in-app*: stop, keep files, no copy.)
if pgrep -f $appbin >/dev/null 2>&1
    if test "$mode" = ref
        pkill -USR1 -f $appbin 2>/dev/null
    else
        pkill -TERM -f $appbin 2>/dev/null
    end
    rmdir $lockdir 2>/dev/null
    exit 0
end

# --- TOGGLE ON ------------------------------------------------------------
/usr/bin/open $app --args --mic $mic
rmdir $lockdir 2>/dev/null
