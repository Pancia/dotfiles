#!/usr/bin/env ruby

require "cli.rb"

require "shellwords"
require "time"

$home_dir = "/Users/#{%x[whoami].strip}/"
$services_dir = "#{$home_dir}/dotfiles/services/"
$log_dir = "#{$home_dir}/.log/services/"
$launch_agents_dir = "#{$home_dir}/Library/LaunchAgents/"

def log_for(name)
  "#{$log_dir}#{name}.log"
end

# launchd keeps no "started at" timestamp (`launchctl print` only counts runs),
# so a running job's start time comes from its process instead. One `ps` call
# for every pid at once; returns { pid_string => Time }.
def start_times_for(pids)
  return {} if pids.empty?

  # LC_ALL=C: `lstart` is locale-formatted, and Time.parse can't read a
  # non-Latin month/day (ja_JP gives "木  7/16 19:01:20 2026" -> ArgumentError).
  out = %x[LC_ALL=C ps -o pid=,lstart= -p #{pids.join(",").shellescape} 2>/dev/null]
  out.each_line.with_object({}) do |line, acc|
    pid, lstart = line.strip.split(/\s+/, 2)
    next unless pid && lstart

    acc[pid] = (Time.parse(lstart) rescue nil)
  end.compact
end

# Coarse "how long ago", one unit — the absolute timestamp next to it carries
# the precision. The guard also absorbs a negative age (clock skew, or a start
# time in the future), which reads better as "just now" than as "-27h".
def time_ago(time)
  secs = (Time.now - time).to_i
  return "just now" if secs < 5

  [[86_400, "d"], [3_600, "h"], [60, "m"]].each do |span, unit|
    return "#{secs / span}#{unit}" if secs >= span
  end
  "#{secs}s"
end

# Lines that are almost always noise in a polling-bot log (Telegram long-poll, etc.).
# Hidden by `service log <name> --quiet`. Treated as REGEXES (grep -E), not
# fixed strings.
#
# Each pattern must match ONLY the successful idle poll. Anything broader is a
# trap: matching bare "getUpdates" also swallows 280 × 502 Bad Gateway, 56 × 429
# Too Many Requests, 11 × 409 Conflict and — worst — 15 × "terminated by other
# getUpdates request", which is the alarm for two bot instances polling one
# token. Those are measured counts from a single 139-day log, i.e. exactly the
# lines someone reaches for `-q` to go find.
#
# (This also once matched every "HTTP Request: … api.telegram.org" line, hiding
# the 4xx/5xx of every send and download too.)
LOG_NOISE = [
  'getUpdates.* 200 OK',
].freeze

# Pull the value out of trailing args for `--flag value` or `--flag=value`.
# Accepts several aliases (first match wins). Returns nil if absent.
def flag_val(args, *names)
  names.each do |flag|
    if (hit = args.find { |a| a.start_with?("#{flag}=") })
      return hit.split("=", 2)[1]
    end
    idx = args.index(flag)
    return args[idx + 1] if idx && args[idx + 1]
  end
  nil
end

# ---------------------------------------------------------------------------
# Log viewing (shared by `service log` and `service restart --log`)
# ---------------------------------------------------------------------------

LOG_FLAG_NOTES = <<~NOTES
  Log view notes:
      Flags work before or after <name> (`log -q inari` == `log inari -q`).
      TTY, no filters : live follow in `less +GF` (q or Ctrl-C to quit).
      TTY, filtered   : live follow through `grep --line-buffered`.
      Not a TTY       : always a snapshot, as if -p were given (agent/pipe safe).
      Snapshots filter the whole file first, so --lines counts *matching* lines.
      --no-follow / --tail N are accepted as aliases of -p / --lines N.
NOTES

# Declare the log-view flags on a subcommand's parser, so they show up in
# `service <cmd> --help` and in fish completions. Flags seen *before* <name>
# are appended to `pre` in their raw form; flags after <name> land in the
# handler's *args. Both are parsed by `parse_log_args`.
def add_log_flags(opts, pre)
  opts.on("-p", "--print", "Print the last N lines and exit (no pager, no follow)") { pre << "--print" }
  opts.on("-q", "--quiet", "Hide known polling noise (see LOG_NOISE in this script)") { pre << "--quiet" }
  opts.on("--lines N", "How many lines to show (default 200)") { |v| pre.push("--lines", v) }
  opts.on("--grep PAT", "Keep only lines matching extended-regex PAT") { |v| pre.push("--grep", v) }
  opts.on("--exclude PAT", "Drop lines matching extended-regex PAT") { |v| pre.push("--exclude", v) }
end

def parse_log_args(args)
  n = (flag_val(args, "--lines", "--tail") || "200").to_i
  {
    quiet:   args.include?("-q") || args.include?("--quiet"),
    grep:    flag_val(args, "--grep"),
    exclude: flag_val(args, "--exclude"),
    lines:   n <= 0 ? 200 : n,
    # Snapshot (print & exit) when asked with -p/--print, or when stdout isn't a
    # terminal (piped / run by an agent). Otherwise follow the log live.
    snapshot: args.include?("-p") || args.include?("--print") ||
              args.include?("--no-follow") || !$stdout.tty?,
  }
end

# Replaces this process with the log viewer. Returns (having printed a message)
# only when there is no log file.
def view_log!(name, args)
  short   = short_name(normalize_service_name(name))
  logfile = log_for(short)
  return puts "No log file at #{logfile}" unless File.exist?(logfile)

  o        = parse_log_args(args)
  filtered = o[:quiet] || o[:grep] || o[:exclude]

  # Fast path: interactive live follow with paging, no filtering (original
  # behavior). Press Ctrl-C (or q) to stop.
  if !o[:snapshot] && !filtered
    Kernel.exec("command less +GF #{logfile.shellescape}")
  end

  # grep filters (line-buffered when following so output isn't stuck in a buffer).
  lb = o[:snapshot] ? "" : "--line-buffered "
  greps = []
  LOG_NOISE.each { |p| greps << "grep #{lb}-v -E -e #{p.shellescape}" } if o[:quiet]
  greps << "grep #{lb}-v -E -e #{o[:exclude].shellescape}" if o[:exclude]
  greps << "grep #{lb}-E -e #{o[:grep].shellescape}" if o[:grep]

  pipeline =
    if o[:snapshot]
      # Filter the whole file, then show the last N matching lines.
      ["cat #{logfile.shellescape}", *greps, "tail -n #{o[:lines]}"]
    else
      # Live, filtered follow: seed with the last N lines, then stream new ones.
      ["tail -n #{o[:lines]} -f #{logfile.shellescape}", *greps]
    end

  Kernel.exec("bash", "-c", pipeline.join(" | "))
end

def normalize_service_name(name)
  # Accept "vpc" or "org.pancia.vpc"
  name.start_with?("org.pancia.") ? name : "org.pancia.#{name}"
end

def short_name(full_name)
  full_name.sub("org.pancia.", "")
end

def plist_path_in_services(name)
  short = short_name(name)
  "#{$services_dir}#{short}/#{name}.plist"
end

def plist_path_in_launch_agents(name)
  "#{$launch_agents_dir}#{name}.plist"
end

def service_dir(name)
  short = short_name(name)
  "#{$services_dir}#{short}/"
end

def detect_main_script(name)
  dir = service_dir(name)
  # Prefer script.sh, then other common script files
  candidates = ["script.sh", "server.rb", "listener.rb", "listener.swift", "script.py"]
  candidates.each do |candidate|
    path = "#{dir}#{candidate}"
    return path if File.exist?(path)
  end
  # Fallback to any .sh, .rb, .swift, .py file
  Dir.glob("#{dir}*.{sh,rb,swift,py}").first
end

def execute(cmd)
  puts cmd if $options[:verbose]
  system(cmd)
end

# `launchctl list <label>` exits 0 when launchd has the job loaded, 113 when not.
def launchd_loaded?(label)
  system("launchctl list #{label.shellescape} >/dev/null 2>&1")
end

# One job's state from `launchctl list <label>`, or nil when it is not loaded.
# The "PID" key is present only while a run is going. "LastExitStatus" here is
# the raw wait status (exit 3 reads 768), unlike the decoded column of the bare
# `launchctl list` table.
def launchd_job(label)
  out = %x[launchctl list #{label.shellescape} 2>/dev/null]
  return nil unless $?.success?

  pid = out[/"PID" = (\d+);/, 1]
  last = out[/"LastExitStatus" = (-?\d+);/, 1]
  { pid: pid && pid.to_i, last: last && last.to_i }
end

# Raw wait status -> "exit N" / "signal N", and whether it was a success.
def decode_wait_status(raw)
  return ["unknown", false] if raw.nil?
  return ["signal #{-raw}", false] if raw < 0

  sig = raw & 0x7f
  return ["signal #{sig}", false] if sig != 0

  code = (raw >> 8) & 0xff
  ["exit #{code}", code.zero?]
end

class ServiceCMDS
  def self.list(opts)
    opts.info = "List my services"
    lambda { execute("launchctl list | ag org.pancia") }
  end
  def self.start(opts)
    opts.info = "Start a service."
    lambda { |name|
      return puts "Usage: service start <name>" unless name

      full_name = normalize_service_name(name)
      plist_dest = plist_path_in_launch_agents(full_name)

      # Try to install if not present (fallback)
      unless File.exist?(plist_dest)
        plist_src = plist_path_in_services(full_name)
        if File.exist?(plist_src)
          puts "Installing #{full_name}..."
          execute("ln -f #{plist_src.shellescape} #{plist_dest.shellescape}")
        else
          return puts "Error: Service '#{name}' not found in #{$services_dir}"
        end
      end

      # Loading a job that is already loaded prints "Load failed: 5" and still
      # exits 0, so ask launchd whether it knows the label instead.
      unless launchd_loaded?(full_name)
        puts "Loading #{full_name}..."
        execute("launchctl load #{plist_dest.shellescape}")
        unless launchd_loaded?(full_name)
          warn "Error: launchd did not load #{plist_dest}"
          exit 1
        end
      end
      unless execute("launchctl start #{full_name.shellescape}")
        warn "Error: launchctl start #{full_name} failed (exit #{$?.exitstatus})"
        exit 1
      end
      puts "Started #{full_name}"
    }
  end
  def self.stop(opts)
    opts.info = "Stop a service."
    lambda { |name|
      return puts "Usage: service stop <name>" unless name

      full_name = normalize_service_name(name)
      plist_dest = plist_path_in_launch_agents(full_name)

      unless File.exist?(plist_dest)
        return puts "Error: Service '#{name}' is not installed"
      end

      puts "Stopping #{full_name}..."
      execute("launchctl stop #{full_name.shellescape}")
      execute("launchctl unload #{plist_dest.shellescape}")
      puts "Stopped #{full_name}"
    }
  end
  def self.restart(opts)
    opts.info = "Restart a service, optionally tailing its log afterwards."
    opts.banner = "Usage: service restart <name> [-l|--log] [LOG FLAGS]"
    pre = []
    opts.on("-l", "--log", "Show the log after restarting (accepts the `service log` flags below)") { pre << "--log" }
    add_log_flags(opts, pre)
    opts.separator ""
    opts.separator LOG_FLAG_NOTES
    opts.separator ""
    opts.separator "Examples:"
    opts.separator "    service restart inari --log                     restart, then follow in less"
    opts.separator "    service restart inari --log -q                  restart, then follow, noise filtered"
    opts.separator "    service restart inari --log -q -p --lines 50    restart, print 50 clean lines, exit"
    opts.separator ""
    lambda { |name, *args|
      return puts opts.to_s unless name

      log_args = pre + args
      # Strip the --log flag itself; whatever is left are `service log` flags,
      # and passing any of those implies --log.
      asked_log = [log_args.delete("--log"), log_args.delete("-l")].any?
      open_log  = asked_log || !log_args.empty?

      full_name = normalize_service_name(name)
      plist_dest = plist_path_in_launch_agents(full_name)

      unless File.exist?(plist_dest)
        return puts "Error: Service '#{name}' is not installed"
      end

      puts "Restarting #{full_name}..."
      execute("launchctl stop #{full_name.shellescape}")
      execute("launchctl unload #{plist_dest.shellescape}")
      sleep 0.5
      execute("launchctl load #{plist_dest.shellescape}")
      execute("launchctl start #{full_name.shellescape}")
      puts "Restarted #{full_name}"

      view_log!(full_name, log_args) if open_log
    }
  end
  def self.reload(opts)
    opts.info = "Re-read a service's plist without running it (restart, minus the start)."
    opts.banner = "Usage: service reload <name>"
    opts.separator ""
    opts.separator "launchctl load ignores a job that is already loaded, so an edited plist"
    opts.separator "needs unload + load. `restart` also runs the job at once; `reload` does not."
    opts.separator "A run in progress is stopped. A RunAtLoad or KeepAlive job starts again on"
    opts.separator "load; a scheduled job waits for its next time."
    opts.separator ""
    lambda { |name|
      return puts opts.to_s unless name

      full_name = normalize_service_name(name)
      plist_dest = plist_path_in_launch_agents(full_name)

      unless File.exist?(plist_dest)
        return puts "Error: Service '#{name}' is not installed"
      end

      puts "Reloading #{full_name}..."
      execute("launchctl stop #{full_name.shellescape}")
      execute("launchctl unload #{plist_dest.shellescape}")
      sleep 0.5
      execute("launchctl load #{plist_dest.shellescape}")
      unless launchd_loaded?(full_name)
        warn "Error: launchd did not load #{plist_dest}"
        exit 1
      end
      puts "Reloaded #{full_name} (not started)"
    }
  end
  def self.wait(opts)
    opts.info = "Wait until a service's current run ends."
    opts.banner = "Usage: service wait <name> [--timeout SECS]"
    timeout = nil
    opts.on("-t", "--timeout SECS", Integer, "Give up after SECS (default 110)") { |v| timeout = v }
    opts.separator ""
    opts.separator "Exit codes:"
    opts.separator "    0    the run ended with exit 0"
    opts.separator "    1    the run ended with a non-zero exit or a signal"
    opts.separator "    2    nothing was running when called (it does not wait for a start;"
    opts.separator "         launchd delays a `start` of a job that ran in the last 10 s)"
    opts.separator "    3    not loaded, or unloaded while waiting"
    opts.separator "    124  timed out; the run is still going (call again to keep waiting)"
    opts.separator ""
    opts.separator "The 110 s default fits an agent's default 120 s Bash timeout. For a long"
    opts.separator "run, pass a larger --timeout and run it in the background."
    opts.separator ""
    lambda { |name, *args|
      return puts opts.to_s unless name

      # Flags after <name> are not parsed by OptionParser#order!, so read them here.
      if (v = flag_val(args, "--timeout", "-t"))
        timeout = Integer(v, exception: false)
        unless timeout
          warn "Error: --timeout needs a whole number of seconds, got '#{v}'"
          exit 1
        end
      end
      timeout ||= 110

      full_name = normalize_service_name(name)
      job = launchd_job(full_name)
      unless job
        warn "#{full_name} is not loaded"
        exit 3
      end
      unless job[:pid]
        puts "#{full_name} is not running"
        exit 2
      end

      pid = job[:pid]
      deadline = Time.now + timeout
      puts "Waiting for #{full_name} (pid #{pid}, timeout #{timeout}s)..."
      $stdout.flush
      loop do
        job = launchd_job(full_name)
        unless job
          warn "#{full_name} was unloaded while waiting"
          exit 3
        end
        # Gone, or a different pid: the run we saw has ended (a new one may have begun).
        break if job[:pid] != pid

        left = deadline - Time.now
        if left <= 0
          puts "#{full_name} is still running (pid #{pid}) after #{timeout}s"
          exit 124
        end
        sleep [2, left].min
      end

      text, ok = decode_wait_status(job[:last])
      puts "#{full_name} run ended: #{text}"
      exit(ok ? 0 : 1)
    }
  end
  def self.status(opts)
    opts.info = "status of all services, with when each was last started"
    lambda {
      output = %x[launchctl list | grep org.pancia]
      return puts "No org.pancia services found" if output.empty?

      rows = output.each_line.map do |line|
        parts = line.strip.split(/\s+/)
        running = parts[0] != "-"
        exit_code = parts[1]
        {
          name:    parts[2].sub("org.pancia.", ""),
          pid:     running ? parts[0] : "-",
          running: running,
          status:  running ? (exit_code == "0" ? "running" : "error (#{exit_code})") : "stopped",
        }
      end

      starts = start_times_for(rows.select { |r| r[:running] }.map { |r| r[:pid] })

      # A stopped job has no process to ask, so fall back to the mtime of its
      # log — for the periodic ones (ziplog, disk-snapshot) that *is* the last
      # run. Flagged with * since it's a last-write, not a start.
      rows.each do |row|
        if row[:running]
          row[:when] = starts[row[:pid]]
        else
          logfile = log_for(row[:name])
          row[:when] = File.mtime(logfile) if File.exist?(logfile)
          row[:stale] = !row[:when].nil?
        end
      end

      fmt = "%-24s %-8s %-12s %-21s %s"
      puts fmt % ["SERVICE", "PID", "STATUS", "LAST START", "AGO"]
      puts "-" * 72
      rows.each do |row|
        stamp = row[:when] ? row[:when].strftime("%Y-%m-%d %H:%M:%S") : "unknown"
        stamp += "*" if row[:stale]
        ago = row[:when] ? time_ago(row[:when]) : ""
        puts (fmt % [row[:name], row[:pid], row[:status], stamp, ago]).rstrip
      end

      if rows.any? { |r| r[:stale] }
        puts ""
        puts "* stopped: last write to its log, not a start time"
      end
    }
  end
  def self.log(opts)
    opts.info = "Show a service's logs (live in a pager, or a filtered snapshot)."
    opts.banner = "Usage: service log <name> [FLAGS]"
    pre = []
    add_log_flags(opts, pre)
    opts.separator ""
    opts.separator LOG_FLAG_NOTES
    opts.separator ""
    opts.separator "Examples:"
    opts.separator "    service log inari                     live follow in less"
    opts.separator "    service log inari -q                  live follow, noise filtered"
    opts.separator "    service log inari -q -p --lines 80    last 80 clean lines, then exit"
    opts.separator "    service log inari --grep 'Error|Traceback' -p"
    opts.separator ""
    lambda { |name, *args|
      return puts opts.to_s unless name
      view_log!(name, pre + args)
    }
  end
  def self.create(opts)
    opts.info = "Create a new service."
    lambda { |name|
      return puts "Usage: service create <name>" unless name

      full_name = normalize_service_name(name)
      short = short_name(full_name)
      dir = service_dir(full_name)

      if Dir.exist?(dir)
        return puts "Error: Service '#{short}' already exists at #{dir}"
      end

      puts "Creating service '#{short}'..."

      # Create directory
      execute("mkdir -p #{dir.shellescape}")

      # Create plist
      plist_content = <<~PLIST
        <?xml version="1.0" encoding="UTF-8"?>
        <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
        <plist version="1.0">
            <dict>
                <key>Label</key>
                <string>#{full_name}</string>
                <key>ProgramArguments</key>
                <array>
                    <string>#{$home_dir}dotfiles/services/#{short}/dotfiles-services-#{short}.sh</string>
                </array>
                <key>RunAtLoad</key>
                <true/>
                <key>KeepAlive</key>
                <true/>
                <key>StandardOutPath</key>
                <string>#{$home_dir}.log/services/#{short}.log</string>
                <key>StandardErrorPath</key>
                <string>#{$home_dir}.log/services/#{short}.log</string>
            </dict>
        </plist>
      PLIST
      File.write("#{dir}#{full_name}.plist", plist_content)

      # Create wrapper script
      wrapper_content = "~/dotfiles/bin/service-wrapper ~/dotfiles/services/#{short}/ ./script.sh\n"
      File.write("#{dir}dotfiles-services-#{short}.sh", wrapper_content)
      execute("chmod +x #{dir}dotfiles-services-#{short}.sh")

      # Create main script
      script_content = <<~SCRIPT
        #!/usr/bin/env bash

        echo "$(date): #{short} service started"

        # Your service logic here
        while true; do
            echo "$(date): Running..."
            sleep 60
        done
      SCRIPT
      File.write("#{dir}script.sh", script_content)
      execute("chmod +x #{dir}script.sh")

      puts "Created service '#{short}' at #{dir}"
      puts "  - #{full_name}.plist"
      puts "  - dotfiles-services-#{short}.sh"
      puts "  - script.sh"
      puts ""
      puts "Next steps:"
      puts "  1. Edit: service edit #{short}"
      puts "  2. Start: service start #{short}"
      puts "  3. Logs: service log #{short}"
    }
  end
  def self.edit(opts)
    opts.info = "Edit a service's script and plist."
    lambda { |name|
      return puts "Usage: service edit <name>" unless name

      full_name = normalize_service_name(name)
      short = short_name(full_name)
      dir = service_dir(full_name)

      unless Dir.exist?(dir)
        return puts "Error: Service '#{short}' not found at #{dir}"
      end

      script = detect_main_script(full_name)
      plist = plist_path_in_services(full_name)

      unless script
        return puts "Error: No main script found in #{dir}"
      end

      unless File.exist?(plist)
        return puts "Error: Plist not found at #{plist}"
      end

      editor = ENV["EDITOR"] || "vim"
      puts "Opening #{short} in #{editor}..."
      Kernel.exec("#{editor} #{script.shellescape} #{plist.shellescape}")
    }
  end
end

CLI.parse! ServiceCMDS
