#!/usr/bin/env bash
#
# rolevotes-review — open a new iTerm tab with a Claude Code session that
# reviews the roleplay bookend votes (prompt: ai/prompts/rolevotes-review.md).
#
# Called by the roleplay-bookends mod's reminder button, and by the
# hammerspoon://rolevotes link (lib/lua/seeds/rolevote.lua), which the mod no
# longer draws but which still works when opened by hand. The tab's shell is
# fish. It runs my-claude-code-wrapper by name: `claude` there is the bare
# binary, and the `cc` abbreviation does not expand in text sent by
# `write text`, so only the wrapper registers the session with ccs.

set -euo pipefail

prompt="$HOME/dotfiles/ai/prompts/rolevotes-review.md"
[ -r "$prompt" ] || { echo "rolevotes-review: missing $prompt" >&2; exit 1; }

# A fixed string, passed to osascript as argv: nothing from the prompt file is
# parsed here. fish reads the file itself when the command runs.
cmd="cd ~/dotfiles; and my-claude-code-wrapper (cat ~/dotfiles/ai/prompts/rolevotes-review.md | string collect)"

# Write into the session of the tab (or window) this script made, not the
# "current" one, so a focus change in between cannot send it elsewhere.
osascript - "$cmd" <<'APPLESCRIPT'
on run argv
    set cmd to item 1 of argv
    tell application "iTerm"
        activate
        if (count of windows) is 0 then
            set w to (create window with default profile)
            set s to current session of w
        else
            set t to (create tab with default profile) of current window
            set s to current session of t
        end if
        tell s to write text cmd
    end tell
end run
APPLESCRIPT
