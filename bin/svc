#!/usr/bin/env bash
# svc - control dev processes started in your terminal via `supervise`.
# This is the LLM/tool-facing surface. It never STARTS a service (you own that);
# it only inspects, restarts, or stops one that's already supervised.
#
#   svc [-C <dir>] <subcommand> ...   run as if from <dir> (the project root)
#   svc status [<name>]      pid / alive / readiness + prev exit
#   svc status --short [--tmux]   one line, state files only (cheap; for status bars)
#   svc logs   <name> [-n N] tail .run/<name>.log (the captured crash output)
#   svc restart <name>       respawn the child in place (its pane), wait until serving
#   svc stop    <name>       SIGTERM the supervisor -> stop it
#   svc suspend <name>       drain the child & HOLD (frees its RAM)
#   svc resume  <name>       SIGUSR2 -> respawn the held child
#
# Requests go as .run/<name>.req + SIGUSR1 to a "p2" supervisor (pidfile field 3),
# or the old signals (HUP = restart, USR1 = suspend) to one started before that.
# Starting is not svc's job: a human runs `supervise` (e.g. via cmds), a script
# or LLM runs `svc-tmux up`.
#
# Run from the project root. Project specifics come from `.svc.conf`, the
# private vault's fs-config/<project path>/svc.conf, then `.svc.local.conf`
# (lib/svc/conf.sh). Define there:
#   SVC_SERVICES="a b c"                 # names for `svc status` with no arg
#   svc_port_file() { case "$1" in ...esac; }   # name -> readiness/port file (optional)
#   svc_eval() { ...; }                  # $1=port file; exit 0 if it answers (optional)
# With svc_eval, status distinguishes up|wedged and restart waits for a real
# round-trip; without it, a TCP connect to the port (if any) is the signal.
# Bash-3.2-safe.
set -euo pipefail

if [ "${1:-}" = "-C" ]; then cd "${2:?svc -C <dir>}"; shift 2; fi
run_dir=".run"

# Per-project config.
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/../lib/svc/conf.sh"
while IFS= read -r _cf; do . "$_cf"; done < <(svc_conf_files)   # top level: see conf.sh
SVC_SERVICES="${SVC_SERVICES:-}"
declare -F svc_port_file >/dev/null || svc_port_file() { echo ""; }

# Echo the supervisor PID iff it's alive AND really a `supervise <name>` (guards
# against a recycled PID after an unclean supervisor death).
live_sup() {
  local name="$1" pidfile pid cmd
  pidfile="$run_dir/$name.pid"
  [ -r "$pidfile" ] || return 1
  pid="$(awk '{print $1}' "$pidfile" 2>/dev/null || true)"
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  cmd="$(ps -p "$pid" -o command= 2>/dev/null || true)"
  # Trailing space: 'repl' must not match 'supervise test_repl'; "$cmd " so a name
  # that is the last argv (`supervise server`, command from svc_cmd) matches too.
  case "$cmd " in *"supervise $name "*|*"supervise --keep $name "*) echo "$pid"; return 0 ;; *) return 1 ;; esac
}

# Send a request to a live supervisor. $1 name, $2 pid, $3 restart|suspend.
send_req() {
  local name="$1" pid="$2" req="$3" proto
  proto="$(awk '{print $3}' "$run_dir/$name.pid" 2>/dev/null || true)"
  if [ "$proto" = p2 ]; then
    echo "$req" > "$run_dir/$name.req"; kill -USR1 "$pid"
  elif [ "$req" = restart ]; then
    kill -HUP "$pid"                 # pre-p2 supervisor: HUP meant restart
  else
    kill -USR1 "$pid"                # pre-p2: USR1 meant suspend
  fi
}

port_value() {  # echo numeric port from the name's port file, or empty
  local pf p; pf="$(svc_port_file "$1")"
  [ -n "$pf" ] && [ -r "$pf" ] || return 0
  p="$(tr -d '[:space:]' < "$pf" 2>/dev/null || true)"
  case "$p" in ''|*[!0-9]*) return 0 ;; esac
  echo "$p"
}

port_up() {  # $1 = numeric port
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
}

# Bounded liveness eval via the project's svc_eval: 0 if it answers within ~5s.
# (macOS has no `timeout`, so watchdog-kill a backgrounded eval.) `set -m` makes
# the eval its own process group so the watchdog can kill the WHOLE tree - a JVM
# the eval spawns would otherwise orphan and leak on timeout.
responsive() {
  local pf rc; pf="$(svc_port_file "$1")"
  [ -n "$pf" ] || return 1
  set -m
  ( svc_eval "$pf" >/dev/null 2>&1 ) &
  local ep=$!
  set +m
  ( sleep 5; kill -TERM "-$ep" 2>/dev/null ) >/dev/null 2>&1 &
  local wp=$!
  if wait "$ep" 2>/dev/null; then rc=0; else rc=1; fi
  kill -TERM "-$ep" 2>/dev/null || true   # ensure the eval's group is gone either way
  kill "$wp"  2>/dev/null || true
  wait "$wp"  2>/dev/null || true
  return $rc
}

ready_state() {  # echo up|down|wedged|suspended|n/a for a name
  local name="$1" port
  # A suspended supervisor has cleanly stopped its child; the port is down by
  # design. Report it as such and skip the (slow) eval probe on a dead port - but
  # only if the supervisor is actually alive: a marker left behind by a SIGKILLed
  # supervisor is stale and must not mask the real (down) state.
  if [ -e "$run_dir/$name.suspended" ] && live_sup "$name" >/dev/null 2>&1; then echo "suspended"; return; fi
  port="$(port_value "$name")"
  if [ -z "$port" ]; then
    if [ -n "$(svc_port_file "$name")" ]; then echo "down"; else echo "n/a"; fi   # configured but absent
    return
  fi
  if ! port_up "$port"; then echo "down"; return; fi
  if declare -F svc_eval >/dev/null; then
    if responsive "$name"; then echo "up"; else echo "wedged"; fi
  else
    echo "up"   # port open; no eval probe configured
  fi
}

# 0 if the (new) instance is actually serving - used to confirm a restart.
# A configured port file that is missing means NOT serving yet: supervise deletes
# it on every restart, and the service rewrites it once it listens.
confirmed() {
  [ -n "$(svc_port_file "$1")" ] && [ -z "$(port_value "$1")" ] && return 1
  if declare -F svc_eval >/dev/null; then responsive "$1"; return; fi
  local p; p="$(port_value "$1")"
  [ -n "$p" ] && { port_up "$p"; return; }
  return 0   # no readiness probe configured: gen-advance alone is the signal
}

# One line for a status bar, from state files only (no eval probe, no TCP).
cmd_status_short() {
  local tmux=0 n st sym col out="" pf
  [ "${1:-}" = "--tmux" ] && tmux=1
  for n in $SVC_SERVICES; do
    if ! live_sup "$n" >/dev/null 2>&1; then sym="○"; col=red
    elif [ -e "$run_dir/$n.suspended" ]; then sym="◌"; col=colour244
    else
      sym="●"; col=green
      for pf in $(svc_port_file "$n"); do [ -r "$pf" ] || { sym="◐"; col=yellow; }; done
    fi
    if [ "$tmux" = 1 ]; then out="$out#[fg=$col]$sym#[default] $n  "; else out="$out$sym $n  "; fi
  done
  printf '%s\n' "${out%  }"
}

# Exit 0 iff <name> is supervised, not suspended, and serving. For svc-tmux --wait.
cmd_ready() {
  local name="${1:?svc _ready <name>}" pf
  live_sup "$name" >/dev/null 2>&1 || return 1
  [ -e "$run_dir/$name.suspended" ] && return 1
  local cp; cp="$(awk '{print $2}' "$run_dir/$name.gen" 2>/dev/null || true)"
  [ -n "$cp" ] && kill -0 "$cp" 2>/dev/null || return 1      # the child, not just its supervisor
  for pf in $(svc_port_file "$name"); do [ -r "$pf" ] || return 1; done   # skip the eval until a port exists
  confirmed "$name"
}

cmd_status() {
  local names="${1:-$SVC_SERVICES}" n pid st last
  if [ -z "$names" ]; then
    echo "svc: no SVC_SERVICES configured (looked in $(svc_conf_where)) and no name given" >&2; exit 2
  fi
  for n in $names; do
    if pid="$(live_sup "$n")"; then st="running (sup pid $pid)"; else st="not running"; fi
    last=""; [ -r "$run_dir/$n.status" ] && last="prev exit: $(cat "$run_dir/$n.status")"
    printf '%-10s %-26s ready=%-7s %s\n' "$n" "$st" "$(ready_state "$n")" "$last"
  done
}

cmd_logs() {
  local name="${1:?svc logs <name> [-n N]}" n=80
  [ "${2:-}" = "-n" ] && n="${3:?-n needs a value}"
  local lf="$run_dir/$name.log"
  [ -r "$lf" ] || { echo "svc: no log for '$name' ($lf)" >&2; exit 1; }
  tail -n "$n" "$lf"
}

gen_of() {  # echo the supervisor's current spawn generation, or empty
  local gf="$run_dir/$1.gen"
  [ -r "$gf" ] && awk '{print $1}' "$gf" 2>/dev/null || true
}

cmd_restart() {
  local name="${1:?svc restart <name>}" pid before now i
  if ! pid="$(live_sup "$name")"; then
    echo "svc: '$name' is not running - start it: svc-tmux up --wait $name (or by hand: cmds $name)." >&2
    exit 1
  fi
  before="$(gen_of "$name")"
  echo "svc: restarting '$name' (pid $pid)..."
  send_req "$name" "$pid" restart
  # Restart-complete requires BOTH: the supervisor spawned a NEW instance
  # (generation advanced -> not the dying old process) AND that instance is
  # actually serving (a real probe, not a TCP connect a corpse could satisfy).
  for i in $(seq 1 180); do   # ~90s; process start can be slow
    now="$(gen_of "$name")"
    if [ -n "$now" ] && [ "$now" != "$before" ] && confirmed "$name"; then
      echo "svc: '$name' back up."
      return 0
    fi
    sleep 0.5
  done
  echo "svc: '$name' restarted but not confirmed up yet - check the pane / svc logs $name." >&2
  return 1
}

cmd_stop() {
  local name="${1:?svc stop <name>}" pid
  if pid="$(live_sup "$name")"; then
    echo "svc: stopping '$name' (TERM $pid)..."; kill -TERM "$pid"
  else
    echo "svc: '$name' not running."
  fi
}

# Suspend: cleanly drain the child (freeing its RAM) and leave the supervisor
# holding, ready to resume. Blocks until the supervisor confirms via the
# .suspended marker (bounded ~20s) so a heavy job can start KNOWING the RAM is
# freed; on timeout we fail loud rather than run beside a still-draining JVM.
# NOTE: only supervisors started from the suspend-aware `supervise` handle USR1;
# an older one would be KILLED by it. Fully restart services after upgrading.
cmd_suspend() {
  local name="${1:?svc suspend <name>}" pid i
  if ! pid="$(live_sup "$name")"; then
    echo "svc: '$name' not running - nothing to suspend."   # caller skips it; never started here
    return 0
  fi
  if [ -e "$run_dir/$name.suspended" ]; then
    echo "svc: '$name' already suspended."; return 0
  fi
  echo "svc: suspending '$name' (pid $pid)..."
  send_req "$name" "$pid" suspend
  for i in $(seq 1 40); do   # ~20s; marker is written only after the child is reaped
    [ -e "$run_dir/$name.suspended" ] && { echo "svc: '$name' suspended (child stopped, RAM freed)."; return 0; }
    sleep 0.5
  done
  echo "svc: '$name' did NOT confirm suspend within ~20s (no .suspended marker)." >&2
  echo "svc: refusing to proceed - the supervisor may predate USR1 support (restart it)." >&2
  return 1
}

# Resume: respawn the held child. Fire-and-forget (the supervisor cold-boots it
# in your pane in the background). Only USR2 a supervisor we KNOW is suspended -
# USR2 to a non-suspended one would interrupt its wait for no reason.
cmd_resume() {
  local name="${1:?svc resume <name>}" pid
  if [ ! -e "$run_dir/$name.suspended" ]; then
    echo "svc: '$name' not suspended - nothing to resume."; return 0
  fi
  if pid="$(live_sup "$name")"; then
    echo "svc: resuming '$name' (USR2 $pid)..."; kill -USR2 "$pid"
  else
    echo "svc: '$name' marked suspended but its supervisor is gone - clearing stale marker; start it: svc-tmux up $name." >&2
    rm -f "$run_dir/$name.suspended"
  fi
  return 0
}

sub="${1:-status}"; shift || true
case "$sub" in
  status)  if [ "${1:-}" = --short ]; then shift; cmd_status_short "$@"; else cmd_status "${1:-}"; fi ;;
  _ready)  cmd_ready "$@" ;;
  _live)   live_sup "${1:?svc _live <name>}" ;;
  logs)    cmd_logs "$@" ;;
  restart) cmd_restart "$@" ;;
  stop)    cmd_stop "$@" ;;
  suspend) cmd_suspend "$@" ;;
  resume)  cmd_resume "$@" ;;
  -h|--help|help) sed -n '2,29p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "usage: svc {status [name]|logs <name> [-n N]|restart <name>|stop <name>|suspend <name>|resume <name>}" >&2; exit 2 ;;
esac
