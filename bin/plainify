#!/usr/bin/env bash
# plainify — rewrite an assistant reply shorter and plainer, with Haiku.
#
#   plainify < reply.md
#   plainify --question "what the user asked" < reply.md
#   PLAINIFY_MODEL=sonnet plainify < reply.md
#
# The prompt is ai/templates/plainify.md: a word budget by kind of reply plus
# ASD-STE100 Simplified Technical English. Chosen on 2026-11-05 by comparing 13
# rewrite approaches on 7 real replies. Haiku is the default on purpose: on the
# same prompt it cut to ~48% of the words, Opus to ~62% and Sonnet to ~75%.
#
# Runs in a clean context through claude-p (timeout, .is_error check,
# --safe-mode), output extracted with llm-output. Exit codes are claude-p's
# (1 error, 124 timeout), or llm-output's (3-5) when the envelope is bad.
set -euo pipefail

here=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
export PATH="$here/bin:$PATH"  # claude-p, llm-output, even when called from a bare env
question=""
while [ $# -gt 0 ]; do
  case "$1" in
    -q|--question) question=$2; shift 2 ;;
    -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "plainify: unknown argument: $1" >&2; exit 2 ;;
  esac
done

reply=$(cat)
if [ -z "${reply//[[:space:]]/}" ]; then
  echo "plainify: no reply on stdin" >&2; exit 2
fi

sys="$(cat "$here/ai/templates/plainify.md")

$(llm-output --contract)"

input=""
[ -n "$question" ] && input="THE USER ASKED:
$question

"
input+="THE ASSISTANT REPLIED:
$reply"

raw=$(printf '%s' "$input" | CLAUDE_P_TIMEOUT="${CLAUDE_P_TIMEOUT:-90}" \
  claude-p --model "${PLAINIFY_MODEL:-haiku}" --tools='' --system-prompt "$sys")
printf '%s' "$raw" | llm-output
