#!/usr/bin/env bash
# Claude Code statusline script
# Reads JSON from stdin, outputs formatted status line
# Rate limits come from stdin (.rate_limits) when Claude Code sends them;
# otherwise from the OAuth usage API, cached in /tmp/claude-rate-limits.json
# (300s TTL, 300s backoff after a failure)

CACHE_FILE="/tmp/claude-rate-limits.json"
CACHE_TTL=300
BACKOFF_FILE="/tmp/claude-rate-limits.backoff"
BACKOFF_TTL=300

input=$(cat)

# --- CWD ---
cwd=$(echo "$input" | jq -r '.workspace.current_dir')
short_cwd="${cwd/#$HOME/~}"
IFS='/' read -ra PARTS <<< "$short_cwd"
[ ${#PARTS[@]} -gt 3 ] && short_cwd=".../${PARTS[-2]}/${PARTS[-1]}"

# --- Task prefix (alt) ---
task_prefix=""
command -v alt > /dev/null 2>&1 && task_prefix=$(alt statusline 2>/dev/null)

# --- Git info ---
git_info=""
if git -C "$cwd" rev-parse --git-dir > /dev/null 2>&1; then
  branch=$(git -C "$cwd" --no-optional-locks branch --show-current 2>/dev/null || echo "detached")
  staged=$(git -C "$cwd" --no-optional-locks diff --cached --numstat 2>/dev/null | wc -l | tr -d ' ')
  unstaged=$(git -C "$cwd" --no-optional-locks diff --numstat 2>/dev/null | wc -l | tr -d ' ')
  untracked=$(git -C "$cwd" --no-optional-locks ls-files --others --exclude-standard 2>/dev/null | wc -l | tr -d ' ')
  git_parts=""
  [ "$staged" -gt 0 ] && git_parts="${git_parts}+${staged} "
  [ "$unstaged" -gt 0 ] && git_parts="${git_parts}!${unstaged} "
  [ "$untracked" -gt 0 ] && git_parts="${git_parts}?${untracked} "
  [ -n "$git_parts" ] && git_info=" [git]: ${branch} ${git_parts}" || git_info=" [git]: ${branch}"
fi

# --- Colors ---
RST=$'\033[0m'
YEL=$'\033[33m'
RED=$'\033[31m'

colorize() {
  local val="${1%.*}" hi="$2" lo="$3"
  if [ "$val" -ge "$hi" ] 2>/dev/null; then echo "${RED}${1}%${RST}"
  elif [ "$val" -ge "$lo" ] 2>/dev/null; then echo "${YEL}${1}%${RST}"
  else echo "${1}%"
  fi
}

# --- Context window % ---
context_info=""
usage=$(echo "$input" | jq '.context_window.used_percentage // empty' 2>/dev/null)
if [ -n "$usage" ]; then
  context_info=$(colorize "$usage" 25 10)
fi

# --- Rate limits ---
# Both sources normalize to the same variables: five_h / seven_d (percent,
# empty = window unknown) and five_h_reset / seven_d_reset (epoch seconds,
# 0 = unknown). The formatting below is shared.
rate_info=""
five_h="" seven_d="" five_h_reset=0 seven_d_reset=0

# Live values from stdin. Absent on a session's first render, and either
# window can be absent on its own.
{ read -r five_h; read -r five_h_reset; read -r seven_d; read -r seven_d_reset; } < <(
  echo "$input" | jq -r '
    (.rate_limits.five_hour.used_percentage // ""),
    ((.rate_limits.five_hour.resets_at // 0) | floor),
    (.rate_limits.seven_day.used_percentage // ""),
    ((.rate_limits.seven_day.resets_at // 0) | floor)' 2>/dev/null)

# Fallback: cached API call, only when stdin carried neither window.
if [ -z "$five_h" ] && [ -z "$seven_d" ]; then
  refresh_cache=false

  if [ -f "$CACHE_FILE" ]; then
    cache_age=$(( $(date +%s) - $(stat -f %m "$CACHE_FILE" 2>/dev/null || echo 0) ))
    [ "$cache_age" -ge "$CACHE_TTL" ] && refresh_cache=true
  else
    refresh_cache=true
  fi

  if $refresh_cache; then
    # Skip if in backoff period from a previous failure
    if [ -f "$BACKOFF_FILE" ]; then
      backoff_age=$(( $(date +%s) - $(stat -f %m "$BACKOFF_FILE" 2>/dev/null || echo 0) ))
      [ "$backoff_age" -lt "$BACKOFF_TTL" ] && refresh_cache=false
    fi
  fi

  if $refresh_cache; then
    rm -f "$BACKOFF_FILE"
    token=$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null \
      | python3 -c "import sys,json; print(json.load(sys.stdin)['claudeAiOauth']['accessToken'])" 2>/dev/null)
    if [ -n "$token" ]; then
      result=$(curl -s --max-time 3 "https://api.anthropic.com/api/oauth/usage" \
        -H "Authorization: Bearer $token" \
        -H "anthropic-beta: oauth-2025-04-20" \
        -H "User-Agent: claude-code/2.1.74" 2>/dev/null)
      if echo "$result" | jq -e '.five_hour' > /dev/null 2>&1; then
        echo "$result" > "$CACHE_FILE"
      else
        touch "$BACKOFF_FILE"
      fi
    else
      touch "$BACKOFF_FILE"
    fi
  fi

  if [ -f "$CACHE_FILE" ]; then
    five_h=$(jq -r '.five_hour.utilization // empty' "$CACHE_FILE" 2>/dev/null)
    seven_d=$(jq -r '.seven_day.utilization // empty' "$CACHE_FILE" 2>/dev/null)
    if [ -n "$five_h" ] && [ -n "$seven_d" ]; then
      read -r five_h_reset seven_d_reset < <(jq -r '
        def epoch: if . then sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601 else 0 end;
        "\(.five_hour.resets_at | epoch) \(.seven_day.resets_at | epoch)"' "$CACHE_FILE" 2>/dev/null)
    else
      # The cache path shows nothing unless both windows are present.
      five_h="" seven_d=""
    fi
  fi
fi  # end cache fallback

# Percentages become integers by truncation, the same for both sources.
five_h="${five_h%.*}"
seven_d="${seven_d%.*}"

# Reset times: 5h as a countdown, 7d as weekday + hour (local time).
# Computed at render time from the absolute timestamp, so the cache TTL
# never makes them stale.
now=$(date +%s)
rate_parts=""
if [ -n "$five_h" ]; then
  five_h_when=""
  if [ "${five_h_reset:-0}" -gt "$now" ] 2>/dev/null; then
    # Minutes left, rounded up, so the countdown never undershoots.
    left=$(( (five_h_reset - now + 59) / 60 ))
    h=$(( left / 60 )); m=$(( left % 60 ))
    [ "$h" -gt 0 ] && five_h_when=" ↻${h}h${m}m" || five_h_when=" ↻${m}m"
  fi
  rate_parts="5h:$(colorize "$five_h" 50 20)${five_h_when}"
fi
if [ -n "$seven_d" ]; then
  seven_d_when=""
  seven_d_text="$(colorize "$seven_d" 50 20)"
  if [ "${seven_d_reset:-0}" -gt "$now" ] 2>/dev/null; then
    # Round up to the hour: resets land at :59:59, so 22:59 reads as 23,
    # and a reset is never shown earlier than it happens.
    seven_d_when=" ↻$(date -r $(( (seven_d_reset + 3599) / 3600 * 3600 )) '+%a@%Hh')"
    # Pace: points ahead of (+) or behind (−) a steady spend across the
    # week. Continuous — the share of the week elapsed, to the second, so
    # the steady line rises ~0.6 points an hour. No day boundaries.
    # Color follows the gap, not the raw percent: +10 yellow, +20 red.
    week=604800
    left_s=$(( seven_d_reset - now ))
    [ "$left_s" -gt "$week" ] && left_s=$week
    expected=$(( ( (week - left_s) * 100 + week / 2 ) / week ))
    gap=$(( seven_d - expected ))
    if [ "$gap" -gt 0 ]; then gap_s="+${gap}"
    elif [ "$gap" -lt 0 ]; then gap_s="−${gap#-}"
    else gap_s="±0"
    fi
    if [ "$gap" -ge 20 ]; then seven_d_text="${RED}${seven_d}% ${gap_s}${RST}"
    elif [ "$gap" -ge 10 ]; then seven_d_text="${YEL}${seven_d}% ${gap_s}${RST}"
    else seven_d_text="${seven_d}% ${gap_s}"
    fi
  fi
  rate_parts="${rate_parts:+$rate_parts }7d:${seven_d_text}${seven_d_when}"
fi
[ -n "$rate_parts" ] && rate_info=" (${rate_parts})"

# --- Model & Agent ---
model=$(echo "$input" | jq -r '.model.display_name // ""')
agent=$(echo "$input" | jq -r '.agent.name // ""')
model_info=""
[ -n "$model" ] && model_info=" [${model}]"
agent_info=""
[ -n "$agent" ] && agent_info=" (agent: ${agent})"

# --- Effort ---
effort=$(echo "$input" | jq -r '.effort.level // ""')
effort_info=""
[ -n "$effort" ] && effort_info="effort: ${effort}"

# --- Output ---
line1="${context_info}${rate_info}${model_info}${agent_info}"
line2="${task_prefix}${short_cwd}${git_info}"
if [ -n "$effort_info" ]; then
  printf "%s\n%s\n%s" "$line1" "$line2" "$effort_info"
else
  printf "%s\n%s" "$line1" "$line2"
fi
