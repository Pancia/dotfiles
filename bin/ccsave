#!/usr/bin/env bash
# Save current Claude Code session to ~/Cloud/cc-sessions/
# Usage: ccsave [title]
# Inside the vault it also writes a readable copy to claude-chats/ via akr-chat.
set -euo pipefail

if [ -z "${CLAUDE_SESSION_ID:-}" ]; then
    echo "Not inside a Claude Code session (no CLAUDE_SESSION_ID)" >&2
    exit 1
fi

id="$CLAUDE_SESSION_ID"
title="${*:-}"
timestamp=$(date '+%Y-%m-%d %H:%M')
# Key the save on the folder the session was launched from, as every other ccs
# site does (_cc_worktree_key: the parent repo for a worktree). The current
# folder drifts when Claude cds into a subfolder, and a save keyed on it lands
# where `ccs list` at the root never looks. The ccs entry holds that key when it
# belongs to this session.
key=""
if [ -n "${CCS_ENTRY_FILE:-}" ] && [ -f "$CCS_ENTRY_FILE" ] \
    && [ "$(jq -r '.session_id // empty' "$CCS_ENTRY_FILE" 2>/dev/null)" = "$id" ]; then
    key=$(jq -r '.cwd // empty' "$CCS_ENTRY_FILE" 2>/dev/null)
fi
[ -n "$key" ] || key=$(fish -c '_cc_worktree_key' 2>/dev/null || true)
[ -n "$key" ] || key=$(pwd)
dir="$HOME/Cloud/cc-sessions$key"
file="$dir/sessions.json"

mkdir -p "$dir"

# Build new entry
new_entry=$(jq -cn --arg id "$id" --arg ts "$timestamp" --arg title "$title" \
    '{id: $id, ts: $ts, title: $title}')

# Read existing array, remove dupe, append
if [ -f "$file" ]; then
    jq -c --arg id "$id" --argjson entry "$new_entry" \
        '[.[] | select(.id != $id)] + [$entry]' "$file" > "$file.tmp"
    mv "$file.tmp" "$file"
else
    printf '%s\n' "[$new_entry]" > "$file"
fi

# Back up session JSONL
# Find it by id in every project folder. Building the folder name with
# `tr '/' '-'` missed any path with a dot, which then got no backup.
jsonl=""
for f in "$HOME"/.claude/projects/*/"$id".jsonl; do
    if [ -f "$f" ]; then jsonl=$f; break; fi
done
if [ -n "$jsonl" ]; then
    backup_dir="$dir/session-backups"
    mkdir -p "$backup_dir"
    zstd -qf "$jsonl" -o "$backup_dir/$id.jsonl.zst"
fi

# Inside the vault, also file a readable transcript into claude-chats/ (akr-chat).
# A failure there must not undo the save above, hence the `|| echo`.
case "$(pwd | tr '[:upper:]' '[:lower:]')/" in
    */vaults/the-akashic-records/*)
        akr-chat --session "$id" ${title:+--title "$title"} \
            || echo "ccsave: transcript not filed (akr-chat failed); session still saved" >&2 ;;
esac

if [ -n "$title" ]; then
    echo "Saved session: $id ($timestamp — $title)"
else
    echo "Saved session: $id ($timestamp)"
    # Auto-generate title using fish ccs function
    fish -c "ccs autotitle --yes $id"
fi
