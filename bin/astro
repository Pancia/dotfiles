class TransitFormatter:
    """Formats transit data for display."""

    # Aspect symbols
    ASPECT_SYMBOLS = {
        'conjunction': '☌',
        'opposition': '☍',
        'trine': '△',
        'square': '□',
        'sextile': '⚹',
        'quincunx': '⚻',
        'semisextile': '⚺',
    }

    # Planet symbols (keys cover both kerykeion's raw names and short display names)
    PLANET_SYMBOLS = {
        'Sun': '☉',
        'Moon': '☽',
        'Mercury': '☿',
        'Venus': '♀',
        'Mars': '♂',
        'Jupiter': '♃',
        'Saturn': '♄',
        'Uranus': '♅',
        'Neptune': '♆',
        'Pluto': '♇',
        'Chiron': '⚷',
        'Ceres': '⚳',
        'Pallas': '⚴',
        'Juno': '⚵',
        'Vesta': '⚶',
        'North Node': '☊',
        'South Node': '☋',
        'Lilith': '⚸',
        # Aliases for kerykeion's raw names
        'True_North_Lunar_Node': '☊',
        'True_South_Lunar_Node': '☋',
        'Mean_Lilith': '⚸',
    }

    # kerykeion-name → short display name
    DISPLAY_NAMES = {
        'True_North_Lunar_Node': 'North Node',
        'True_South_Lunar_Node': 'South Node',
        'Mean_Lilith': 'Lilith',
    }

    @classmethod
    def _display_name(cls, name: str) -> str:
        return cls.DISPLAY_NAMES.get(name, name)

    # Sign symbols
    SIGN_SYMBOLS = {
        'Ari': '♈', 'Tau': '♉', 'Gem': '♊', 'Can': '♋',
        'Leo': '♌', 'Vir': '♍', 'Lib': '♎', 'Sco': '♏',
        'Sag': '♐', 'Cap': '♑', 'Aqu': '♒', 'Pis': '♓',
    }

    def _sign_str(self, sign: str, house: str) -> str:
        """Format sign and house as compact string."""
        s_sym = self.SIGN_SYMBOLS.get(sign, sign)
        if house:
            return f"{s_sym}{house}"
        return s_sym

    # Sentinel `aspect` values used by ingress/station events
    POSITION_EVENT_ASPECTS = {
        'sign_ingress', 'house_ingress',
        'station_retrograde', 'station_direct',
    }

    def _format_position_event(self, t: TransitEvent) -> str:
        """Render a sign-ingress, house-ingress, or station event line."""
        p_sym = self.PLANET_SYMBOLS.get(t.transit_planet, '')
        if t.aspect == 'sign_ingress':
            from_sym = self.SIGN_SYMBOLS.get(t.natal_sign, t.natal_sign)
            to_sym = self.SIGN_SYMBOLS.get(t.transit_sign, t.transit_sign)
            return (f"  {p_sym} {t.transit_planet:8s} enters "
                    f"{to_sym} {t.transit_sign}  (from {from_sym} {t.natal_sign})")
        if t.aspect == 'house_ingress':
            return (f"  {p_sym} {t.transit_planet:8s} enters House {t.transit_house}  "
                    f"(from House {t.natal_house})")
        if t.aspect in ('station_retrograde', 'station_direct'):
            label = 'RETROGRADE' if t.aspect == 'station_retrograde' else 'DIRECT'
            s_sym = self.SIGN_SYMBOLS.get(t.transit_sign, t.transit_sign)
            return (f"  {p_sym} {t.transit_planet:8s} stations {label} "
                    f"at {t.orb:.1f}° {s_sym} {t.transit_sign}")
        return ''

    def format_positions(self, positions: list[dict], show_house: bool = True) -> str:
        """Render a positions table for `now` / `sky`."""
        if not positions:
            return "  (no positions available)"
        lines = []
        for p in positions:
            sym = self.PLANET_SYMBOLS.get(p['planet'], '')
            sign_sym = self.SIGN_SYMBOLS.get(p['sign'], p['sign'])
            house_str = f"  House {p['house']:<2}" if (show_house and p['house']) else ""
            lines.append(
                f"  {sym} {p['planet']:<11} {sign_sym} {p['sign']:<3} "
                f"{p['degree']:6.2f}°{house_str}  spd {p['speed']:+.2f}"
            )
        return "\n".join(lines)

    def format_compact(self, transits: list[TransitEvent], limit: int = 15) -> str:
        """Compact format for current transits."""
        if not transits:
            return "No significant transits found."

        lines = []
        sorted_transits = sorted(transits, key=lambda x: abs(x.orb))[:limit]

        for t in sorted_transits:
            # Get symbols
            t_name = self._display_name(t.transit_planet)
            n_name = self._display_name(t.natal_planet)
            t_sym = self.PLANET_SYMBOLS.get(t_name, '')
            n_sym = self.PLANET_SYMBOLS.get(n_name, '')
            a_sym = self.ASPECT_SYMBOLS.get(t.aspect.lower(), '')

            orb_str = f"{t.orb:+.2f}°" if t.orb >= 0 else f"{t.orb:.2f}°"
            t_pos = self._sign_str(t.transit_sign, t.transit_house)
            n_pos = self._sign_str(t.natal_sign, t.natal_house)

            lines.append(
                f"  {t_sym} {t_name:11s} {t_pos:4s}  {a_sym} {t.aspect:10s}  "
                f"{n_sym} natal {n_name:11s} {n_pos:4s}  ({orb_str})"
            )

        return "\n".join(lines)

    def format_forecast(self, forecast: list[tuple[str, list[TransitEvent]]]) -> str:
        """Format forecast with dates and transits."""
        if not forecast:
            return "No exact transits in forecast period."

        lines = []
        for date_str, events in forecast:
            # Parse and format date
            date = datetime.fromisoformat(date_str)
            date_fmt = date.strftime("%a %b %d")

            lines.append(f"\n{date_fmt}:")

            # Render position events first (ingresses/stations), then aspects sorted by orb
            position_events = [e for e in events if e.aspect in self.POSITION_EVENT_ASPECTS]
            lunar_events = [e for e in events if e.transit_planet in ('New Moon', 'Full Moon')]
            aspect_events = [e for e in events
                             if e not in position_events and e not in lunar_events]

            for t in lunar_events:
                phase_sym = '🌑' if t.transit_planet == 'New Moon' else '🌕'
                s_sym = self.SIGN_SYMBOLS.get(t.transit_sign, t.transit_sign)
                lines.append(f"  {phase_sym} {t.transit_planet} in {s_sym} {t.transit_sign}")

            for t in position_events:
                lines.append(self._format_position_event(t))

            for t in sorted(aspect_events, key=lambda x: abs(x.orb)):
                t_name = self._display_name(t.transit_planet)
                n_name = self._display_name(t.natal_planet)
                t_sym = self.PLANET_SYMBOLS.get(t_name, '')
                n_sym = self.PLANET_SYMBOLS.get(n_name, '')
                a_sym = self.ASPECT_SYMBOLS.get(t.aspect.lower(), '')
                t_pos = self._sign_str(t.transit_sign, t.transit_house)
                n_pos = self._sign_str(t.natal_sign, t.natal_house)

                lines.append(
                    f"  {t_sym} {t_name:11s} {t_pos:4s} {a_sym} {t.aspect:10s} "
                    f"{n_sym} natal {n_name:11s} {n_pos:4s} ({t.orb:+.2f}°)"
                )

        return "\n".join(lines)

    def format_sustained(self, sustained: list['SustainedAspect'], orb_limit: float) -> str:
        """Render the Sustained Aspects section of `forecast` output."""
        if not sustained:
            return ""

        lines = [f"\nSustained Aspects (in-orb < {orb_limit:.1f}°):"]
        for s in sustained:
            t_name = self._display_name(s.transit_planet)
            n_name = self._display_name(s.natal_planet)
            t_sym = self.PLANET_SYMBOLS.get(t_name, '')
            n_sym = self.PLANET_SYMBOLS.get(n_name, '')
            a_sym = self.ASPECT_SYMBOLS.get(s.aspect.lower(), '')
            last = "ongoing" if s.ongoing else s.last_date
            lines.append(
                f"  {t_sym} {t_name:11s} {a_sym} {s.aspect:10s} "
                f"{n_sym} natal {n_name:11s}  "
                f"in-orb {s.first_date} → {last}  "
                f"(peak {s.peak_date}, {s.peak_orb:+.2f}°)"
            )
        return "\n".join(lines)

    def format_mundane(self, forecast: list[tuple[str, list[TransitEvent]]]) -> str:
        """Format mundane transits (transit-to-transit aspects) with dates."""
        if not forecast:
            return "No exact mundane transits in forecast period."

        lines = []
        for date_str, events in forecast:
            # Parse and format date
            date = datetime.fromisoformat(date_str)
            date_fmt = date.strftime("%a %b %d")

            lines.append(f"\n{date_fmt}:")

            position_events = [e for e in events if e.aspect in self.POSITION_EVENT_ASPECTS]
            lunar_events = [e for e in events if e.transit_planet in ('New Moon', 'Full Moon')]
            aspect_events = [e for e in events
                             if e not in position_events and e not in lunar_events]

            for t in lunar_events:
                phase_sym = '🌑' if t.transit_planet == 'New Moon' else '🌕'
                s_sym = self.SIGN_SYMBOLS.get(t.transit_sign, t.transit_sign)
                lines.append(f"  {phase_sym} {t.transit_planet} in {s_sym} {t.transit_sign}")

            for t in position_events:
                lines.append(self._format_position_event(t))

            for t in sorted(aspect_events, key=lambda x: abs(x.orb)):
                # For mundane transits, show Planet1 aspect Planet2
                p1_sym = self.PLANET_SYMBOLS.get(t.transit_planet, '')
                p2_sym = self.PLANET_SYMBOLS.get(t.natal_planet, '')  # Reusing field
                a_sym = self.ASPECT_SYMBOLS.get(t.aspect.lower(), '')

                # Get sign symbols (no houses for mundane)
                p1_sign_sym = self.SIGN_SYMBOLS.get(t.transit_sign, t.transit_sign)
                p2_sign_sym = self.SIGN_SYMBOLS.get(t.natal_sign, t.natal_sign)

                lines.append(
                    f"  {p1_sym} {t.transit_planet:8s} {p1_sign_sym:2s} {a_sym} {t.aspect:10s} "
                    f"{p2_sym} {t.natal_planet:8s} {p2_sign_sym:2s} ({t.orb:+.2f}°)"
                )

        return "\n".join(lines)

    def format_planet_summary(self, planet_name: str, events: list[PlanetTrackingEvent],
                             start_date: datetime, end_date: datetime,
                             natal_chart: NatalChart,
                             current_state: Optional[PlanetTrackingEvent] = None) -> str:
        """Format summary statistics for planet tracking.

        `current_state` is the planet's actual snapshot at the chosen "now"
        moment (typically end_date or today). When omitted, falls back to the
        most recent state-change event, which can be stale.
        """
        if not events and current_state is None:
            return f"No events found for {planet_name} in date range."

        # Group events by type
        sign_changes = [e for e in events if e.event_type == 'sign_change']
        house_changes = [e for e in events if e.event_type == 'house_change']
        stations_retro = [e for e in events if e.event_type == 'station_retrograde']
        stations_direct = [e for e in events if e.event_type == 'station_direct']
        aspects = [e for e in events if e.event_type == 'aspect']

        # Current vs starting position
        starting = events[0] if events else current_state
        current = current_state if current_state is not None else events[-1]

        # Format retrograde periods
        retro_periods = []
        for i, retro_station in enumerate(stations_retro):
            # Find corresponding direct station
            direct_station = None
            for d_station in stations_direct:
                if d_station.date > retro_station.date:
                    direct_station = d_station
                    break

            if direct_station:
                retro_periods.append(f"  {retro_station.date} to {direct_station.date}")
            else:
                retro_periods.append(f"  {retro_station.date} onwards (still retrograde)")

        retro_text = "\n".join(retro_periods) if retro_periods else "  None"

        # Count major aspects (extract base aspect type)
        def base_aspect(a):
            return a.aspect.split(' (')[0]

        major_aspects = [a for a in aspects if base_aspect(a) in ['conjunction', 'opposition', 'trine', 'square']]

        planet_sym = self.PLANET_SYMBOLS.get(planet_name.title(), planet_name)
        sign_sym = self.SIGN_SYMBOLS.get(starting.sign, starting.sign)
        curr_sign_sym = self.SIGN_SYMBOLS.get(current.sign, current.sign)

        return f"""
{planet_sym} {planet_name.upper()} Tracking
Period: {start_date.strftime('%Y-%m-%d')} to {end_date.strftime('%Y-%m-%d')} ({(end_date - start_date).days} days)
Chart: {natal_chart.birth_data.full_name}

Position:
  Starting: {sign_sym} {starting.sign} (house {starting.house})
  Current:  {curr_sign_sym} {current.sign} (house {current.house})

Activity Summary:
  Sign changes:        {len(sign_changes)}
  House transits:      {len(house_changes)}
  Retrograde stations: {len(stations_retro)}
  Direct stations:     {len(stations_direct)}
  Major aspects:       {len(major_aspects)} (conjunction/opposition/trine/square)
  All aspects:         {len(aspects)}

Retrograde Periods:
{retro_text}
"""

    def format_planet_timeline(self, events: list[PlanetTrackingEvent],
                              group_by: str = 'month') -> str:
        """Format detailed chronological timeline."""
        if not events:
            return ""

        lines = []

        if group_by == 'month':
            # Group by year-month
            from itertools import groupby

            for year_month, month_events in groupby(events, key=lambda e: e.date[:7]):
                # Parse year-month
                year, month = year_month.split('-')
                month_name = datetime(int(year), int(month), 1).strftime('%B')

                lines.append(f"\n{month_name} {year}:")

                for event in month_events:
                    lines.append(self._format_event(event))

        elif group_by == 'year':
            from itertools import groupby

            for year, year_events in groupby(events, key=lambda e: e.date[:4]):
                lines.append(f"\n{year}:")

                for event in year_events:
                    lines.append(self._format_event(event))

        elif group_by == 'type':
            from itertools import groupby

            # Sort by type then date
            sorted_events = sorted(events, key=lambda e: (e.event_type, e.date))

            for event_type, type_events in groupby(sorted_events, key=lambda e: e.event_type):
                lines.append(f"\n{event_type.replace('_', ' ').title()}:")

                for event in type_events:
                    lines.append(self._format_event(event))

        return "\n".join(lines)

    def _format_event(self, event: PlanetTrackingEvent) -> str:
        """Format a single planet tracking event."""
        date = datetime.fromisoformat(event.date).strftime('%m-%d')
        planet_sym = self.PLANET_SYMBOLS.get(event.planet.title(), event.planet)

        # Helper to convert absolute degree to sign-relative degree
        def deg_in_sign(abs_deg):
            return abs_deg % 30 if abs_deg else 0

        if event.event_type == 'sign_change':
            from_sym = self.SIGN_SYMBOLS.get(event.from_sign, event.from_sign)
            to_sym = self.SIGN_SYMBOLS.get(event.to_sign, event.to_sign)
            deg_info = f" at {deg_in_sign(event.degree):.1f}°" if event.degree else ""
            return f"  {date}: {planet_sym} enters {to_sym} {event.to_sign}{deg_info} (house {event.house})"

        elif event.event_type == 'house_change':
            sign_sym = self.SIGN_SYMBOLS.get(event.sign, event.sign)
            deg_info = f" at {deg_in_sign(event.degree):.1f}°" if event.degree else ""
            return f"  {date}: {planet_sym} enters house {event.to_house}{deg_info} (in {sign_sym} {event.sign})"

        elif event.event_type == 'station_retrograde':
            sign_sym = self.SIGN_SYMBOLS.get(event.sign, event.sign)
            return f"  {date}: {planet_sym} stations RETROGRADE at {deg_in_sign(event.degree):.1f}° {sign_sym} {event.sign}"

        elif event.event_type == 'station_direct':
            sign_sym = self.SIGN_SYMBOLS.get(event.sign, event.sign)
            return f"  {date}: {planet_sym} stations DIRECT at {deg_in_sign(event.degree):.1f}° {sign_sym} {event.sign}"

        elif event.event_type == 'aspect':
            natal_name = self._display_name(event.natal_planet)
            natal_sym = self.PLANET_SYMBOLS.get(natal_name, natal_name)

            # Extract base aspect type and transition marker
            aspect_parts = event.aspect.split(' (')
            base_aspect = aspect_parts[0]
            transition = f" ({aspect_parts[1]}" if len(aspect_parts) > 1 else ""

            aspect_sym = self.ASPECT_SYMBOLS.get(base_aspect.lower(), base_aspect)
            sign_sym = self.SIGN_SYMBOLS.get(event.sign, event.sign)
            deg_info = f" at {deg_in_sign(event.degree):.1f}°" if event.degree else ""

            return (f"  {date}: {planet_sym}{deg_info} {aspect_sym} {base_aspect}{transition} "
                    f"{natal_sym} natal {natal_name} ({event.orb:+.2f}°)")

        return f"  {date}: {event.event_type}"

    # ------------------------------------------------------------------
    # Relocation / synastry formatters
    # ------------------------------------------------------------------

    SIGN_FULL_TO_SHORT = {
        'Aries': 'Ari', 'Taurus': 'Tau', 'Gemini': 'Gem', 'Cancer': 'Can',
        'Leo': 'Leo', 'Virgo': 'Vir', 'Libra': 'Lib', 'Scorpio': 'Sco',
        'Sagittarius': 'Sag', 'Capricorn': 'Cap', 'Aquarius': 'Aqu', 'Pisces': 'Pis',
    }

    def _short_sign(self, sign: str) -> str:
        return self.SIGN_FULL_TO_SHORT.get(sign, sign[:3] if sign else '')

    def _fmt_lon(self, lon: float) -> str:
        """Format an absolute longitude as 'DD°MM' Sgn'."""
        sign_idx = int(lon // 30)
        signs = ['Ari','Tau','Gem','Can','Leo','Vir','Lib','Sco','Sag','Cap','Aqu','Pis']
        deg_in_sign = lon % 30
        d = int(deg_in_sign)
        m = int((deg_in_sign - d) * 60)
        s_sym = self.SIGN_SYMBOLS.get(signs[sign_idx], signs[sign_idx])
        return f"{d:>2}°{m:02d}' {s_sym} {signs[sign_idx]}"

    def format_relocated_chart(self, natal_chart_name: str,
                               natal_subject, relocated_subject,
                               diff_rows: list[dict],
                               lat: float, lng: float) -> str:
        """Render the relocated chart: angles + house diff table."""
        lines = []
        lines.append(f"Relocated chart: {natal_chart_name} → {lat:.4f}, {lng:.4f}")
        lines.append("=" * 70)
        lines.append("")

        # Natal angles (for comparison)
        lines.append("Natal angles:")
        for attr_name, code in [('first_house', 'ASC'), ('tenth_house', 'MC'),
                                 ('seventh_house', 'DC'), ('fourth_house', 'IC')]:
            if hasattr(natal_subject, attr_name):
                lon = getattr(natal_subject, attr_name).abs_pos
                lines.append(f"  {code}  {self._fmt_lon(lon)}")
        lines.append("")

        # Relocated angles (the headline)
        lines.append("Relocated angles:")
        for attr_name, code in [('first_house', 'ASC'), ('tenth_house', 'MC'),
                                 ('seventh_house', 'DC'), ('fourth_house', 'IC')]:
            if hasattr(relocated_subject, attr_name):
                lon = getattr(relocated_subject, attr_name).abs_pos
                lines.append(f"  {code}  {self._fmt_lon(lon)}")
        lines.append("")
        lines.append("(Whole-Sign houses: each house = a full sign starting at 0°. "
                     "ASC degree may sit mid-1st-house, not on its cusp.)")
        lines.append("")

        # House diff table
        lines.append(f"{'Planet':<12}{'Position':<22}{'Natal H':>9}{'Reloc H':>10}   ")
        lines.append("─" * 60)
        shifted_count = 0
        for row in diff_rows:
            mark = " ★" if row['shifted'] else "  "
            if row['shifted']:
                shifted_count += 1
            sign_sym = self.SIGN_SYMBOLS.get(row['sign'], row['sign'])
            psym = self.PLANET_SYMBOLS.get(row['planet'], '')
            pos_str = f"{row['degree_in_sign']:>5.2f}° {sign_sym} {row['sign']}"
            lines.append(
                f"{psym} {row['planet']:<10}{pos_str:<22}"
                f"{row['natal_house']:>9}{row['reloc_house']:>10}{mark}"
            )
        lines.append("─" * 60)
        lines.append(f"  {shifted_count} of {len(diff_rows)} planets shift houses in the relocation.")
        return "\n".join(lines)

    def format_transit_to_angles(self, hits: list[dict], days: int,
                                  start: datetime, lat: float, lng: float,
                                  orb: float) -> str:
        """Render transits-to-relocated-angles table."""
        lines = []
        end = start + timedelta(days=days)
        lines.append(f"Transits to relocated angles  ({lat:.4f}, {lng:.4f})")
        lines.append(f"  {start.date()} → {end.date()}  ({days} days, orb ≤ {orb}°)")
        lines.append("=" * 70)
        if not hits:
            lines.append("(no aspects to relocated angles within orb)")
            return "\n".join(lines)

        # Group by date for readability
        from itertools import groupby
        for date, group in groupby(hits, key=lambda r: r['date']):
            lines.append("")
            lines.append(f"{date}")
            for r in group:
                psym = self.PLANET_SYMBOLS.get(r['transit_planet'], '')
                ssym = self.SIGN_SYMBOLS.get(r['transit_sign'], r['transit_sign'])
                asym = self.ASPECT_SYMBOLS.get(r['aspect'], r['aspect'])
                lines.append(
                    f"  {psym} {r['transit_planet']:<8} "
                    f"{ssym} {r['transit_sign']:<3}  {asym} {r['aspect']:<11} "
                    f"reloc {r['angle']:<3}  ({r['orb']:+.2f}°)"
                )
        return "\n".join(lines)

    def format_synastry(self, result: dict, chart_a_name: str, chart_b_name: str) -> str:
        """Render synastry: planet aspects, angle contacts, house overlays."""
        lines = []
        lines.append(f"Synastry: {chart_a_name} ↔ {chart_b_name}")
        lines.append("=" * 70)

        # Planet aspects
        lines.append("")
        lines.append("Planet aspects (sorted by orb):")
        if not result.get('inter_aspects'):
            lines.append("  (none within standard orbs)")
        else:
            for asp in result['inter_aspects'][:30]:
                p1 = self.PLANET_SYMBOLS.get(asp['p1_name'], '')
                p2 = self.PLANET_SYMBOLS.get(asp['p2_name'], '')
                a = self.ASPECT_SYMBOLS.get(asp['aspect'], asp['aspect'])
                lines.append(
                    f"  {p1} {chart_a_name[:8]:<8} {asp['p1_name']:<10} "
                    f"{a} {asp['aspect']:<12} "
                    f"{p2} {chart_b_name[:8]:<8} {asp['p2_name']:<10} "
                    f"({asp['orbit']:+.2f}°)"
                )

        # Angle contacts (the strongest signals)
        lines.append("")
        lines.append("Angle contacts (planet ↔ angle, ≤2° orb — strongest signals):")
        if not result.get('angle_contacts'):
            lines.append("  (none within 2° orb)")
        else:
            for c in result['angle_contacts']:
                psym = self.PLANET_SYMBOLS.get(c['planet'], '')
                a = self.ASPECT_SYMBOLS.get(c['aspect'], c['aspect'])
                lines.append(
                    f"  {c['side']:<10} {psym} {c['planet']:<10} "
                    f"{a} {c['aspect']:<12} "
                    f"{c['target_side']:<10} {c['angle']}  ({c['orb']:+.2f}°)"
                )

        # House overlays
        lines.append("")
        lines.append(f"{chart_b_name}'s planets in {chart_a_name}'s houses:")
        for pname, hnum in result.get('b_in_a_houses', {}).items():
            psym = self.PLANET_SYMBOLS.get(pname, '')
            lines.append(f"  {psym} {pname:<10} → House {hnum}")

        lines.append("")
        lines.append(f"{chart_a_name}'s planets in {chart_b_name}'s houses:")
        for pname, hnum in result.get('a_in_b_houses', {}).items():
            psym = self.PLANET_SYMBOLS.get(pname, '')
            lines.append(f"  {psym} {pname:<10} → House {hnum}")

        return "\n".join(lines)


# =============================================================================
# CLI
# =============================================================================

def parse_timeline_args(args) -> tuple[datetime, datetime]:
    """
    Parse timeline arguments into start_date, end_date.

    Priority:
    1. --from/--to (explicit dates)
    2. --past/--future (months from now)
    3. Default: 12 months past, 12 months future
    """
    now = datetime.now()

    # Explicit date range
    if hasattr(args, 'from_date') and args.from_date:
        start = datetime.strptime(args.from_date, "%Y-%m-%d")
    elif hasattr(args, 'past') and args.past:
        start = now - timedelta(days=args.past * 30)
    else:
        start = now - timedelta(days=365)  # Default: 12 months back

    if hasattr(args, 'to_date') and args.to_date:
        end = datetime.strptime(args.to_date, "%Y-%m-%d")
    elif hasattr(args, 'future') and args.future:
        end = now + timedelta(days=args.future * 30)
    else:
        end = now + timedelta(days=365)  # Default: 12 months forward

    return start, end


def main():
    parser = argparse.ArgumentParser(
        prog='astro',
        description='Astrological transit tracker',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  astro add-chart                # Add default natal chart
  astro add-chart partner        # Add chart named 'partner'
  astro now                      # Current transits (default chart)
  astro now partner              # Current transits for partner
  astro forecast --days 30       # 30-day forecast from today
  astro forecast --date 2025-06-01 --days 30  # Forecast from June 1st
  astro mundane --days 30        # Mundane transits (transit-to-transit)
  astro sky                      # Current sky positions (no natal chart)
  astro sky --date 2025-06-01    # Sky positions on a given date
  astro list-charts              # Show all saved charts
"""
    )

    subparsers = parser.add_subparsers(dest='command', help='Commands')

    # --- Chart management ---
    add_p = subparsers.add_parser('add-chart', help='Add natal chart interactively')
    add_p.add_argument('name', nargs='?', help='Chart name (default: "default")')

    subparsers.add_parser('list-charts', help='List all saved charts')

    show_p = subparsers.add_parser('show-chart', help='Show chart details')
    show_p.add_argument('name', nargs='?', help='Chart name (uses config default)')

    rm_p = subparsers.add_parser('remove-chart', help='Remove a chart')
    rm_p.add_argument('name', help='Chart name to remove')

    # --- Transit queries ---
    now_p = subparsers.add_parser('now', help='Show current transits')
    now_p.add_argument('chart', nargs='?', help='Chart name (uses config default)')

    fc_p = subparsers.add_parser('forecast', help='Forecast upcoming transits')
    fc_p.add_argument('chart', nargs='?', help='Chart name (uses config default)')
    fc_p.add_argument('--days', '-d', type=int, default=30, help='Days to forecast (default: 30)')
    fc_p.add_argument('--date', type=str, help='Start date (YYYY-MM-DD, default: today)')
    fc_p.add_argument('--all', '-a', action='store_true',
                      help='Include all objects on transit side (asteroids, transit nodes/Chiron/Lilith, angles). '
                           'Default forecast already includes natal nodes/Chiron/Lilith on the natal side.')
    fc_p.add_argument('--orb', '-o', type=float, default=0.5, help='Max orb in degrees (default: 0.5)')
    fc_p.add_argument('--sustained-orb', type=float, default=2.0,
                      help='Max orb for the Sustained Aspects section (default: 2.0; '
                           'set to 0 to disable the section)')

    # --- Mundane transits ---
    mundane_p = subparsers.add_parser('mundane', help='Mundane transits (transit-to-transit aspects)')
    mundane_p.add_argument('--days', '-d', type=int, default=30, help='Days to forecast (default: 30)')
    mundane_p.add_argument('--date', type=str, help='Start date (YYYY-MM-DD, default: today)')
    mundane_p.add_argument('--all', '-a', action='store_true', help='Include all planets (not just outer)')
    mundane_p.add_argument('--orb', '-o', type=float, default=1.0, help='Max orb in degrees (default: 1.0)')

    # --- Sky (current/arbitrary-moment positions, no natal chart) ---
    sky_p = subparsers.add_parser('sky', help='Show current sky positions (no natal chart)')
    sky_p.add_argument('--date', type=str, help='Date YYYY-MM-DD (default: now)')
    sky_p.add_argument('--time', type=str, help='Time HH:MM (default: 12:00 if --date given, else now)')

    # --- Planet tracking ---
    planet_p = subparsers.add_parser('planet', help='Track single planet over time',
                                     epilog='''
Examples:
  astro planet chiron                    # 12 months past + 12 months future (default)
  astro planet mercury --past 24 --future 12  # 24 months back, 12 forward
  astro planet venus --from 2023-01-01 --to 2025-12-31  # Explicit range
  astro planet mars --summary-only       # Just statistics, no timeline
  astro planet jupiter --no-aspects      # Ingresses and stations only
''')
    planet_p.add_argument('name', help='Planet name (mars, venus, chiron, etc.)')
    planet_p.add_argument('chart', nargs='?', help='Chart name (uses config default)')

    # Timeline options
    timeline_g = planet_p.add_argument_group('timeline options')
    timeline_g.add_argument('--past', type=int, help='Months in past')
    timeline_g.add_argument('--future', type=int, help='Months in future')
    timeline_g.add_argument('--from', dest='from_date', type=str,
                           help='Start date (YYYY-MM-DD)')
    timeline_g.add_argument('--to', dest='to_date', type=str,
                           help='End date (YYYY-MM-DD)')

    # Display options
    display_g = planet_p.add_argument_group('display options')
    display_g.add_argument('--no-aspects', action='store_true',
                          help='Exclude aspects (faster)')
    display_g.add_argument('--aspect-orb', type=float, default=1.0,
                          help='Max aspect orb in degrees (default: 1.0)')
    display_g.add_argument('--group-by', choices=['month', 'year', 'type'],
                          default='month', help='Timeline grouping')
    display_g.add_argument('--summary-only', action='store_true',
                          help='Show summary only, no timeline')

    # --- Natal ---
    natal_p = subparsers.add_parser('natal', help='Display natal chart positions')
    natal_p.add_argument('chart', nargs='?', help='Chart name (uses default)')
    natal_p.add_argument('--json', dest='json_output', action='store_true',
                         help='Output as JSON')

    # --- Secondary Progressions (immanuel) ---
    prog_p = subparsers.add_parser('progressions', help='Secondary progressions (immanuel)')
    prog_p.add_argument('chart', nargs='?', help='Chart name (uses default)')
    prog_p.add_argument('--date', type=str,
                        help='Progression target date YYYY-MM-DD (default: today)')
    prog_p.add_argument('--aspects', action='store_true',
                        help='Also show aspects from progressed → natal')
    prog_p.add_argument('--dignities', action='store_true',
                        help='Show natal dignity scores instead of progressions')
    prog_p.add_argument('--json', dest='json_output', action='store_true',
                        help='Output as JSON')

    # --- Zodiacal Releasing (stellium) ---
    zr_p = subparsers.add_parser('zr', help='Zodiacal Releasing (stellium)')
    zr_p.add_argument('chart', nargs='?', help='Chart name (uses default)')
    zr_p.add_argument('--lot', type=str, default='fortune',
                      help='Lot to release: fortune, spirit, eros, etc. (default: fortune)')
    zr_p.add_argument('--level', type=int, default=1, choices=[1, 2, 3, 4],
                      help='ZR level to list periods for (default: 1)')
    zr_p.add_argument('--max-level', type=int, default=4, choices=[1, 2, 3, 4],
                      help='Max nesting level to compute (default: 4)')
    zr_p.add_argument('--age', type=float,
                      help='Show ZR snapshot at this age instead of timeline')
    zr_p.add_argument('--lifespan', type=int, default=100,
                      help='Years to compute ZR periods over (default: 100)')
    zr_p.add_argument('--json', dest='json_output', action='store_true',
                      help='Output as JSON')

    # --- Relocate (subcommand group: chart, transits) ---
    reloc_p = subparsers.add_parser(
        'relocate',
        help='Relocated chart analysis (astrocartography)',
    )
    reloc_sub = reloc_p.add_subparsers(dest='relocate_cmd')

    def _add_loc_args(p):
        """Shared --location/--lat/--lng args for relocate subcommands."""
        p.add_argument('chart', nargs='?', help='Chart name (uses config default)')
        p.add_argument('--location', help='Location preset name (from `astro locations list`)')
        p.add_argument('--lat', type=float, help='Latitude (decimal degrees)')
        p.add_argument('--lng', type=float, help='Longitude (decimal degrees)')
        p.add_argument('--json', dest='json_output', action='store_true',
                       help='Output as JSON')

    rc = reloc_sub.add_parser('chart', help='Show relocated chart with house diff')
    _add_loc_args(rc)

    rt = reloc_sub.add_parser('transits',
                              help='Transits to relocated angles (ASC/MC/IC/DC)')
    _add_loc_args(rt)
    rt.add_argument('--days', type=int, default=730,
                    help='Days to forecast (default: 730 = 24 months)')
    rt.add_argument('--date', type=str, help='Start date YYYY-MM-DD (default: today)')
    rt.add_argument('--orb', type=float, default=1.0,
                    help='Aspect orb in degrees (default 1.0 — wider than natal '
                         'because exact angle transits are rare)')

    # --- Synastry (top-level, two charts) ---
    syn_p = subparsers.add_parser('synastry',
                                   help='Inter-chart aspects, angle contacts, house overlays')
    syn_p.add_argument('chart_a', help='First chart name')
    syn_p.add_argument('chart_b', help='Second chart name')
    syn_p.add_argument('--json', dest='json_output', action='store_true',
                       help='Output as JSON')

    # --- Locations (presets for relocation) ---
    loc_p = subparsers.add_parser('locations', help='Manage location presets for relocation')
    loc_sub = loc_p.add_subparsers(dest='loc_cmd')

    la = loc_sub.add_parser('add', help='Add or overwrite a location preset')
    la.add_argument('name', help='Preset name (e.g. "prague", "lisbon")')
    la.add_argument('--lat', type=float, required=True, help='Latitude (decimal degrees, north positive)')
    la.add_argument('--lng', type=float, required=True, help='Longitude (decimal degrees, east positive)')
    la.add_argument('--tz', required=True, help='IANA timezone name (e.g. "Europe/Prague"). Stored for completeness; NOT used in relocated chart math.')
    la.add_argument('--label', default='', help='Optional human-friendly label, e.g. "Prague, CZ"')

    loc_sub.add_parser('list', help='List all saved location presets')

    lr = loc_sub.add_parser('remove', help='Remove a location preset')
    lr.add_argument('name', help='Preset name to remove')

    # --- Utility ---
    subparsers.add_parser('clear-cache', help='Clear transit cache')
    subparsers.add_parser('config', help='Show configuration')

    args = parser.parse_args()

    # Initialize components
    storage = AstroStorage()
    config = storage.load_config()
    chart_mgr = ChartManager(storage)
    location_mgr = LocationManager(storage)
    transit_calc = TransitCalculator(storage)
    formatter = TransitFormatter()

    # Helper to get chart name with config default
    def get_chart_name(arg_value):
        return arg_value if arg_value else config.default_chart

    # --- Dispatch commands ---

    if args.command == 'add-chart':
        chart = chart_mgr.create_chart_interactive(args.name)
        print()
        print(f"Chart '{chart.name}' saved successfully.")

    elif args.command == 'list-charts':
        charts = storage.list_charts()
        if charts:
            config = storage.load_config()
            print("Saved charts:")
            for name in charts:
                marker = " (default)" if name == config.default_chart else ""
                print(f"  - {name}{marker}")
        else:
            print("No charts found.")
            print("Run 'astro add-chart' to create one.")

    elif args.command == 'show-chart':
        try:
            chart = storage.load_chart(get_chart_name(args.name))
            bd = chart.birth_data
            print(f"Chart: {chart.name}")
            print(f"  Name:     {bd.full_name}")
            print(f"  Birth:    {bd.year}-{bd.month:02d}-{bd.day:02d} "
                  f"{bd.hour:02d}:{bd.minute:02d}")
            print(f"  Location: {bd.city}, {bd.nation}")
            print(f"  Created:  {chart.created_at[:10]}")
        except FileNotFoundError as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)

    elif args.command == 'remove-chart':
        if storage.delete_chart(args.name):
            print(f"Removed chart: {args.name}")
        else:
            print(f"Error: Chart '{args.name}' not found", file=sys.stderr)
            sys.exit(1)

    elif args.command == 'now':
        try:
            chart = storage.load_chart(get_chart_name(args.chart))
            now = datetime.now()
            print(f"Transits for {chart.birth_data.full_name}")
            print(f"({now.strftime('%Y-%m-%d %H:%M')})")
            print()

            # Build natal once for cusps + transit subject for current moment
            bd = chart.birth_data
            natal = transit_calc._make_subject(
                bd.full_name, bd.year, bd.month, bd.day, bd.hour, bd.minute, bd
            )
            transit_calc._cache_coords(chart, natal)
            natal_cusps = transit_calc._calculate_natal_houses(natal)
            transit_subj = transit_calc._make_subject(
                "Transit", now.year, now.month, now.day, now.hour, now.minute, bd
            )

            print("Positions:")
            positions = transit_calc.collect_planet_positions(
                transit_subj, natal_cusps=natal_cusps
            )
            print(formatter.format_positions(positions, show_house=True))
            print()

            print("Aspects:")
            transits = transit_calc.compute_current_transits(chart)
            print(formatter.format_compact(transits))
        except FileNotFoundError as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)

    elif args.command == 'forecast':
        try:
            chart = storage.load_chart(get_chart_name(args.chart))
            major_only = not args.all
            obj_desc = "all objects" if args.all else "major planets"

            # Parse start date if provided
            start_date = None
            if args.date:
                try:
                    start_date = datetime.strptime(args.date, "%Y-%m-%d")
                except ValueError:
                    print(f"Error: Invalid date format '{args.date}'. Use YYYY-MM-DD.", file=sys.stderr)
                    sys.exit(1)

            start_str = start_date.strftime("%Y-%m-%d") if start_date else "today"
            print(f"{args.days}-day forecast for {chart.birth_data.full_name}")
            print(f"(from {start_str}, orb < {args.orb}°, {obj_desc})")
            forecast = transit_calc.forecast_transits(
                chart, args.days, orb_limit=args.orb, major_only=major_only,
                start_date=start_date, include_moon_ingress=args.all
            )
            print(formatter.format_forecast(forecast))

            # Sustained aspects section (slow movers that hold within wider orb).
            if args.sustained_orb > 0:
                sustained = transit_calc.sustained_aspects(
                    chart, args.days, sustained_orb=args.sustained_orb,
                    start_date=start_date, major_only=major_only,
                )
                section = formatter.format_sustained(sustained, args.sustained_orb)
                if section:
                    print(section)
        except FileNotFoundError as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)

    elif args.command == 'mundane':
        major_only = not args.all
        obj_desc = "all planets" if args.all else "outer planets"

        # Parse start date if provided
        start_date = None
        if args.date:
            try:
                start_date = datetime.strptime(args.date, "%Y-%m-%d")
            except ValueError:
                print(f"Error: Invalid date format '{args.date}'. Use YYYY-MM-DD.", file=sys.stderr)
                sys.exit(1)

        start_str = start_date.strftime("%Y-%m-%d") if start_date else "today"
        print(f"{args.days}-day mundane transit forecast")
        print(f"(from {start_str}, orb < {args.orb}°, {obj_desc})")
        forecast = transit_calc.forecast_mundane_transits(
            args.days, orb_limit=args.orb, start_date=start_date,
            major_only=major_only, include_moon_ingress=args.all
        )
        print(formatter.format_mundane(forecast))

    elif args.command == 'sky':
        # Build the moment
        if args.date:
            try:
                d = datetime.strptime(args.date, "%Y-%m-%d")
            except ValueError:
                print(f"Error: Invalid date format '{args.date}'. Use YYYY-MM-DD.", file=sys.stderr)
                sys.exit(1)
            hour, minute = 12, 0
            if args.time:
                try:
                    t = datetime.strptime(args.time, "%H:%M")
                    hour, minute = t.hour, t.minute
                except ValueError:
                    print(f"Error: Invalid time format '{args.time}'. Use HH:MM.", file=sys.stderr)
                    sys.exit(1)
            moment = d.replace(hour=hour, minute=minute)
        else:
            moment = datetime.now()
            if args.time:
                try:
                    t = datetime.strptime(args.time, "%H:%M")
                    moment = moment.replace(hour=t.hour, minute=t.minute, second=0, microsecond=0)
                except ValueError:
                    print(f"Error: Invalid time format '{args.time}'. Use HH:MM.", file=sys.stderr)
                    sys.exit(1)

        subj = transit_calc._make_mundane_subject(moment, hour=moment.hour, minute=moment.minute)
        print(f"Sky positions: {moment.strftime('%Y-%m-%d %H:%M')}")
        print()
        positions = transit_calc.collect_planet_positions(subj, natal_cusps=None)
        print(formatter.format_positions(positions, show_house=False))

    elif args.command == 'planet':
        try:
            # Validate planet name
            valid_planets = {
                'sun', 'moon', 'mercury', 'venus', 'mars', 'jupiter', 'saturn',
                'uranus', 'neptune', 'pluto', 'chiron',
                'ceres', 'pallas', 'juno', 'vesta',  # Asteroids via Swiss Ephemeris
                'true_node', 'mean_lilith'
            }
            planet_name = args.name.lower()

            if planet_name not in valid_planets:
                print(f"Error: Unknown planet '{args.name}'", file=sys.stderr)
                print(f"Valid: {', '.join(sorted(valid_planets))}", file=sys.stderr)
                sys.exit(1)

            # Load chart
            chart = storage.load_chart(get_chart_name(args.chart))

            # Parse timeline
            start_date, end_date = parse_timeline_args(args)

            # Validate date range
            days = (end_date - start_date).days
            if days > 1095:  # 3 years
                print(f"Warning: {days} days is a large range. First run may be slow.",
                      file=sys.stderr)

            # Track planet
            print(f"Tracking {planet_name}...", file=sys.stderr)
            events = transit_calc.track_planet(
                chart,
                planet_name,
                start_date,
                end_date,
                include_aspects=not args.no_aspects,
                aspect_orb=args.aspect_orb
            )

            # Snapshot the planet's actual position at "now" (clamped to the
            # tracking window). Used for the "Current" line in the summary so
            # it doesn't reflect a stale event date.
            now = datetime.now()
            snapshot_at = now if start_date <= now <= end_date else end_date
            current_state = transit_calc.current_position(chart, planet_name, snapshot_at)

            # Display results
            print(formatter.format_planet_summary(
                planet_name, events, start_date, end_date, chart,
                current_state=current_state,
            ))

            if not args.summary_only:
                print("\nDetailed Timeline:")
                print("=" * 60)
                print(formatter.format_planet_timeline(events, group_by=args.group_by))

        except FileNotFoundError as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)
        except ValueError as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)

    elif args.command == 'natal':
        try:
            chart = storage.load_chart(get_chart_name(args.chart))
            bd = chart.birth_data
            natal = transit_calc._make_subject(
                bd.full_name, bd.year, bd.month, bd.day, bd.hour, bd.minute, bd
            )
            transit_calc._cache_coords(chart, natal)
            natal_cusps = transit_calc._calculate_natal_houses(natal)

            # Collect planet positions
            planet_names = [
                'Sun', 'Moon', 'Mercury', 'Venus', 'Mars', 'Jupiter', 'Saturn',
                'Uranus', 'Neptune', 'Pluto', 'Chiron', 'True_Node', 'Mean_Lilith',
            ]
            planets_data = {}
            for pname in planet_names:
                obj = transit_calc._get_planet_obj(natal, pname)
                if obj:
                    sign = getattr(obj, 'sign', '')
                    abs_pos = getattr(obj, 'abs_pos', 0.0)
                    speed = getattr(obj, 'speed', 0.0) if hasattr(obj, 'speed') else 0.0
                    house = transit_calc._planet_in_natal_house(abs_pos, natal_cusps)
                    degree = abs_pos % 30
                    display_name = pname.replace('_', ' ')
                    if display_name == 'True Node':
                        display_name = 'North Node'
                    elif display_name == 'Mean Lilith':
                        display_name = 'Lilith'
                    planets_data[display_name] = {
                        'sign': sign, 'house': house,
                        'degree': round(degree, 2), 'speed': round(speed, 2),
                    }

            # South Node = opposite of North Node
            if 'North Node' in planets_data:
                nn = planets_data['North Node']
                signs = ['Ari', 'Tau', 'Gem', 'Can', 'Leo', 'Vir',
                         'Lib', 'Sco', 'Sag', 'Cap', 'Aqu', 'Pis']
                nn_idx = signs.index(nn['sign']) if nn['sign'] in signs else 0
                sn_sign = signs[(nn_idx + 6) % 12]
                nn_obj = transit_calc._get_planet_obj(natal, 'True_Node')
                sn_abs = (getattr(nn_obj, 'abs_pos', 0.0) + 180) % 360
                sn_house = transit_calc._planet_in_natal_house(sn_abs, natal_cusps)
                planets_data['South Node'] = {
                    'sign': sn_sign, 'house': sn_house,
                    'degree': round(sn_abs % 30, 2), 'speed': 0.0,
                }

            # Collect house cusps
            signs_list = ['Ari', 'Tau', 'Gem', 'Can', 'Leo', 'Vir',
                          'Lib', 'Sco', 'Sag', 'Cap', 'Aqu', 'Pis']
            houses_data = {}
            for hnum, cusp_deg in sorted(natal_cusps.items()):
                sign = signs_list[int(cusp_deg / 30) % 12]
                houses_data[str(hnum)] = {
                    'sign': sign, 'degree': round(cusp_deg % 30, 2),
                }

            asc = houses_data.get('1', {})
            mc = houses_data.get('10', {})

            # Calculate natal aspects
            from kerykeion import NatalAspects
            natal_aspects_calc = NatalAspects(natal)
            aspects_data = []
            for asp in natal_aspects_calc.relevant_aspects:
                p1 = asp['p1_name'].replace('_', ' ')
                p2 = asp['p2_name'].replace('_', ' ')
                if p1 == 'True North Lunar Node':
                    p1 = 'North Node'
                if p2 == 'True North Lunar Node':
                    p2 = 'North Node'
                aspects_data.append({
                    'p1': p1, 'p2': p2,
                    'aspect': asp['aspect'], 'orb': round(asp['orbit'], 2),
                })

            if args.json_output:
                output = {
                    'planets': planets_data,
                    'houses': houses_data,
                    'ascendant': asc,
                    'midheaven': mc,
                    'aspects': aspects_data,
                }
                print(json.dumps(output, indent=2))
            else:
                print(f"Natal Chart: {chart.birth_data.full_name}")
                print(f"Born: {bd.year}-{bd.month:02d}-{bd.day:02d} "
                      f"{bd.hour:02d}:{bd.minute:02d} — {bd.city}, {bd.nation}")
                print()
                print("Planets:")
                for name, data in planets_data.items():
                    sym = formatter.SIGN_SYMBOLS.get(data['sign'], data['sign'])
                    print(f"  {name:<14} {sym} {data['sign']:<3} {data['degree']:6.2f}°  "
                          f"House {data['house']:<2}  spd {data['speed']:+.2f}")
                print()
                print("House Cusps:")
                for hnum in range(1, 13):
                    data = houses_data[str(hnum)]
                    sym = formatter.SIGN_SYMBOLS.get(data['sign'], data['sign'])
                    label = ""
                    if hnum == 1:
                        label = " (ASC)"
                    elif hnum == 10:
                        label = " (MC)"
                    print(f"  House {hnum:<3} {sym} {data['sign']:<3} {data['degree']:6.2f}°{label}")
                print()
                print("Natal Aspects:")
                for a in aspects_data:
                    p1_sym = formatter.PLANET_SYMBOLS.get(a['p1'], '')
                    p2_sym = formatter.PLANET_SYMBOLS.get(a['p2'], '')
                    asp_sym = formatter.ASPECT_SYMBOLS.get(a['aspect'], a['aspect'])
                    p1_label = f"{p1_sym} {a['p1']}" if p1_sym else a['p1']
                    p2_label = f"{p2_sym} {a['p2']}" if p2_sym else a['p2']
                    print(f"  {p1_label:<16} {asp_sym} {a['aspect']:<12} {p2_label:<16} orb {a['orb']:+.2f}°")

        except FileNotFoundError as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)

    elif args.command == 'progressions':
        try:
            chart = storage.load_chart(get_chart_name(args.chart))
            bd = chart.birth_data

            # Need cached coords for immanuel; geocode once via kerykeion if missing.
            if not (bd.lat and bd.lng):
                natal_subj = transit_calc._make_subject(
                    bd.full_name, bd.year, bd.month, bd.day, bd.hour, bd.minute, bd
                )
                transit_calc._cache_coords(chart, natal_subj)
                bd = chart.birth_data  # reload after caching

            prog_calc = ProgressionCalculator(storage)

            if args.dignities:
                dignities = prog_calc.natal_dignities(chart)
                if args.json_output:
                    print(json.dumps({'dignities': dignities}, indent=2))
                else:
                    print(f"Natal dignities: {bd.full_name}")
                    print()
                    for d in dignities:
                        score = d['score']
                        score_str = f"{score:+d}" if score is not None else "?"
                        sym = formatter.PLANET_SYMBOLS.get(d['name'], '')
                        prefix = f"{sym} " if sym else ""
                        print(f"  {prefix}{d['name']:14s} score={score_str:>4s}  {d['dignities']}")
            else:
                # Target date
                target_dt = datetime.now()
                if args.date:
                    try:
                        target_dt = datetime.strptime(args.date, "%Y-%m-%d")
                    except ValueError:
                        print(f"Error: Invalid date '{args.date}'. Use YYYY-MM-DD.",
                              file=sys.stderr)
                        sys.exit(1)

                planets, aspects = prog_calc.progressed_planets(
                    chart, target_dt, include_aspects=args.aspects
                )

                if args.json_output:
                    out = {
                        'chart': chart.name,
                        'target_date': target_dt.strftime("%Y-%m-%d"),
                        'method': 'NAIBOD',
                        'planets': [asdict(p) for p in planets],
                    }
                    if args.aspects:
                        out['aspects'] = [asdict(a) for a in aspects]
                    print(json.dumps(out, indent=2))
                else:
                    print(f"Secondary Progressions: {bd.full_name}")
                    print(f"Target: {target_dt.strftime('%Y-%m-%d')}  (NAIBOD MC method)")
                    print()
                    for p in planets:
                        sym = formatter.PLANET_SYMBOLS.get(p.name, '')
                        sign_sym = formatter.SIGN_SYMBOLS.get(p.sign, p.sign)
                        prefix = f"{sym} " if sym else ""
                        print(f"  {prefix}{p.name:14s} {sign_sym} {p.sign:<3} "
                              f"{p.degree_in_sign:6.2f}°  House {p.house:<2}  "
                              f"spd {p.speed:+.3f}")
                    if args.aspects and aspects:
                        print()
                        print("Progressed → Natal aspects:")
                        for a in aspects:
                            asp_sym = formatter.ASPECT_SYMBOLS.get(a.aspect, a.aspect)
                            p_sym = formatter.PLANET_SYMBOLS.get(a.progressed_planet, '')
                            n_sym = formatter.PLANET_SYMBOLS.get(a.natal_planet, '')
                            p_lbl = f"{p_sym} {a.progressed_planet}" if p_sym else a.progressed_planet
                            n_lbl = f"{n_sym} natal {a.natal_planet}" if n_sym else f"natal {a.natal_planet}"
                            print(f"  {p_lbl:18s} {asp_sym} {a.aspect:<12s} "
                                  f"{n_lbl:22s} ({a.orb:+.2f}°)")
        except FileNotFoundError as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)

    elif args.command == 'zr':
        try:
            chart = storage.load_chart(get_chart_name(args.chart))
            bd = chart.birth_data
            zr_calc = ZRCalculator(storage)
            lot_name = zr_calc._resolve_lot(args.lot)

            if args.age is not None:
                snap = zr_calc.snapshot_at_age(chart, args.lot, args.age,
                                               max_level=args.max_level)
                if args.json_output:
                    out = {
                        'chart': chart.name,
                        'lot': lot_name,
                        'age': args.age,
                        'date': snap.date,
                        'levels': {
                            f'l{i}': asdict(getattr(snap, f'l{i}'))
                            for i in (1, 2, 3, 4)
                            if getattr(snap, f'l{i}') is not None
                        },
                    }
                    print(json.dumps(out, indent=2))
                else:
                    print(f"Zodiacal Releasing: {bd.full_name}")
                    print(f"Lot: {lot_name}  •  Age: {args.age}  •  Date: {snap.date}")
                    print()
                    for level_num in (1, 2, 3, 4):
                        entry = getattr(snap, f'l{level_num}', None)
                        if entry is None:
                            continue
                        sign_abbr = _SIGN_FULL_TO_ABBR.get(entry.sign, entry.sign[:3])
                        sign_sym = formatter.SIGN_SYMBOLS.get(sign_abbr, sign_abbr)
                        ruler_sym = formatter.PLANET_SYMBOLS.get(entry.ruler, '')
                        ruler_lbl = f"{ruler_sym} {entry.ruler}" if ruler_sym else entry.ruler
                        peak = " ★PEAK" if entry.is_peak else ""
                        lb = " ↻LB" if entry.is_lb else ""
                        print(f"  L{level_num}: {sign_sym} {entry.sign:11s} "
                              f"ruled by {ruler_lbl:14s}  "
                              f"{entry.start} → {entry.end}  "
                              f"({entry.sentiment:11s} {entry.score:+d}){peak}{lb}")
            else:
                periods = zr_calc.timeline(chart, args.lot, level=args.level,
                                           max_level=args.max_level)
                if args.json_output:
                    out = {
                        'chart': chart.name,
                        'lot': lot_name,
                        'level': args.level,
                        'periods': [asdict(p) for p in periods],
                    }
                    print(json.dumps(out, indent=2))
                else:
                    print(f"Zodiacal Releasing: {bd.full_name}")
                    print(f"Lot: {lot_name}  •  Level: L{args.level}  "
                          f"•  Periods: {len(periods)}")
                    print()
                    today = datetime.now().date().isoformat()
                    for p in periods:
                        sign_abbr = _SIGN_FULL_TO_ABBR.get(p.sign, p.sign[:3])
                        sign_sym = formatter.SIGN_SYMBOLS.get(sign_abbr, sign_abbr)
                        ruler_sym = formatter.PLANET_SYMBOLS.get(p.ruler, '')
                        ruler_lbl = f"{ruler_sym} {p.ruler}" if ruler_sym else p.ruler
                        cur = " ←" if p.start <= today <= p.end else "  "
                        peak = " ★" if p.is_peak else ""
                        lb = " ↻LB" if p.is_lb else ""
                        print(f"  {sign_sym} {p.sign:12s} ruled by {ruler_lbl:14s}  "
                              f"{p.start} → {p.end}  "
                              f"({p.sentiment:11s} {p.score:+d}){peak}{lb}{cur}")
        except FileNotFoundError as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)

    elif args.command == 'relocate':
        if not args.relocate_cmd:
            parser.parse_args(['relocate', '--help'])
            return

        try:
            lat, lng = location_mgr.resolve(args)
        except (ValueError, FileNotFoundError) as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)

        chart_name = get_chart_name(args.chart)
        try:
            chart = storage.load_chart(chart_name)
        except FileNotFoundError as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)

        rcalc = RelocationCalculator(storage, transit_calc)

        if args.relocate_cmd == 'chart':
            bd = chart.birth_data
            natal = transit_calc._make_subject(
                bd.full_name, bd.year, bd.month, bd.day, bd.hour, bd.minute, bd
            )
            transit_calc._cache_coords(chart, natal)
            reloc = rcalc.relocate_subject(chart, lat, lng)
            diff_rows = rcalc.diff_houses(natal, reloc)

            if args.json_output:
                output = {
                    'chart': chart_name,
                    'lat': lat,
                    'lng': lng,
                    'natal_angles': {
                        code: getattr(natal, attr).abs_pos
                        for attr, code in [('first_house','ASC'),('tenth_house','MC'),
                                           ('seventh_house','DC'),('fourth_house','IC')]
                        if hasattr(natal, attr)
                    },
                    'relocated_angles': rcalc.angle_longitudes(reloc),
                    'planets': diff_rows,
                }
                print(json.dumps(output, indent=2))
            else:
                print(formatter.format_relocated_chart(
                    chart_name, natal, reloc, diff_rows, lat, lng
                ))

        elif args.relocate_cmd == 'transits':
            start = (datetime.strptime(args.date, "%Y-%m-%d")
                     if args.date else datetime.now())
            hits = rcalc.transits_to_reloc_angles(
                chart, lat, lng, args.days, start, orb=args.orb
            )
            if args.json_output:
                print(json.dumps({
                    'chart': chart_name, 'lat': lat, 'lng': lng,
                    'days': args.days, 'orb': args.orb,
                    'hits': hits,
                }, indent=2))
            else:
                print(formatter.format_transit_to_angles(
                    hits, args.days, start, lat, lng, args.orb
                ))

    elif args.command == 'synastry':
        try:
            chart_a = storage.load_chart(args.chart_a)
            chart_b = storage.load_chart(args.chart_b)
        except FileNotFoundError as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)
        result = SynastryCalculator(transit_calc).compute(chart_a, chart_b)
        if args.json_output:
            print(json.dumps({
                'chart_a': chart_a.name,
                'chart_b': chart_b.name,
                **result,
            }, indent=2))
        else:
            print(formatter.format_synastry(result, chart_a.name, chart_b.name))

    elif args.command == 'locations':
        if args.loc_cmd == 'add':
            loc = location_mgr.add(args.name, args.lat, args.lng, args.tz, args.label)
            label_str = f" ({loc.label})" if loc.label else ""
            print(f"Saved location '{loc.name}'{label_str}: "
                  f"{loc.lat:.4f}, {loc.lng:.4f} [{loc.tz_str}]")
        elif args.loc_cmd == 'list':
            names = storage.list_locations()
            if not names:
                print("No location presets saved.")
                print("Run 'astro locations add NAME --lat X --lng Y --tz TZ' to create one.")
            else:
                print("Saved locations:")
                for name in names:
                    loc = storage.load_location(name)
                    label_str = f"  ({loc.label})" if loc.label else ""
                    print(f"  - {loc.name:<16} {loc.lat:>9.4f}, {loc.lng:>10.4f}  "
                          f"[{loc.tz_str}]{label_str}")
        elif args.loc_cmd == 'remove':
            if storage.delete_location(args.name):
                print(f"Removed location: {args.name}")
            else:
                print(f"Error: Location '{args.name}' not found", file=sys.stderr)
                sys.exit(1)
        else:
            parser.parse_args(['locations', '--help'])

    elif args.command == 'clear-cache':
        count = storage.clear_cache()
        print(f"Cleared {count} cached transit files.")

    elif args.command == 'config':
        config = storage.load_config()
        print(f"Data directory: {storage.base_path}")
        print(f"Default chart:  {config.default_chart}")
        print(f"Display format: {config.display_format}")
        print(f"Orb settings:")
        for aspect, orb in config.orb_settings.items():
            print(f"  {aspect}: {orb}°")

    else:
        parser.print_help()


if __name__ == '__main__':
    main()
