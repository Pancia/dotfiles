#!/usr/bin/env -S uv run --with kerykeion --with pyswisseph python3
"""
Astrological Transit Tracker

CLI tool for tracking astrological transits against natal charts.
Uses kerykeion for calculations, stores data in ~/Cloud/astro/.

Usage:
    astro add-chart [NAME]       # Create natal chart interactively
    astro list-charts            # Show saved charts
    astro show-chart [NAME]      # Display chart details
    astro remove-chart NAME      # Delete a chart
    astro now [NAME]             # Current transits
    astro forecast [NAME] --days N   # N-day forecast from today
    astro forecast --date YYYY-MM-DD # Forecast from specific date
    astro mundane --days N       # Mundane transits (transit-to-transit)
    astro natal [NAME]           # Full birth chart (planets, houses, aspects)
    astro progressions [NAME]    # Secondary progressions (immanuel)
    astro zr [NAME] --lot LOT    # Zodiacal Releasing (stellium)

Run with: uv run --with kerykeion ~/dotfiles/bin/astro <command>
"""

import argparse
import json
import os
import sys
import swisseph as swe
from dataclasses import dataclass, asdict, field
from datetime import datetime, timedelta
from pathlib import Path
from typing import Optional

os.environ['KERYKEION_GEONAMES_CACHE_NAME'] = str(
    Path.home() / ".local" / "share" / "astro" / "geonames_cache"
)


# =============================================================================
# Data Models
# =============================================================================

@dataclass
class BirthData:
    """Birth data for a natal chart."""
    full_name: str
    year: int
    month: int
    day: int
    hour: int
    minute: int
    city: str
    nation: str
    lat: float = 0.0
    lng: float = 0.0
    tz_str: str = ""


@dataclass
class NatalChart:
    """A saved natal chart."""
    name: str
    birth_data: BirthData
    created_at: str
    notes: str = ""


@dataclass
class TransitEvent:
    """A single transit aspect."""
    transit_planet: str
    natal_planet: str
    aspect: str
    orb: float
    transit_sign: str = ""
    transit_house: str = ""
    natal_sign: str = ""
    natal_house: str = ""
    applying: bool = True
    exact_date: Optional[str] = None


@dataclass
class PlanetTrackingEvent:
    """Event for planet tracking over time."""
    date: str  # ISO format YYYY-MM-DD
    planet: str  # Planet name
    event_type: str  # 'sign_change', 'house_change', 'station_retrograde', 'station_direct', 'aspect'

    # Position (always present)
    sign: str
    house: str

    # Sign change fields
    from_sign: str = ""
    to_sign: str = ""

    # House change fields
    from_house: str = ""
    to_house: str = ""

    # Station fields
    degree: float = 0.0  # Exact degree of station
    speed: float = 0.0  # Daily motion in degrees/day

    # Aspect fields (reuse TransitEvent structure)
    natal_planet: str = ""
    aspect: str = ""  # conjunction, opposition, trine, square, sextile
    orb: float = 0.0
    natal_sign: str = ""
    natal_house: str = ""


@dataclass
class SustainedAspect:
    """An aspect that holds within a wider orb across a date range.

    Used by `forecast` to surface slow-moving aspects (Pluto-Venus, Neptune-NN)
    whose peak orb stays > 0.5° but which sit inside ~2° for weeks.
    """
    transit_planet: str
    natal_planet: str
    aspect: str
    first_date: str       # ISO YYYY-MM-DD: first day in the forecast window with |orb| <= sustained_orb
    last_date: str        # ISO YYYY-MM-DD: last day in this pass
    peak_date: str        # ISO YYYY-MM-DD: day with the smallest |orb|
    peak_orb: float       # signed orb on peak_date
    ongoing: bool = False  # True if the pass is still in-orb at the end of the window


@dataclass
class AsteroidObject:
    """Wrapper for Swiss Ephemeris asteroid calculations."""
    name: str
    abs_pos: float      # Ecliptic longitude (0-360°)
    sign: str           # Zodiac sign (Ari, Tau, etc.)
    speed: float        # Daily motion (degrees/day)
    house: str = ""     # Transit house (usually unused, calculated from natal cusps)

    _ephe_path_set = False  # Class variable to track if path is configured

    @staticmethod
    def from_swisseph(name: str, jd: float, body_num: int) -> 'AsteroidObject':
        """Calculate asteroid position using Swiss Ephemeris."""
        # Set ephemeris path on first use (kerykeion bundles the data files)
        if not AsteroidObject._ephe_path_set:
            try:
                import kerykeion
                from pathlib import Path
                kerykeion_path = Path(kerykeion.__file__).parent
                ephe_path = kerykeion_path / "sweph"
                if ephe_path.exists():
                    swe.set_ephe_path(str(ephe_path))
                AsteroidObject._ephe_path_set = True
            except Exception:
                pass  # Fall back to default path

        result, flags = swe.calc_ut(jd, body_num)

        longitude = result[0]  # Ecliptic longitude
        speed = result[3]      # Daily motion

        # Convert longitude to sign
        signs = ['Ari', 'Tau', 'Gem', 'Can', 'Leo', 'Vir',
                 'Lib', 'Sco', 'Sag', 'Cap', 'Aqu', 'Pis']
        sign_idx = int(longitude / 30)
        sign = signs[sign_idx]

        return AsteroidObject(
            name=name,
            abs_pos=longitude,
            sign=sign,
            speed=speed
        )


@dataclass
class ProgressedPlanet:
    """A single planet's secondary-progressed position."""
    name: str
    sign: str           # Short ('Ari', 'Tau', ...)
    sign_full: str      # Full ('Aries', 'Taurus', ...)
    house: int          # 1-12
    longitude: float    # 0-360
    degree_in_sign: float  # 0-30
    speed: float = 0.0


@dataclass
class ProgressedAspect:
    """An aspect between a progressed planet and a natal planet."""
    progressed_planet: str
    natal_planet: str
    aspect: str
    orb: float


@dataclass
class ZRPeriod:
    """A single Zodiacal Releasing period (any level L1-L4)."""
    level: int
    sign: str           # Full sign name as returned by stellium
    ruler: str
    start: str          # ISO date YYYY-MM-DD
    end: str            # ISO date YYYY-MM-DD
    score: int = 0
    sentiment: str = "neutral"
    is_peak: bool = False
    is_lb: bool = False  # loosing of the bond


@dataclass
class ZRSnapshot:
    """ZR levels active at a single moment."""
    age: float
    date: str
    l1: Optional[ZRPeriod] = None
    l2: Optional[ZRPeriod] = None
    l3: Optional[ZRPeriod] = None
    l4: Optional[ZRPeriod] = None


@dataclass
class Config:
    """User configuration."""
    default_chart: str = "default"
    geonames_username: str = "pancia"
    orb_settings: dict = field(default_factory=lambda: {
        "conjunction": 8,
        "opposition": 8,
        "trine": 6,
        "square": 6,
        "sextile": 4
    })
    display_format: str = "compact"


@dataclass
class Location:
    """A reusable geographic location preset (Prague, Lisbon, etc.).

    `tz_str` is stored for completeness but is NOT used during chart relocation —
    relocated charts must keep the natal chart's original tz_str so the UTC
    birth moment is unchanged. tz_str on Location is informational only.
    """
    name: str
    lat: float
    lng: float
    tz_str: str
    label: str = ""  # Optional human-friendly label, e.g. "Prague, CZ"


# =============================================================================
# Storage Layer
# =============================================================================

class AstroStorage:
    """Handles all file I/O operations."""

    def __init__(self, base_path: Optional[Path] = None):
        self.base_path = base_path or Path.home() / ".local" / "share" / "astro"
        self.charts_dir = self.base_path / "charts"
        self.transits_dir = self.base_path / "transits"
        self.ephemeris_dir = self.base_path / "ephemeris_cache"
        self.locations_dir = self.base_path / "locations"
        self.config_file = self.base_path / "config.json"
        self._ensure_dirs()

    def _ensure_dirs(self):
        """Create directory structure if missing."""
        self.charts_dir.mkdir(parents=True, exist_ok=True)
        self.transits_dir.mkdir(parents=True, exist_ok=True)
        self.ephemeris_dir.mkdir(parents=True, exist_ok=True)
        self.locations_dir.mkdir(parents=True, exist_ok=True)

    # --- Config ---

    def load_config(self) -> Config:
        """Load user configuration."""
        if self.config_file.exists():
            with open(self.config_file, 'r') as f:
                data = json.load(f)
                return Config(**data)
        return Config()

    def save_config(self, config: Config) -> None:
        """Save user configuration."""
        with open(self.config_file, 'w') as f:
            json.dump(asdict(config), f, indent=2)

    # --- Charts ---

    def save_chart(self, chart: NatalChart) -> None:
        """Save natal chart to JSON."""
        filepath = self.charts_dir / f"{chart.name}.json"
        with open(filepath, 'w') as f:
            json.dump(asdict(chart), f, indent=2)

    def load_chart(self, name: str) -> NatalChart:
        """Load natal chart from JSON."""
        filepath = self.charts_dir / f"{name}.json"
        if not filepath.exists():
            raise FileNotFoundError(f"Chart '{name}' not found. "
                                    f"Run 'astro add-chart {name}' to create it.")
        with open(filepath, 'r') as f:
            data = json.load(f)
        return NatalChart(
            name=data['name'],
            birth_data=BirthData(**data['birth_data']),
            created_at=data['created_at'],
            notes=data.get('notes', '')
        )

    def list_charts(self) -> list[str]:
        """Return list of chart names."""
        return sorted([f.stem for f in self.charts_dir.glob("*.json")])

    def delete_chart(self, name: str) -> bool:
        """Delete a chart. Returns True if deleted."""
        filepath = self.charts_dir / f"{name}.json"
        if filepath.exists():
            filepath.unlink()
            return True
        return False

    # --- Locations ---

    def save_location(self, location: Location) -> None:
        """Save location preset to JSON."""
        filepath = self.locations_dir / f"{location.name}.json"
        with open(filepath, 'w') as f:
            json.dump(asdict(location), f, indent=2)

    def load_location(self, name: str) -> Location:
        """Load location preset from JSON."""
        filepath = self.locations_dir / f"{name}.json"
        if not filepath.exists():
            raise FileNotFoundError(f"Location '{name}' not found. "
                                    f"Run 'astro locations add {name} ...' to create it.")
        with open(filepath, 'r') as f:
            data = json.load(f)
        return Location(**data)

    def list_locations(self) -> list[str]:
        """Return list of location preset names."""
        return sorted([f.stem for f in self.locations_dir.glob("*.json")])

    def delete_location(self, name: str) -> bool:
        """Delete a location preset. Returns True if deleted."""
        filepath = self.locations_dir / f"{name}.json"
        if filepath.exists():
            filepath.unlink()
            return True
        return False

    # --- Transit Cache ---

    def get_cached_transit(self, date: str, chart_name: str) -> Optional[dict]:
        """Retrieve cached transit data for a date."""
        year_month = date[:7]  # YYYY-MM
        filepath = self.transits_dir / year_month / f"{date}_{chart_name}.json"
        if filepath.exists():
            with open(filepath, 'r') as f:
                return json.load(f)
        return None

    def cache_transit(self, date: str, chart_name: str, aspects: list[TransitEvent]) -> None:
        """Cache transit data for a date."""
        year_month = date[:7]
        month_dir = self.transits_dir / year_month
        month_dir.mkdir(parents=True, exist_ok=True)

        filepath = month_dir / f"{date}_{chart_name}.json"
        data = {
            'date': date,
            'chart_name': chart_name,
            'computed_at': datetime.now().isoformat(),
            'aspects': [asdict(a) for a in aspects]
        }
        with open(filepath, 'w') as f:
            json.dump(data, f, indent=2)

    def clear_cache(self) -> int:
        """Clear all cached transits. Returns count of deleted files."""
        count = 0
        for month_dir in self.transits_dir.iterdir():
            if month_dir.is_dir():
                for cache_file in month_dir.glob("*.json"):
                    cache_file.unlink()
                    count += 1
                month_dir.rmdir()
        return count


# =============================================================================
# Chart Manager
# =============================================================================

class ChartManager:
    """Manages natal chart operations."""

    def __init__(self, storage: AstroStorage):
        self.storage = storage

    def create_chart_interactive(self, name: Optional[str] = None) -> NatalChart:
        """Interactive chart creation using input()."""
        print("Create New Natal Chart")
        print("=" * 40)
        print()

        if not name:
            name = input("Chart name (e.g., 'default', 'partner'): ").strip()
            if not name:
                name = "default"

        # Check if already exists
        existing = self.storage.list_charts()
        if name in existing:
            overwrite = input(f"Chart '{name}' exists. Overwrite? (y/N): ").strip().lower()
            if overwrite != 'y':
                print("Aborted.")
                sys.exit(0)

        print()
        full_name = input("Full name: ").strip()

        print()
        print("Birth date:")
        year = self._input_int("  Year (YYYY): ", 1900, 2100)
        month = self._input_int("  Month (1-12): ", 1, 12)
        day = self._input_int("  Day (1-31): ", 1, 31)

        print()
        print("Birth time (24-hour format):")
        hour = self._input_int("  Hour (0-23): ", 0, 23)
        minute = self._input_int("  Minute (0-59): ", 0, 59)

        print()
        print("Birth location:")
        city = input("  City: ").strip()
        nation = input("  Nation code (e.g., US, UK, DE): ").strip().upper()

        # Create birth data (kerykeion will geocode city)
        birth_data = BirthData(
            full_name=full_name,
            year=year,
            month=month,
            day=day,
            hour=hour,
            minute=minute,
            city=city,
            nation=nation
        )

        chart = NatalChart(
            name=name,
            birth_data=birth_data,
            created_at=datetime.now().isoformat()
        )

        self.storage.save_chart(chart)
        return chart

    def _input_int(self, prompt: str, min_val: int, max_val: int) -> int:
        """Get integer input with validation."""
        while True:
            try:
                val = int(input(prompt))
                if min_val <= val <= max_val:
                    return val
                print(f"  Please enter a value between {min_val} and {max_val}")
            except ValueError:
                print("  Please enter a valid number")


# =============================================================================
# Location Manager
# =============================================================================

class LocationManager:
    """Manages reusable location presets for relocation analysis."""

    def __init__(self, storage: AstroStorage):
        self.storage = storage

    def add(self, name: str, lat: float, lng: float, tz: str, label: str = "") -> Location:
        """Create or overwrite a location preset."""
        location = Location(name=name, lat=lat, lng=lng, tz_str=tz, label=label)
        self.storage.save_location(location)
        return location

    def resolve(self, args) -> tuple[float, float]:
        """Resolve geographic coordinates from CLI args.

        Precedence: --lat/--lng explicit pair > --location preset.
        Returns (lat, lng) only — destination tz is intentionally NOT
        returned because relocation must keep the natal chart's original
        tz_str (UTC moment unchanged); destination tz is irrelevant to the
        relocated chart math.
        """
        if args.lat is not None and args.lng is not None:
            return (args.lat, args.lng)
        if args.lat is not None or args.lng is not None:
            raise ValueError("--lat and --lng must be provided together")
        if not args.location:
            raise ValueError("Provide either --lat/--lng or --location PRESET. "
                             "List presets with `astro locations list`.")
        loc = self.storage.load_location(args.location)
        return (loc.lat, loc.lng)


# =============================================================================
# Transit Calculator
# =============================================================================

class TransitCalculator:
    """Computes transits using kerykeion."""

    def __init__(self, storage: AstroStorage):
        self.storage = storage
        self.config = storage.load_config()

    def _make_subject(self, name: str, year: int, month: int, day: int,
                      hour: int, minute: int, bd: BirthData) -> 'AstrologicalSubject':
        """Create AstrologicalSubject, using cached coords if available."""
        from kerykeion import AstrologicalSubject

        # Use cached coordinates if available
        if bd.lat and bd.lng and bd.tz_str:
            return AstrologicalSubject(
                name, year, month, day, hour, minute,
                bd.city, bd.nation,
                lat=bd.lat, lng=bd.lng, tz_str=bd.tz_str,
                houses_system_identifier="A"
            )
        else:
            return AstrologicalSubject(
                name, year, month, day, hour, minute,
                bd.city, bd.nation,
                houses_system_identifier="A",
                geonames_username=self.config.geonames_username
            )

    def _cache_coords(self, natal_chart: NatalChart, subject) -> None:
        """Save geocoded coordinates back to chart."""
        bd = natal_chart.birth_data
        if not bd.lat or not bd.lng:
            bd.lat = subject.lat
            bd.lng = subject.lng
            bd.tz_str = subject.tz_str
            self.storage.save_chart(natal_chart)

    def _calculate_natal_houses(self, natal_subject) -> dict[int, float]:
        """
        Extract natal house cusp positions.
        Returns dict mapping house number (1-12) to cusp degree (0-360).
        """
        house_attrs = [
            ('first_house', 1), ('second_house', 2), ('third_house', 3),
            ('fourth_house', 4), ('fifth_house', 5), ('sixth_house', 6),
            ('seventh_house', 7), ('eighth_house', 8), ('ninth_house', 9),
            ('tenth_house', 10), ('eleventh_house', 11), ('twelfth_house', 12),
        ]

        natal_cusps = {}
        for attr_name, house_num in house_attrs:
            if hasattr(natal_subject, attr_name):
                house_obj = getattr(natal_subject, attr_name)
                # Each house is a KerykeionPointModel with abs_pos attribute
                natal_cusps[house_num] = house_obj.abs_pos

        # Validate we got all 12 houses
        if len(natal_cusps) != 12:
            raise ValueError(f"Could not extract all 12 house cusps. Got {len(natal_cusps)} houses.")

        return natal_cusps

    def _planet_in_natal_house(self, planet_abs_pos: float, natal_cusps: dict[int, float]) -> str:
        """
        Determine which natal house a planet is in based on its ecliptic position.

        Args:
            planet_abs_pos: Planet's absolute position (0-360 degrees)
            natal_cusps: Dict of house number -> cusp degree

        Returns:
            House number as string (e.g., '1', '2', ... '12')
        """
        # Normalize position to 0-360
        pos = planet_abs_pos % 360

        # Sort houses by cusp position
        sorted_houses = sorted(natal_cusps.items(), key=lambda x: x[1])

        # Find which house the planet falls into
        # A planet is in house N if it's between cusp N and cusp N+1
        for i, (house_num, cusp_deg) in enumerate(sorted_houses):
            next_house_num, next_cusp_deg = sorted_houses[(i + 1) % 12]

            # Handle zodiac wraparound (12th house wraps to 1st house)
            if next_cusp_deg < cusp_deg:  # Wraparound case
                if pos >= cusp_deg or pos < next_cusp_deg:
                    return str(house_num)
            else:  # Normal case
                if cusp_deg <= pos < next_cusp_deg:
                    return str(house_num)

        # Fallback (shouldn't reach here)
        return '1'

    def compute_current_transits(self, natal_chart: NatalChart) -> list[TransitEvent]:
        """Compute transits for the current moment."""
        from kerykeion import SynastryAspects

        bd = natal_chart.birth_data

        # Create natal subject
        natal = self._make_subject(
            bd.full_name, bd.year, bd.month, bd.day, bd.hour, bd.minute, bd
        )
        self._cache_coords(natal_chart, natal)

        # Create transit subject for now
        now = datetime.now()
        transit = self._make_subject(
            "Transit", now.year, now.month, now.day, now.hour, now.minute, bd
        )

        # Calculate aspects using natal house cusps for transit planet houses
        natal_cusps = self._calculate_natal_houses(natal)
        aspects = SynastryAspects(transit, natal)
        return self._parse_aspects(aspects.relevant_aspects, transit, natal, natal_cusps)

    def compute_day_transits(self, natal_chart: NatalChart, date) -> list[TransitEvent]:
        """Compute transits for a specific date (at noon)."""
        from kerykeion import SynastryAspects

        bd = natal_chart.birth_data

        # Create natal subject
        natal = self._make_subject(
            bd.full_name, bd.year, bd.month, bd.day, bd.hour, bd.minute, bd
        )
        self._cache_coords(natal_chart, natal)

        # Create transit subject for the date at noon
        transit = self._make_subject(
            "Transit", date.year, date.month, date.day, 12, 0, bd
        )

        # Calculate aspects using natal house cusps for transit planet houses
        natal_cusps = self._calculate_natal_houses(natal)
        aspects = SynastryAspects(transit, natal)
        return self._parse_aspects(aspects.relevant_aspects, transit, natal, natal_cusps)

    # Major planets only (skip points, nodes, lilith, etc.)
    MAJOR_PLANETS = {'Sun', 'Moon', 'Mercury', 'Venus', 'Mars',
                     'Jupiter', 'Saturn', 'Uranus', 'Neptune', 'Pluto'}

    # Sensitive natal points that are worth showing as transit targets even
    # when major_only is on (transits TO these matter; transits FROM them
    # rarely do, so the transit-side filter still uses MAJOR_PLANETS).
    IMPORTANT_NATAL_POINTS = MAJOR_PLANETS | {
        'True_North_Lunar_Node', 'True_South_Lunar_Node',
        'Chiron', 'Mean_Lilith',
    }

    # Slow-moving transit planets — sustained section emits even short passes
    # from these (they're rarely in-orb, so each pass is noteworthy).
    SLOW_PLANETS = {'Jupiter', 'Saturn', 'Uranus', 'Neptune', 'Pluto'}

    # Swiss Ephemeris asteroid body numbers
    ASTEROIDS = {
        'ceres': 17,   # swe.CERES
        'pallas': 18,  # swe.PALLAS
        'juno': 19,    # swe.JUNO
        'vesta': 20,   # swe.VESTA
    }

    def get_lunar_phase(self, date, bd: BirthData) -> Optional[TransitEvent]:
        """Check if date has a new or full moon (orb < 2°)."""
        transit = self._make_subject("Transit", date.year, date.month, date.day, 12, 0, bd)

        sun_pos = transit.sun.abs_pos
        moon_pos = transit.moon.abs_pos

        # Calculate aspect
        diff = abs(sun_pos - moon_pos)
        if diff > 180:
            diff = 360 - diff

        # New Moon = conjunction (diff near 0)
        if diff < 2.0:
            return TransitEvent(
                transit_planet="New Moon",
                natal_planet="",
                aspect="conjunction",
                orb=diff,
                transit_sign=transit.moon.sign,
                transit_house="",
            )
        # Full Moon = opposition (diff near 180)
        elif abs(diff - 180) < 2.0:
            return TransitEvent(
                transit_planet="Full Moon",
                natal_planet="",
                aspect="opposition",
                orb=abs(diff - 180),
                transit_sign=transit.moon.sign,
                transit_house="",
            )
        return None

    def forecast_transits(self, natal_chart: NatalChart, days: int,
                          orb_limit: float = 0.5, major_only: bool = True,
                          start_date: Optional[datetime] = None,
                          include_moon_ingress: bool = False
                          ) -> list[tuple[str, list[TransitEvent]]]:
        """
        Forecast transits for N days starting from a date.
        Returns list of (date_str, events) tuples.

        Args:
            days: Number of days to forecast
            orb_limit: Max orb to include (default 0.5° for "exact" transits)
            major_only: Only show major planet transits (default True)
            start_date: Starting date (default: today)
            include_moon_ingress: If True, include Moon sign-ingress events (~2.5d cadence)
        """
        results = []
        today = start_date.date() if start_date else datetime.now().date()

        # Build natal once for cusps and previous-day subject
        bd = natal_chart.birth_data
        natal = self._make_subject(
            bd.full_name, bd.year, bd.month, bd.day, bd.hour, bd.minute, bd
        )
        self._cache_coords(natal_chart, natal)
        natal_cusps = self._calculate_natal_houses(natal)

        # Subject for the day before the window — needed to detect ingress on day 0
        prev_date = today - timedelta(days=1)
        prev_subj = self._make_subject(
            "Transit", prev_date.year, prev_date.month, prev_date.day, 12, 0, bd
        )

        for day_offset in range(days):
            date = today + timedelta(days=day_offset)
            date_str = date.isoformat()

            # Check cache first
            cached = self.storage.get_cached_transit(date_str, natal_chart.name)
            if cached:
                events = [TransitEvent(**e) for e in cached['aspects']]
            else:
                # Compute for this day
                events = self.compute_day_transits(natal_chart, date)
                self.storage.cache_transit(date_str, natal_chart.name, events)

            # Filter to highlights
            highlights = []
            for e in events:
                if abs(e.orb) > orb_limit:
                    continue
                if major_only:
                    if e.transit_planet not in self.MAJOR_PLANETS:
                        continue
                    if e.natal_planet not in self.IMPORTANT_NATAL_POINTS:
                        continue
                highlights.append(e)

            # Detect ingresses/stations vs. previous day
            curr_subj = self._make_subject(
                "Transit", date.year, date.month, date.day, 12, 0, bd
            )
            position_events = self._compute_position_events(
                prev_subj, curr_subj,
                natal_cusps=natal_cusps,
                include_moon=include_moon_ingress,
            )
            highlights.extend(position_events)
            prev_subj = curr_subj

            # Check for lunar phases
            lunar = self.get_lunar_phase(date, natal_chart.birth_data)
            if lunar:
                highlights.insert(0, lunar)

            if highlights:
                results.append((date_str, highlights))

        return results

    def sustained_aspects(self, natal_chart: NatalChart, days: int,
                          sustained_orb: float = 2.0,
                          start_date: Optional[datetime] = None,
                          major_only: bool = True
                          ) -> list[SustainedAspect]:
        """Find slow-moving aspects that hold within `sustained_orb` for a stretch.

        Scans every day in the forecast window, finds all aspects within the
        wider orb, then groups by (transit_planet, natal_planet, aspect) and
        splits each group into continuous passes (gap > 2 days = new pass).
        Each pass becomes one SustainedAspect entry.

        Reuses the per-day cache populated by `forecast_transits`.
        """
        today = start_date.date() if start_date else datetime.now().date()
        end = today + timedelta(days=days - 1)

        # day_str -> list[TransitEvent] (already-cached or freshly-computed)
        per_day: dict[str, list[TransitEvent]] = {}
        for day_offset in range(days):
            date = today + timedelta(days=day_offset)
            date_str = date.isoformat()
            cached = self.storage.get_cached_transit(date_str, natal_chart.name)
            if cached:
                events = [TransitEvent(**e) for e in cached['aspects']]
            else:
                events = self.compute_day_transits(natal_chart, date)
                self.storage.cache_transit(date_str, natal_chart.name, events)
            per_day[date_str] = events

        # Flatten into (date, event) pairs that pass the wider-orb + filters.
        flat: list[tuple[str, TransitEvent]] = []
        for date_str, events in per_day.items():
            for e in events:
                if abs(e.orb) > sustained_orb:
                    continue
                if major_only:
                    if e.transit_planet not in self.MAJOR_PLANETS:
                        continue
                    if e.natal_planet not in self.IMPORTANT_NATAL_POINTS:
                        continue
                flat.append((date_str, e))

        # Group by (transit_planet, natal_planet, aspect).
        from collections import defaultdict
        groups: dict[tuple, list[tuple[str, TransitEvent]]] = defaultdict(list)
        for date_str, e in flat:
            key = (e.transit_planet, e.natal_planet, e.aspect)
            groups[key].append((date_str, e))

        results: list[SustainedAspect] = []
        for key, items in groups.items():
            items.sort(key=lambda x: x[0])
            # Split into passes (gap > 2 days = new pass).
            passes: list[list[tuple[str, TransitEvent]]] = [[items[0]]]
            for i in range(1, len(items)):
                prev_d = datetime.fromisoformat(items[i-1][0]).date()
                curr_d = datetime.fromisoformat(items[i][0]).date()
                if (curr_d - prev_d).days <= 2:
                    passes[-1].append(items[i])
                else:
                    passes.append([items[i]])

            for p in passes:
                duration = len(p)
                # Section is meant to surface slow-moving aspects that the
                # per-day feed misses. Skip short passes from fast planets;
                # they're either in the per-day feed already or just brief
                # near-misses.
                t_planet = key[0]
                if duration < 5 and t_planet not in self.SLOW_PLANETS:
                    continue
                first_date = p[0][0]
                last_date = p[-1][0]
                peak = min(p, key=lambda x: abs(x[1].orb))
                peak_date = peak[0]
                peak_orb = peak[1].orb
                ongoing = datetime.fromisoformat(last_date).date() >= end
                results.append(SustainedAspect(
                    transit_planet=t_planet,
                    natal_planet=key[1],
                    aspect=key[2],
                    first_date=first_date,
                    last_date=last_date,
                    peak_date=peak_date,
                    peak_orb=peak_orb,
                    ongoing=ongoing,
                ))

        # Sort by duration descending so the longest-held aspects come first;
        # break ties by first_date.
        results.sort(key=lambda s: (
            -((datetime.fromisoformat(s.last_date).date()
               - datetime.fromisoformat(s.first_date).date()).days),
            s.first_date,
        ))
        return results

    def track_planet(self, natal_chart: NatalChart, planet_name: str,
                     start_date: datetime, end_date: datetime,
                     include_aspects: bool = True,
                     aspect_orb: float = 1.0) -> list[PlanetTrackingEvent]:
        """
        Track a single planet across a date range.

        Detects: sign changes, house changes, retrograde stations, aspects to natal planets.
        Samples daily at noon. For Moon, could add 6-hour sampling in future.

        Returns chronologically sorted list of events.
        """
        events = []
        bd = natal_chart.birth_data

        # Create natal subject once (for aspect calculations)
        natal = self._make_subject(
            bd.full_name, bd.year, bd.month, bd.day, bd.hour, bd.minute, bd
        )
        self._cache_coords(natal_chart, natal)

        # Calculate natal house cusps once
        natal_cusps = self._calculate_natal_houses(natal)

        # Iterate day by day
        current = start_date.date() if hasattr(start_date, 'date') else start_date
        end = end_date.date() if hasattr(end_date, 'date') else end_date
        prev_subject = None

        while current <= end:
            # Create transit subject at noon
            curr_subject = self._make_subject(
                "Transit", current.year, current.month, current.day, 12, 0, bd
            )

            if prev_subject:
                # Check for state transitions
                if event := self._detect_sign_change(planet_name, current, prev_subject, curr_subject, natal_cusps):
                    events.append(event)

                if event := self._detect_house_change(planet_name, current, prev_subject, curr_subject, natal_cusps):
                    events.append(event)

                if event := self._detect_station(planet_name, current, prev_subject, curr_subject, natal_cusps):
                    events.append(event)

            # Check for tight aspects to natal planets
            if include_aspects:
                aspect_events = self._get_planet_aspects(
                    planet_name, current, curr_subject, natal, aspect_orb, natal_cusps
                )
                events.extend(aspect_events)

            prev_subject = curr_subject
            current = current + timedelta(days=1)

        # Post-process aspects to show only entering/exact/leaving
        if include_aspects:
            events = self._filter_aspect_transitions(events)

        return sorted(events, key=lambda e: e.date)

    def current_position(self, natal_chart: NatalChart, planet_name: str,
                         at_date: Optional[datetime] = None) -> Optional[PlanetTrackingEvent]:
        """Snapshot a planet's actual position at `at_date` (defaults to today).

        Returned event uses event_type='current_position' and is populated with
        sign / natal house (via natal cusps) / degree / speed.
        """
        bd = natal_chart.birth_data
        natal = self._make_subject(
            bd.full_name, bd.year, bd.month, bd.day, bd.hour, bd.minute, bd
        )
        self._cache_coords(natal_chart, natal)
        natal_cusps = self._calculate_natal_houses(natal)

        if at_date is None:
            d = datetime.now().date()
        else:
            d = at_date.date() if hasattr(at_date, 'date') else at_date

        subj = self._make_subject(
            "Transit", d.year, d.month, d.day, 12, 0, bd
        )
        obj = self._get_planet_obj(subj, planet_name)
        if not obj:
            return None

        return PlanetTrackingEvent(
            date=d.isoformat(),
            planet=planet_name,
            event_type='current_position',
            sign=getattr(obj, 'sign', ''),
            house=self._planet_in_natal_house(getattr(obj, 'abs_pos', 0.0), natal_cusps),
            degree=getattr(obj, 'abs_pos', 0.0),
            speed=getattr(obj, 'speed', 0.0),
        )

    def _filter_aspect_transitions(self, events: list[PlanetTrackingEvent]) -> list[PlanetTrackingEvent]:
        """
        Filter aspect events to show only entering, exact, and leaving occurrences.
        Handles multiple passes (e.g., during retrograde).
        """
        from itertools import groupby

        # Separate aspect events from other events
        aspect_events = [e for e in events if e.event_type == 'aspect']
        other_events = [e for e in events if e.event_type != 'aspect']

        if not aspect_events:
            return events

        # Sort by date
        aspect_events.sort(key=lambda e: e.date)

        # Group by unique aspect (natal_planet + aspect type)
        def aspect_key(e):
            return (e.natal_planet, e.aspect)

        filtered_aspects = []

        for key, group in groupby(sorted(aspect_events, key=aspect_key), key=aspect_key):
            group_list = list(group)
            group_list.sort(key=lambda e: e.date)

            # Find continuous sequences (gaps > 2 days mean separate passes)
            sequences = []
            current_seq = [group_list[0]]

            for i in range(1, len(group_list)):
                curr_date = datetime.fromisoformat(group_list[i].date)
                prev_date = datetime.fromisoformat(group_list[i-1].date)

                if (curr_date - prev_date).days <= 2:
                    current_seq.append(group_list[i])
                else:
                    # New sequence (e.g., retrograde pass)
                    sequences.append(current_seq)
                    current_seq = [group_list[i]]

            sequences.append(current_seq)

            # For each sequence, keep entering, exact, and leaving
            for seq in sequences:
                if len(seq) == 1:
                    # Single day - mark as exact (use dataclass replace to create copy)
                    from dataclasses import replace
                    event = replace(seq[0], aspect=f"{seq[0].aspect} (exact)")
                    filtered_aspects.append(event)
                else:
                    from dataclasses import replace

                    # Find exact (minimum orb)
                    exact_event = min(seq, key=lambda e: abs(e.orb))

                    # Check if entering/exact/leaving are distinct events
                    entering_idx = 0
                    exact_idx = seq.index(exact_event)
                    leaving_idx = len(seq) - 1

                    # Only add distinct events
                    if entering_idx == exact_idx == leaving_idx:
                        # All same - just add as exact
                        filtered_aspects.append(replace(seq[0], aspect=f"{seq[0].aspect} (exact)"))
                    elif entering_idx == exact_idx:
                        # Entering and exact are same
                        filtered_aspects.append(replace(seq[entering_idx], aspect=f"{seq[entering_idx].aspect} (entering/exact)"))
                        filtered_aspects.append(replace(seq[leaving_idx], aspect=f"{seq[leaving_idx].aspect} (leaving)"))
                    elif exact_idx == leaving_idx:
                        # Exact and leaving are same
                        filtered_aspects.append(replace(seq[entering_idx], aspect=f"{seq[entering_idx].aspect} (entering)"))
                        filtered_aspects.append(replace(seq[exact_idx], aspect=f"{seq[exact_idx].aspect} (exact/leaving)"))
                    else:
                        # All distinct
                        filtered_aspects.append(replace(seq[entering_idx], aspect=f"{seq[entering_idx].aspect} (entering)"))
                        filtered_aspects.append(replace(seq[exact_idx], aspect=f"{seq[exact_idx].aspect} (exact)"))
                        filtered_aspects.append(replace(seq[leaving_idx], aspect=f"{seq[leaving_idx].aspect} (leaving)"))

        return other_events + filtered_aspects

    def _detect_sign_change(self, planet_name: str, date, prev_subj, curr_subj,
                            natal_cusps: dict[int, float]) -> Optional[PlanetTrackingEvent]:
        """Detect when planet changes signs."""
        prev_planet = self._get_planet_obj(prev_subj, planet_name)
        curr_planet = self._get_planet_obj(curr_subj, planet_name)

        if not prev_planet or not curr_planet:
            return None

        if prev_planet.sign != curr_planet.sign:
            house = self._planet_in_natal_house(curr_planet.abs_pos, natal_cusps)
            return PlanetTrackingEvent(
                date=date.isoformat(),
                planet=planet_name,
                event_type='sign_change',
                sign=curr_planet.sign,
                house=house,
                from_sign=prev_planet.sign,
                to_sign=curr_planet.sign,
                degree=curr_planet.abs_pos
            )
        return None

    def _detect_house_change(self, planet_name: str, date, prev_subj, curr_subj,
                             natal_cusps: dict[int, float]) -> Optional[PlanetTrackingEvent]:
        """Detect when planet changes natal houses."""
        prev_planet = self._get_planet_obj(prev_subj, planet_name)
        curr_planet = self._get_planet_obj(curr_subj, planet_name)

        if not prev_planet or not curr_planet:
            return None

        # Calculate house based on natal cusps, not transit subject's houses
        prev_house = self._planet_in_natal_house(prev_planet.abs_pos, natal_cusps)
        curr_house = self._planet_in_natal_house(curr_planet.abs_pos, natal_cusps)

        if prev_house != curr_house:
            return PlanetTrackingEvent(
                date=date.isoformat(),
                planet=planet_name,
                event_type='house_change',
                sign=curr_planet.sign,
                house=curr_house,
                from_house=prev_house,
                to_house=curr_house,
                degree=curr_planet.abs_pos
            )
        return None

    def _detect_station(self, planet_name: str, date, prev_subj, curr_subj,
                        natal_cusps: dict[int, float]) -> Optional[PlanetTrackingEvent]:
        """Detect retrograde/direct stations (when speed crosses zero)."""
        prev_planet = self._get_planet_obj(prev_subj, planet_name)
        curr_planet = self._get_planet_obj(curr_subj, planet_name)

        if not prev_planet or not curr_planet:
            return None

        prev_speed = getattr(prev_planet, 'speed', 0)
        curr_speed = getattr(curr_planet, 'speed', 0)

        # Check if speed changed sign (crossed zero)
        if prev_speed * curr_speed < 0:
            station_type = 'station_direct' if curr_speed > 0 else 'station_retrograde'
            house = self._planet_in_natal_house(curr_planet.abs_pos, natal_cusps)

            return PlanetTrackingEvent(
                date=date.isoformat(),
                planet=planet_name,
                event_type=station_type,
                sign=curr_planet.sign,
                house=house,
                degree=curr_planet.abs_pos,
                speed=curr_speed
            )
        return None

    # Planets scanned for position events (sign/house ingress, station)
    POSITION_EVENT_PLANETS = ['Sun', 'Mercury', 'Venus', 'Mars',
                              'Jupiter', 'Saturn', 'Uranus', 'Neptune', 'Pluto']

    def _compute_position_events(self, prev_subj, curr_subj,
                                 natal_cusps: Optional[dict[int, float]] = None,
                                 include_moon: bool = False) -> list[TransitEvent]:
        """Detect sign-ingress, house-ingress, and station events between two daily snapshots.

        Reuses TransitEvent with sentinel `aspect` values:
          - 'sign_ingress'   : transit_sign=new sign, natal_sign=previous sign
          - 'house_ingress'  : transit_house=new house, natal_house=previous house
          - 'station_retrograde' / 'station_direct': orb=degree-in-sign

        natal_cusps: required for house-ingress detection; pass None for mundane.
        include_moon: if False, omit Moon sign-ingresses (Moon ingresses every ~2.5 days).
        """
        planets = list(self.POSITION_EVENT_PLANETS)
        if include_moon:
            planets.insert(1, 'Moon')

        events = []
        for pname in planets:
            prev = self._get_planet_obj(prev_subj, pname)
            curr = self._get_planet_obj(curr_subj, pname)
            if not prev or not curr:
                continue

            # Sign ingress
            if prev.sign != curr.sign:
                events.append(TransitEvent(
                    transit_planet=pname,
                    natal_planet="",
                    aspect="sign_ingress",
                    orb=0.0,
                    transit_sign=curr.sign,
                    natal_sign=prev.sign,  # reused: from-sign
                ))

            # House ingress (only when a natal chart provides cusps)
            if natal_cusps:
                prev_house = self._planet_in_natal_house(prev.abs_pos, natal_cusps)
                curr_house = self._planet_in_natal_house(curr.abs_pos, natal_cusps)
                if prev_house != curr_house:
                    events.append(TransitEvent(
                        transit_planet=pname,
                        natal_planet="",
                        aspect="house_ingress",
                        orb=0.0,
                        transit_sign=curr.sign,
                        transit_house=curr_house,
                        natal_house=prev_house,  # reused: from-house
                    ))

            # Station (speed crosses zero)
            prev_speed = getattr(prev, 'speed', 0)
            curr_speed = getattr(curr, 'speed', 0)
            if prev_speed * curr_speed < 0:
                station_aspect = 'station_direct' if curr_speed > 0 else 'station_retrograde'
                events.append(TransitEvent(
                    transit_planet=pname,
                    natal_planet="",
                    aspect=station_aspect,
                    orb=curr.abs_pos % 30,  # reused: degree in sign
                    transit_sign=curr.sign,
                ))

        return events

    def collect_planet_positions(self, subject,
                                 natal_cusps: Optional[dict[int, float]] = None,
                                 include_extra: bool = True) -> list[dict]:
        """Collect current positions for all major planets on a subject.

        Returns a list of dicts: {planet, sign, degree, house, speed}.
        If natal_cusps is None, house is left blank (mundane context).
        """
        names = ['Sun', 'Moon', 'Mercury', 'Venus', 'Mars',
                 'Jupiter', 'Saturn', 'Uranus', 'Neptune', 'Pluto']
        if include_extra:
            names += ['Chiron', 'True_Node', 'Mean_Lilith']

        out = []
        for pname in names:
            obj = self._get_planet_obj(subject, pname)
            if not obj:
                continue
            sign = getattr(obj, 'sign', '')
            abs_pos = getattr(obj, 'abs_pos', 0.0)
            speed = getattr(obj, 'speed', 0.0) if hasattr(obj, 'speed') else 0.0
            house = self._planet_in_natal_house(abs_pos, natal_cusps) if natal_cusps else ''
            display = pname.replace('_', ' ')
            if display == 'True Node':
                display = 'North Node'
            elif display == 'Mean Lilith':
                display = 'Lilith'
            out.append({
                'planet': display,
                'sign': sign,
                'degree': abs_pos % 30,
                'house': house,
                'speed': speed,
            })
        return out

    def _get_planet_aspects(self, planet_name: str, date, transit_subj, natal_subj,
                           orb_limit: float, natal_cusps: dict[int, float]) -> list[PlanetTrackingEvent]:
        """Get tight aspects for a specific planet on a date."""
        # Skip aspects for asteroids (kerykeion's SynastryAspects doesn't include them)
        if planet_name.lower() in self.ASTEROIDS:
            return []

        from kerykeion import SynastryAspects

        aspects = SynastryAspects(transit_subj, natal_subj)
        events = []

        for asp in aspects.relevant_aspects:
            # Filter to only this planet's aspects (case-insensitive)
            if asp['p1_name'].lower() != planet_name.lower():
                continue

            # Filter to tight orbs only
            if abs(asp['orbit']) > orb_limit:
                continue

            # Filter natal side to important points (planets + nodes + Chiron + Lilith)
            if asp['p2_name'] not in self.IMPORTANT_NATAL_POINTS:
                continue

            # Get position data - calculate transit house using natal cusps
            t_planet = self._get_planet_obj(transit_subj, asp['p1_name'])
            t_sign = t_planet.sign if t_planet else ''
            t_house = self._planet_in_natal_house(t_planet.abs_pos, natal_cusps) if t_planet else ''
            t_degree = t_planet.abs_pos if t_planet else 0.0

            n_sign, n_house = self._get_planet_position(natal_subj, asp['p2_name'])

            events.append(PlanetTrackingEvent(
                date=date.isoformat(),
                planet=planet_name,
                event_type='aspect',
                sign=t_sign,
                house=t_house,
                natal_planet=asp['p2_name'],
                aspect=asp['aspect'],
                orb=asp['orbit'],
                natal_sign=n_sign,
                natal_house=n_house,
                degree=t_degree
            ))

        return events

    def _get_planet_obj(self, subject, planet_name: str):
        """Get planet object from subject by name."""
        # Try kerykeion first (existing planets)
        attr_map = {
            'sun': 'sun', 'moon': 'moon', 'mercury': 'mercury',
            'venus': 'venus', 'mars': 'mars', 'jupiter': 'jupiter',
            'saturn': 'saturn', 'uranus': 'uranus', 'neptune': 'neptune',
            'pluto': 'pluto', 'chiron': 'chiron',
            'true_node': 'true_north_lunar_node', 'mean_node': 'mean_node',
            'mean_lilith': 'mean_lilith', 'true_lilith': 'true_lilith',
        }
        attr = attr_map.get(planet_name.lower(), planet_name.lower())
        obj = getattr(subject, attr, None)

        if obj:
            return obj

        # Try asteroids via Swiss Ephemeris
        if planet_name.lower() in self.ASTEROIDS:
            body_num = self.ASTEROIDS[planet_name.lower()]
            return AsteroidObject.from_swisseph(
                planet_name,
                subject.julian_day,
                body_num
            )

        return None

    def _get_planet_position(self, subject, planet_name: str) -> tuple[str, str]:
        """Get (sign, house) for a planet. Extracted from _parse_aspects logic."""
        planet = self._get_planet_obj(subject, planet_name)
        if planet:
            sign = getattr(planet, 'sign', '')
            house = self._clean_house(getattr(planet, 'house', ''))
            return sign, house
        return '', ''

    def _clean_house(self, house: str) -> str:
        """Convert 'First_House' to '1'."""
        house_map = {
            'First_House': '1', 'Second_House': '2', 'Third_House': '3',
            'Fourth_House': '4', 'Fifth_House': '5', 'Sixth_House': '6',
            'Seventh_House': '7', 'Eighth_House': '8', 'Ninth_House': '9',
            'Tenth_House': '10', 'Eleventh_House': '11', 'Twelfth_House': '12',
        }
        return house_map.get(house, house)

    def compute_mundane_transits(self, date) -> list[TransitEvent]:
        """
        Compute mundane transits (transit-to-transit aspects) for a date.
        These are aspects between planets in the sky, without reference to a natal chart.
        """
        from kerykeion import AstrologicalSubject

        # Create a subject for the date at noon UTC
        # Use arbitrary location since we only care about ecliptic positions
        subject = AstrologicalSubject(
            "Transit", date.year, date.month, date.day, 12, 0,
            "London", "GB",
            houses_system_identifier="A",
            geonames_username=self.config.geonames_username
        )

        # Get all major planets
        planets = []
        for planet_name in ['Sun', 'Moon', 'Mercury', 'Venus', 'Mars',
                           'Jupiter', 'Saturn', 'Uranus', 'Neptune', 'Pluto']:
            planet = self._get_planet_obj(subject, planet_name)
            if planet:
                planets.append((planet_name, planet))

        # Calculate aspects between all planet pairs
        aspects = []
        orb_settings = self.config.orb_settings

        for i, (name1, planet1) in enumerate(planets):
            for name2, planet2 in planets[i+1:]:
                # Calculate angular distance
                diff = abs(planet1.abs_pos - planet2.abs_pos)
                if diff > 180:
                    diff = 360 - diff

                # Check each aspect type
                for aspect_name, exact_angle in [
                    ('conjunction', 0),
                    ('opposition', 180),
                    ('trine', 120),
                    ('square', 90),
                    ('sextile', 60)
                ]:
                    orb_limit = orb_settings.get(aspect_name, 6)
                    aspect_diff = abs(diff - exact_angle)

                    # Handle conjunction wraparound
                    if aspect_name == 'conjunction':
                        aspect_diff = min(diff, 360 - diff)

                    if aspect_diff <= orb_limit:
                        # Calculate orb (positive = separating, negative = applying)
                        orb = diff - exact_angle
                        if aspect_name == 'conjunction':
                            orb = diff if diff < 180 else diff - 360

                        aspects.append(TransitEvent(
                            transit_planet=name1,
                            natal_planet=name2,  # Reusing field for second planet
                            aspect=aspect_name,
                            orb=orb,
                            transit_sign=planet1.sign,
                            transit_house='',
                            natal_sign=planet2.sign,
                            natal_house='',
                            applying=orb < 0
                        ))

        return aspects

    def _make_mundane_subject(self, date, hour: int = 12, minute: int = 0):
        """Build an AstrologicalSubject for mundane (no-natal) calculations.

        Uses London as a reference location since only ecliptic positions matter.
        """
        from kerykeion import AstrologicalSubject
        return AstrologicalSubject(
            "Transit", date.year, date.month, date.day, hour, minute,
            "London", "GB",
            houses_system_identifier="A",
            geonames_username=self.config.geonames_username
        )

    def forecast_mundane_transits(self, days: int, orb_limit: float = 1.0,
                                  start_date: Optional[datetime] = None,
                                  major_only: bool = True,
                                  include_moon_ingress: bool = False
                                  ) -> list[tuple[str, list[TransitEvent]]]:
        """
        Forecast mundane transits for N days.
        Returns list of (date_str, events) tuples.
        """
        results = []
        today = start_date.date() if start_date else datetime.now().date()

        # Subject for the day before the window — needed to detect ingress on day 0
        prev_date = today - timedelta(days=1)
        prev_subj = self._make_mundane_subject(prev_date)

        for day_offset in range(days):
            date = today + timedelta(days=day_offset)
            date_str = date.isoformat()

            # Compute mundane transits for this day
            events = self.compute_mundane_transits(date)

            # Filter to highlights
            highlights = []
            for e in events:
                if abs(e.orb) > orb_limit:
                    continue
                if major_only:
                    # At least one planet should be outer (Jupiter+)
                    outer_planets = {'Jupiter', 'Saturn', 'Uranus', 'Neptune', 'Pluto'}
                    if not (e.transit_planet in outer_planets or e.natal_planet in outer_planets):
                        continue
                highlights.append(e)

            # Detect ingresses/stations vs. previous day (no house events — no natal cusps)
            curr_subj = self._make_mundane_subject(date)
            position_events = self._compute_position_events(
                prev_subj, curr_subj,
                natal_cusps=None,
                include_moon=include_moon_ingress,
            )
            highlights.extend(position_events)
            prev_subj = curr_subj

            # Check for lunar phases
            lunar = self.get_lunar_phase(date, BirthData(
                full_name="", year=2000, month=1, day=1,
                hour=0, minute=0, city="London", nation="GB"
            ))
            if lunar:
                highlights.insert(0, lunar)

            if highlights:
                results.append((date_str, highlights))

        return results

    def _parse_aspects(self, raw_aspects: list, transit_subj, natal_subj,
                       natal_cusps: dict[int, float]) -> list[TransitEvent]:
        """Convert kerykeion aspects to TransitEvent objects.

        Transit planet houses are calculated against natal cusps (not transit chart houses).
        Natal planet houses use kerykeion's house attribute (already from natal chart).
        """
        events = []

        def get_transit_planet_data(name):
            """Get sign/house for a transit planet, using natal cusps for house."""
            planet = self._get_planet_obj(transit_subj, name)
            if planet:
                sign = getattr(planet, 'sign', '')
                house = self._planet_in_natal_house(planet.abs_pos, natal_cusps)
                return sign, house
            return '', ''

        def get_natal_planet_data(name):
            """Get sign/house for a natal planet."""
            return self._get_planet_position(natal_subj, name)

        for asp in raw_aspects:
            t_sign, t_house = get_transit_planet_data(asp['p1_name'])
            n_sign, n_house = get_natal_planet_data(asp['p2_name'])

            events.append(TransitEvent(
                transit_planet=asp['p1_name'],
                natal_planet=asp['p2_name'],
                aspect=asp['aspect'],
                orb=asp['orbit'],
                transit_sign=t_sign,
                transit_house=t_house,
                natal_sign=n_sign,
                natal_house=n_house,
                applying=True  # TODO: calculate applying/separating
            ))
        return events


# =============================================================================
# Relocation Calculator (astrocartography depth analysis)
# =============================================================================

# Aspect targets for angle hits (orb checked separately)
_ANGLE_ASPECTS = (
    ('conjunction', 0),
    ('sextile', 60),
    ('square', 90),
    ('trine', 120),
    ('opposition', 180),
)


def _angle_aspect_distance(planet_lon: float, angle_lon: float, max_orb: float = 1.0
                           ) -> Optional[tuple[str, float]]:
    """Return (aspect_name, orb) if planet aspects angle within max_orb, else None.

    Pure longitude math — usable for both transit-to-relocated-angle and synastry
    angle contacts.
    """
    diff = abs(((planet_lon - angle_lon + 180) % 360) - 180)
    for aspect_name, target in _ANGLE_ASPECTS:
        orb = abs(diff - target)
        if orb <= max_orb:
            return (aspect_name, orb)
    return None


class RelocationCalculator:
    """Builds relocated charts and computes transits to relocated angles.

    A 'relocated chart' uses the natal birth UTC moment (unchanged) but recomputes
    angles and house cusps for new geographic coordinates. This shifts which house
    each natal planet falls into, and produces new ASC/MC/IC/DC longitudes that
    transits can aspect.
    """

    # Natal subject angle attribute names → display short codes
    ANGLE_NAMES = (
        ('first_house',   'ASC'),
        ('tenth_house',   'MC'),
        ('seventh_house', 'DC'),
        ('fourth_house',  'IC'),
    )

    # Transit planets to track for angle aspects (no Moon — moves too fast for sustained signal)
    TRANSIT_PLANETS = ('Sun', 'Mercury', 'Venus', 'Mars',
                       'Jupiter', 'Saturn', 'Uranus', 'Neptune', 'Pluto')

    def __init__(self, storage: AstroStorage, transit_calc: 'TransitCalculator'):
        self.storage = storage
        self.tc = transit_calc

    def relocate_subject(self, natal_chart: NatalChart, lat: float, lng: float):
        """Build an AstrologicalSubject for the relocated chart.

        CRITICAL: keeps natal `tz_str` so the UTC moment is unchanged. Only lat/lng
        are overridden. If we passed the destination tz, kerykeion would
        misinterpret the local birth time as being in the new timezone — wrong
        UTC moment, wrong relocated angles.
        """
        from kerykeion import AstrologicalSubject
        bd = natal_chart.birth_data
        if not bd.tz_str:
            # tz_str is required — force a geocode of natal first to populate cache
            natal = self.tc._make_subject(
                bd.full_name, bd.year, bd.month, bd.day, bd.hour, bd.minute, bd
            )
            self.tc._cache_coords(natal_chart, natal)
            bd = natal_chart.birth_data
        return AstrologicalSubject(
            f"{bd.full_name}@reloc",
            bd.year, bd.month, bd.day, bd.hour, bd.minute,
            bd.city, bd.nation,
            lat=lat, lng=lng, tz_str=bd.tz_str,
            houses_system_identifier="A",
        )

    def angle_longitudes(self, relocated_subject) -> dict[str, float]:
        """Extract ASC/MC/DC/IC longitudes (0-360) from a relocated subject."""
        out = {}
        for attr_name, code in self.ANGLE_NAMES:
            if hasattr(relocated_subject, attr_name):
                out[code] = getattr(relocated_subject, attr_name).abs_pos
        return out

    def diff_houses(self, natal_subject, relocated_subject) -> list[dict]:
        """Compare planet house positions between natal and relocated charts.

        Returns list of dicts: {planet, longitude, sign, natal_house, reloc_house, shifted}.
        """
        natal_cusps = self.tc._calculate_natal_houses(natal_subject)
        reloc_cusps = self.tc._calculate_natal_houses(relocated_subject)

        # Planets to compare (kerykeion attribute names → display names)
        planets = [
            ('sun', 'Sun'), ('moon', 'Moon'), ('mercury', 'Mercury'),
            ('venus', 'Venus'), ('mars', 'Mars'), ('jupiter', 'Jupiter'),
            ('saturn', 'Saturn'), ('uranus', 'Uranus'),
            ('neptune', 'Neptune'), ('pluto', 'Pluto'),
            ('chiron', 'Chiron'),
            ('true_node', 'North Node'), ('true_south_node', 'South Node'),
            ('mean_lilith', 'Lilith'),
        ]

        rows = []
        for attr, display in planets:
            if not hasattr(natal_subject, attr):
                continue
            nplanet = getattr(natal_subject, attr)
            if nplanet is None:
                continue
            lon = nplanet.abs_pos
            sign = getattr(nplanet, 'sign', '')
            natal_house = self.tc._planet_in_natal_house(lon, natal_cusps)
            reloc_house = self.tc._planet_in_natal_house(lon, reloc_cusps)
            rows.append({
                'planet': display,
                'longitude': lon,
                'sign': sign,
                'degree_in_sign': lon % 30,
                'natal_house': natal_house,
                'reloc_house': reloc_house,
                'shifted': natal_house != reloc_house,
            })
        return rows

    def transits_to_reloc_angles(
        self, natal_chart: NatalChart, lat: float, lng: float,
        days: int, start_date: Optional[datetime] = None, orb: float = 1.0,
    ) -> list[dict]:
        """Compute transits aspecting the four relocated angles over a date window.

        Custom loop — does NOT reuse forecast_transits (which bakes the natal
        subject from chart.birth_data and would corrupt the cache key).

        Algorithm:
          1. Build relocated subject once → 4 angle longitudes.
          2. For each day in window: build a daily transit subject (noon UT for
             that date, geographic position irrelevant for planet longitudes).
          3. For each (transit planet, relocated angle) pair: longitude math → if
             within orb of any major aspect, record a hit.
          4. Sort by date.

        Returns list of {date, transit_planet, transit_sign, transit_lon,
                         angle, angle_lon, aspect, orb}.
        """
        bd = natal_chart.birth_data
        # Ensure tz cached
        if not bd.tz_str:
            natal = self.tc._make_subject(
                bd.full_name, bd.year, bd.month, bd.day, bd.hour, bd.minute, bd
            )
            self.tc._cache_coords(natal_chart, natal)
            bd = natal_chart.birth_data

        reloc = self.relocate_subject(natal_chart, lat, lng)
        angles = self.angle_longitudes(reloc)

        start = (start_date.date() if start_date else datetime.now().date())
        results = []

        for day_offset in range(days):
            date = start + timedelta(days=day_offset)
            # Build transit subject at noon for that date — uses natal's location
            # (transit planet ECLIPTIC longitudes are location-independent; angles
            # we care about are the RELOCATED angles, which are fixed).
            transit_subj = self.tc._make_subject(
                "Transit", date.year, date.month, date.day, 12, 0, bd
            )
            for planet_name in self.TRANSIT_PLANETS:
                pobj = self.tc._get_planet_obj(transit_subj, planet_name)
                if pobj is None:
                    continue
                planet_lon = pobj.abs_pos
                sign = getattr(pobj, 'sign', '')
                for angle_code, angle_lon in angles.items():
                    aspect = _angle_aspect_distance(planet_lon, angle_lon, max_orb=orb)
                    if aspect:
                        aspect_name, orb_value = aspect
                        results.append({
                            'date': date.isoformat(),
                            'transit_planet': planet_name,
                            'transit_sign': sign,
                            'transit_lon': planet_lon,
                            'angle': angle_code,
                            'angle_lon': angle_lon,
                            'aspect': aspect_name,
                            'orb': orb_value,
                        })
        results.sort(key=lambda r: (r['date'], r['orb']))
        return results


# =============================================================================
# Synastry Calculator (chart-to-chart relationship)
# =============================================================================

class SynastryCalculator:
    """Computes inter-aspects, angle contacts, and house overlays between two charts."""

    # Same planet list used for relocation diff
    PLANETS_FOR_OVERLAY = [
        ('sun', 'Sun'), ('moon', 'Moon'), ('mercury', 'Mercury'),
        ('venus', 'Venus'), ('mars', 'Mars'), ('jupiter', 'Jupiter'),
        ('saturn', 'Saturn'), ('uranus', 'Uranus'),
        ('neptune', 'Neptune'), ('pluto', 'Pluto'), ('chiron', 'Chiron'),
    ]

    ANGLE_NAMES = (
        ('first_house',   'ASC'),
        ('tenth_house',   'MC'),
        ('seventh_house', 'DC'),
        ('fourth_house',  'IC'),
    )

    def __init__(self, transit_calc: 'TransitCalculator'):
        self.tc = transit_calc

    def _angle_lons(self, subj) -> dict[str, float]:
        out = {}
        for attr, code in self.ANGLE_NAMES:
            if hasattr(subj, attr):
                out[code] = getattr(subj, attr).abs_pos
        return out

    def _house_overlay(self, src_subj, dst_cusps: dict[int, float]) -> dict[str, str]:
        """For each major planet in src_subj, return which dst_cusps house it falls in."""
        result = {}
        for attr, display in self.PLANETS_FOR_OVERLAY:
            if not hasattr(src_subj, attr):
                continue
            p = getattr(src_subj, attr)
            if p is None:
                continue
            result[display] = self.tc._planet_in_natal_house(p.abs_pos, dst_cusps)
        return result

    def _angle_contacts(self, src_subj, dst_angles: dict[str, float],
                        src_label: str, dst_label: str,
                        max_orb: float = 2.0) -> list[dict]:
        """Find aspects from src_subj's planets to dst_subj's angles within max_orb."""
        out = []
        for attr, display in self.PLANETS_FOR_OVERLAY:
            if not hasattr(src_subj, attr):
                continue
            p = getattr(src_subj, attr)
            if p is None:
                continue
            for angle_code, angle_lon in dst_angles.items():
                aspect = _angle_aspect_distance(p.abs_pos, angle_lon, max_orb=max_orb)
                if aspect:
                    aspect_name, orb = aspect
                    out.append({
                        'side': src_label,
                        'planet': display,
                        'aspect': aspect_name,
                        'target_side': dst_label,
                        'angle': angle_code,
                        'orb': orb,
                    })
        return out

    def compute(self, chart_a: NatalChart, chart_b: NatalChart) -> dict:
        """Compute full synastry between two saved charts."""
        from kerykeion import SynastryAspects

        bd_a, bd_b = chart_a.birth_data, chart_b.birth_data

        subj_a = self.tc._make_subject(
            bd_a.full_name, bd_a.year, bd_a.month, bd_a.day, bd_a.hour, bd_a.minute, bd_a
        )
        self.tc._cache_coords(chart_a, subj_a)
        subj_b = self.tc._make_subject(
            bd_b.full_name, bd_b.year, bd_b.month, bd_b.day, bd_b.hour, bd_b.minute, bd_b
        )
        self.tc._cache_coords(chart_b, subj_b)

        # Planet ↔ planet aspects via kerykeion
        synastry = SynastryAspects(subj_a, subj_b)
        raw = synastry.relevant_aspects
        inter_aspects = sorted(
            [{
                'p1_name': a.get('p1_name'),
                'p2_name': a.get('p2_name'),
                'aspect': a.get('aspect'),
                'orbit': a.get('orbit', 0.0),
            } for a in raw if a.get('p1_name') and a.get('p2_name')],
            key=lambda a: abs(a['orbit']),
        )

        # Angle contacts (manual longitude math — kerykeion may not expose angles)
        angles_a = self._angle_lons(subj_a)
        angles_b = self._angle_lons(subj_b)
        angle_contacts = []
        angle_contacts.extend(
            self._angle_contacts(subj_a, angles_b, chart_a.name, chart_b.name)
        )
        angle_contacts.extend(
            self._angle_contacts(subj_b, angles_a, chart_b.name, chart_a.name)
        )
        angle_contacts.sort(key=lambda c: c['orb'])

        # House overlays
        cusps_a = self.tc._calculate_natal_houses(subj_a)
        cusps_b = self.tc._calculate_natal_houses(subj_b)
        a_in_b_houses = self._house_overlay(subj_a, cusps_b)
        b_in_a_houses = self._house_overlay(subj_b, cusps_a)

        return {
            'inter_aspects': inter_aspects,
            'angle_contacts': angle_contacts,
            'a_in_b_houses': a_in_b_houses,
            'b_in_a_houses': b_in_a_houses,
        }


# =============================================================================
# Secondary Progressions (immanuel)
# =============================================================================

# Full sign name → 3-letter abbrev used elsewhere in this file
_SIGN_FULL_TO_ABBR = {
    'Aries': 'Ari', 'Taurus': 'Tau', 'Gemini': 'Gem', 'Cancer': 'Can',
    'Leo': 'Leo', 'Virgo': 'Vir', 'Libra': 'Lib', 'Scorpio': 'Sco',
    'Sagittarius': 'Sag', 'Capricorn': 'Cap', 'Aquarius': 'Aqu', 'Pisces': 'Pis',
}


def _run_helper(helper_name: str, payload: dict) -> dict:
    """Shell out to a sibling helper script, returning parsed JSON.

    Helpers live in the same directory as this script and run in their own
    uv envs (immanuel and stellium have conflicting timezonefinder pins).
    """
    import subprocess
    helper_path = Path(__file__).parent / helper_name
    if not helper_path.exists():
        raise FileNotFoundError(f"Helper not found: {helper_path}")
    proc = subprocess.run(
        [str(helper_path)],
        input=json.dumps(payload),
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        # Try to extract structured error from stdout, else raw stderr.
        try:
            err = json.loads(proc.stdout)
        except (json.JSONDecodeError, ValueError):
            err = {'error': proc.stderr or 'helper failed', 'traceback': ''}
        raise RuntimeError(
            f"{helper_name} failed: {err.get('error', '?')}\n{err.get('traceback', '')}"
        )
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError as e:
        raise RuntimeError(f"{helper_name} returned non-JSON: {proc.stdout[:200]!r}") from e


class ProgressionCalculator:
    """Computes secondary progressions and dignities via the immanuel helper."""

    HELPER = "astro-progressions-helper"

    def __init__(self, storage: 'AstroStorage'):
        self.storage = storage

    def _birth_payload(self, bd: BirthData) -> dict:
        return {
            'year': bd.year, 'month': bd.month, 'day': bd.day,
            'hour': bd.hour, 'minute': bd.minute,
            'lat': bd.lat, 'lng': bd.lng,
        }

    def progressed_planets(self, chart: NatalChart,
                           target_dt: datetime,
                           include_aspects: bool = False
                           ) -> tuple[list[ProgressedPlanet], list[ProgressedAspect]]:
        payload = {
            'command': 'progressed',
            'birth': self._birth_payload(chart.birth_data),
            'target': target_dt.strftime("%Y-%m-%d %H:%M"),
            'include_aspects': include_aspects,
        }
        resp = _run_helper(self.HELPER, payload)
        planets = [ProgressedPlanet(**p) for p in resp.get('planets', [])]
        aspects = [ProgressedAspect(**a) for a in resp.get('aspects', [])]
        return planets, aspects

    def natal_dignities(self, chart: NatalChart) -> list[dict]:
        payload = {
            'command': 'dignities',
            'birth': self._birth_payload(chart.birth_data),
        }
        resp = _run_helper(self.HELPER, payload)
        return resp.get('dignities', [])


# =============================================================================
# Zodiacal Releasing (stellium)
# =============================================================================

# Map user-friendly lot names → stellium's canonical lot names.
ZR_LOT_ALIASES = {
    'fortune': 'Part of Fortune',
    'spirit': 'Part of Spirit',
    'eros': 'Part of Eros',
    'necessity': 'Part of Necessity',
    'courage': 'Part of Courage',
    'victory': 'Part of Victory',
    'nemesis': 'Part of Nemesis',
}


class ZRCalculator:
    """Computes Zodiacal Releasing via the stellium helper."""

    HELPER = "astro-zr-helper"

    def __init__(self, storage: 'AstroStorage'):
        self.storage = storage

    def _resolve_lot(self, lot: str) -> str:
        return ZR_LOT_ALIASES.get(lot.lower(), lot)

    def _birth_payload(self, bd: BirthData) -> dict:
        return {
            'year': bd.year, 'month': bd.month, 'day': bd.day,
            'hour': bd.hour, 'minute': bd.minute,
            'city': bd.city, 'nation': bd.nation,
        }

    def timeline(self, chart: NatalChart, lot: str, level: int = 1,
                 max_level: int = 4, lifespan: int = 100) -> list[ZRPeriod]:
        payload = {
            'command': 'timeline',
            'birth': self._birth_payload(chart.birth_data),
            'lot': self._resolve_lot(lot),
            'level': level,
            'max_level': max_level,
            'lifespan': lifespan,
        }
        resp = _run_helper(self.HELPER, payload)
        return [ZRPeriod(**p) for p in resp.get('periods', [])]

    def snapshot_at_age(self, chart: NatalChart, lot: str,
                        age: float, max_level: int = 4) -> ZRSnapshot:
        payload = {
            'command': 'snapshot',
            'birth': self._birth_payload(chart.birth_data),
            'lot': self._resolve_lot(lot),
            'age': age,
            'max_level': max_level,
        }
        resp = _run_helper(self.HELPER, payload)

        bd = chart.birth_data
        birth = datetime(bd.year, bd.month, bd.day, bd.hour, bd.minute)
        target = birth + timedelta(days=age * 365.25)

        out = ZRSnapshot(age=age, date=target.date().isoformat())
        for level_num in (1, 2, 3, 4):
            data = resp.get('levels', {}).get(f'l{level_num}')
            if data is not None:
                setattr(out, f'l{level_num}', ZRPeriod(**data))
        return out


