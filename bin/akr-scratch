#!/usr/bin/env bash
#
# Open a new dated note in ~/AKR/hermes-notes and copy a "read <path>" line
# to the clipboard. Filenames are YYYY-MM-DD[-pN].txt.
#
#   akr-scratch            -> 2026-07-20.txt (then -p2, -p3, ...)
#   akr-scratch 7          -> 2026-07-20-p7.txt
#   akr-scratch night      -> 2026-07-20-night.txt
#   akr-scratch --paste    -> new note pre-filled with the clipboard
#   akr-scratch --no-edit  -> write the note + clipboard, skip opening nvim
#
set -euo pipefail

paste=0
edit=1
suffix=""
while (( $# )); do
    case "$1" in
        --paste)   paste=1 ;;
        --no-edit) edit=0 ;;
        *)         suffix="$1" ;;
    esac
    shift
done

dir="$HOME/AKR/hermes-notes"
ext=".txt"
mkdir -p "$dir"

# 2026-07-20 — matches the vault convention (inari-chats/, memories/, ...)
base="$(date +%F)"

if [[ -n "$suffix" ]]; then
    # numeric -> -pN, otherwise verbatim (-night)
    [[ "$suffix" =~ ^[0-9]+$ ]] && suffix="p$suffix"
    name="$base-$suffix$ext"
else
    name="$base$ext"
    n=2
    while [[ -e "$dir/$name" ]]; do
        name="$base-p$n$ext"
        n=$((n + 1))
    done
fi

# Read the clipboard BEFORE overwriting it with the read-command
if (( paste )); then
    clip="$(pbpaste)"
    if [[ -z "$clip" ]]; then
        # Non-text (e.g. image) or empty pasteboard: bail without creating the
        # note and without clobbering the clipboard
        osascript -e 'display notification "Clipboard is empty" with title "akr-scratch"'
        exit 1
    fi
    printf '%s\n' "$clip" > "$dir/$name"
else
    # Create it now — nvim won't until :w, so back-to-back runs would collide
    : > "$dir/$name"
fi

printf 'read ~/AKR/hermes-notes/%s' "$name" | pbcopy

if (( edit )); then
    exec nvim "$dir/$name"
fi

# Headless mode: no editor to confirm the write, so say so
osascript -e "display notification \"$name\" with title \"akr-scratch\"" >/dev/null 2>&1 || true
