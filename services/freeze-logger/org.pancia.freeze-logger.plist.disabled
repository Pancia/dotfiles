<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>org.pancia.freeze-logger</string>
        <key>ProgramArguments</key>
        <array>
            <string>/Users/anthony/dotfiles/services/freeze-logger/dotfiles-services-freeze-logger.sh</string>
        </array>
        <key>RunAtLoad</key>
        <true/>
        <key>KeepAlive</key>
        <true/>
        <key>StandardOutPath</key>
        <string>/Users/anthony/.log/services/freeze-logger.log</string>
        <key>StandardErrorPath</key>
        <string>/Users/anthony/.log/services/freeze-logger.log</string>
    </dict>
</plist>
