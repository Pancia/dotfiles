<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>org.pancia.media-sync</string>
        <key>ProgramArguments</key>
        <array>
            <string>/Users/anthony/dotfiles/services/media-sync/dotfiles-services-media-sync.sh</string>
        </array>
        <!-- Tuesday and Friday at 10:00. If the Mac is asleep then, launchd runs it on wake. -->
        <key>StartCalendarInterval</key>
        <array>
            <dict>
                <key>Weekday</key>
                <integer>2</integer>
                <key>Hour</key>
                <integer>10</integer>
                <key>Minute</key>
                <integer>0</integer>
            </dict>
            <dict>
                <key>Weekday</key>
                <integer>5</integer>
                <key>Hour</key>
                <integer>10</integer>
                <key>Minute</key>
                <integer>0</integer>
            </dict>
        </array>
        <key>StandardOutPath</key>
        <string>/Users/anthony/.log/services/media-sync.log</string>
        <key>StandardErrorPath</key>
        <string>/Users/anthony/.log/services/media-sync.log</string>
    </dict>
</plist>
