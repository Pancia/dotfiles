{
    "_note": [
        "Keys starting with _ are ignored by the parser, so this block is a comment.",
        "RESERVED ROOT KEYS — do not use, they are hardcoded in Hermes and silently win over anything here:",
        "  a  -> +apps mode      (HermesViewController.swift builtinRoot + keyDown)",
        "  w  -> +windows mode   (same)",
        "  :  -> search mode     (intercepted at every level, not just root)",
        "Also taken by the entries below: b d e f h i j k m p q r s t u v x y z = -",
        "Free at root: c g l n o, digits, and most punctuation.",
        "'x' is the +utils grab bag — one-off scripts land there rather than eating a root letter."
    ],
    "b": {
        "_desc": "+browser",
        "s": ["browser sync state", {"interactive": "nvim ~/Vaults/the-akashic-records/browser-sync/current.md"}],
        "o": ["tab-organize plan (prefill)", {"interactive": "fish -iC 'function __pre --on-event fish_prompt; commandline -r \"tab-organize plan \"; functions -e __pre; end'"}]
    },
    "d": {
        "_desc": "+dotfiles",
        "e": ["Edit dotfiles", {"shell": "cd ~/dotfiles && v"}]
    },
    "e": {
        "_desc": "+exo",
        "e": ["Fetch (home)", {"interactive": "exo fetch --home"}]
    },
    "i": ["inbox", {"interactive": "ai_inbox"}],
    "j": ["Emoji Picker", {"shell": "emoji-pick"}],
    "f": {
        "_desc": "+finder",
        "z": ["View spirituality", "finder-here \"$HOME/Cloud/_spirituality\""],
        "b": ["View MediaBoard", "finder-here $HOME/MediaBoard"],
        "d": ["View Dotfiles", "finder-here $HOME/dotfiles"],
        "h": ["View Home", "finder-here $HOME"],
        "i": ["View inbox", "finder-here $HOME/Cloud/_inbox/"],
        "m": ["View Media", "finder-here $HOME/Media"],
        "o": ["View Cloud (ProtonDrive)", "finder-here $HOME/Cloud"],
        "p": ["View Projects", "finder-here $HOME/projects"],
        "s": ["View Screenshots", "finder-here $HOME/Screenshots"],
        "t": ["View transcripts", "finder-here $HOME/transcripts"],
        "w": ["View Downloads", "finder-here $HOME/Downloads"],
        "y": ["View YTDL", "finder-here $HOME/Downloads/ytdl/"]
    },
    "r": {
        "_desc": "+AKR",
        "s": ["scratch note", "open-iterm-with ~/dotfiles/bin/akr-scratch"],
        "p": ["scratch note (paste clipboard)", "$HOME/dotfiles/bin/akr-scratch --paste --no-edit"]
    },
    "q": {
        "_desc": "+launch app",
        "b": ["Brave", "open -a 'Brave Browser'"],
        "c": ["Claude", "open -a Claude"],
        "d": ["Discord", "open -a Discord"],
        "g": ["Signal", "open -a Signal"],
        "k": ["kosmik", "open -a 'Kosmik'"],
        "l": ["Telegram", "open -a 'Telegram'"],
        "o": ["Opera", "open -na 'Opera'"],
        "p": ["Proton Password", "open -a 'Proton Pass'"],
        "s": ["Spotify", "open -a Spotify"],
        "t": ["iTerm", "open -a 'iTerm'"],
        "v": ["Brave Beta (TV_BOARD)", "open -a 'Brave Browser Beta'"],
        "x": ["Opera GX", "open -a 'Opera GX'"],
        "z": ["Zen Browser", "open -a 'Zen Browser'"],
        "w": {
            "_desc": "+new window",
            "b": ["Brave", "open -na 'Brave Browser'"],
            "o": ["Opera", "open -na 'Opera'"],
            "t": ["iTerm", "open -na 'iTerm'"],
            "x": ["Opera GX", "open -na 'Opera GX'"]
        }
    },
    "h": {
        "_desc": "+hermes",
        "r": ["Rebuild & Restart", "rebuild-hermes"],
        "c": ["HS Console", "hs -c 'hs.openConsole()'"],
        "e": ["Edit Config", {"shell": "nvim ~/dotfiles/rcs/hermes-commands.json"}],
        "s": ["Edit HS Seeds", {"shell": "nvim ~/dotfiles/lib/lua/seeds/"}]
    },
    "k": {
        "_desc": "+karabiner",
        "c": ["Toggle Caps: L/R Ctrl", "karabiner-caps toggle"],
        "e": ["Edit Config", {"shell": "nvim ~/dotfiles/rcs/karabiner.json"}],
        "v": ["Event Viewer", "open -a 'Karabiner-EventViewer'"],
        "k": ["Karabiner Elements", "open -a 'Karabiner-Elements'"]
    },
    "p": "generator:snippets",
    "s": "generator:services",
    "v": "generator:vpc",
    "y": {
        "_desc": "+ytdl",
        "i": ["ytdl interactive", {"interactive": "ytdl"}],
        "y": ["ytdl clipboard", {"interactive": "ytdl clipboard"}]
    },
    "u": {
        "_desc": "+audio tools",
        "l": ["Live Transcribe", "q live-transcribe"]
    },
    "m": {
        "_desc": "+music",
        "_stay": true,
        "c": ["Play or Pause", "cmus-remote --pause"],
        "e": ["Edit Track", {"shell": "cmedit"}],
        "y": ["Redownload from Youtube", "cmytdl"],
        "a": ["Open Track in Audacity", "cmaudacity"],
        "s": ["Select Track by Playlist", {"shell": "music select"}],
        "t": ["Select Track by Tags", {"shell": "music select --filter-by-tags"}],
        "n": ["Next Track", "cmus-remote --next"],
        "p": ["Prev Track", "cmus-remote --prev"],
        "l": ["Seek 10 Forwards", "cmus-remote --seek +10"],
        "h": ["Seek 10 Backwards", "cmus-remote --seek -10"],
        ".": ["Seek 30 Forwards", "cmus-remote --seek +30"],
        ",": ["Seek 30 Backwards", "cmus-remote --seek -30"],
        "j": ["Volume Down", "cmus-remote --volume -5"],
        "k": ["Volume Up", "cmus-remote --volume +5"]
    },
    "x": {
        "_desc": "+utils",
        "d": ["Disk cleanup (report + Claude)", "open-iterm-with 'disk-cleanup; exec fish'"],
        "r": ["Disk report only", "open-iterm-with 'disk-cleanup --no-ai; exec fish'"],
        "s": ["Fresh scan, then cleanup", "open-iterm-with 'disk-cleanup --scan; exec fish'"],
        "p": ["Save to Pinterest", {"interactive": "cd ~/private/pancia && _bin/pinterest_save"}],
        "c": ["calendar", {"interactive": "agenda 24"}],
        "l": ["LOCK IT DOWN", "launch-lock-screen-dialog"]
    },
    "t": {
        "_desc": "+macOS settings",
        "a": ["Aerial (screen saver)", "open ~/Library/Screen\\ Savers/Aerial.saver"]
    },
    "z": {
        "_desc": "+spirituality",
        "n": ["Natal chart (Anthony)", "open \"$HOME/Cloud/_spirituality/astrology charts/ANTHONY_horoscope_natal_20-10-1993_16-14_astroseek_v4.png\""],
        "c": ["Charts folder", "finder-here \"$HOME/Cloud/_spirituality/astrology charts\""],
        "s": ["Spirituality folder", "finder-here \"$HOME/Cloud/_spirituality\""],
        "t": ["Transits now", {"interactive": "astro now"}]
    },
    "=": ["edit Hermes config", {"shell": "nvim ~/dotfiles/rcs/hermes-commands.json"}],
    "-": [{"shell:fish": "~/private/bin/superwhisper_status"}, "~/private/bin/superwhisper_reset"]
}
